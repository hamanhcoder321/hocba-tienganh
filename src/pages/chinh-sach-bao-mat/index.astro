---
import JsonLd from '@/components/common/JsonLd.astro';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CONTACTS } from '@/lib/constants';
import { baseUrl } from '@/lib/constants/api';
import type { Graph } from 'schema-dts';

// export const prerender = true;

const data = [
  {
    intro: true,
    content: [
      'Học Bá Education cam kết tôn trọng và bảo vệ quyền riêng tư của người dùng. Chính sách Bảo mật này được xây dựng nhằm giải thích rõ ràng cách chúng tôi thu thập, sử dụng, lưu trữ và bảo vệ dữ liệu cá nhân của người truy cập và học viên trong quá trình sử dụng các sản phẩm và dịch vụ thuộc Học Bá Education.',
      'Chúng tôi khuyến nghị bạn đọc kỹ toàn bộ nội dung trước khi tiếp tục sử dụng website hoặc bất kỳ dịch vụ nào liên quan.',
    ],
  },
  {
    title: 'Phạm vi áp dụng của Chính sách bảo mật',
    content: ['Chính sách Bảo mật này áp dụng đối với:'],
