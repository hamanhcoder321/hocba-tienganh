---
// export const prerender = true; // Pre-render trang cố vấn chuyên môn

import AnimatedArrow from '@/components/common/AnimatedArrow';
import ArrowAnimation from '@/components/common/ArrowAnimation.astro';
import {
  ArrowIcon,
  EllipContact,
  EllipContact2,
  FacebookIcon,
  InstagramIcon,
  SpringContact,
  TiktokIcon,
  VectorArrow,
  YtbIcon,
} from '@/components/common/icons';
import JsonLd from '@/components/common/JsonLd.astro';
import SimpleFormRegister from '@/components/common/SimpleFormRegister.astro';
import QAAccordion from '@/components/features/home/advisor-qa/QAAccordion.astro';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CONTACTS, DATA_VALUE } from '@/lib/constants';
import { IMAGES } from '@/lib/constants/images';
import { getImage, Image } from 'astro:assets';
import { CalendarClock, Globe, Mail, MapPinned, Phone } from 'lucide-react';
import type { Graph } from 'schema-dts';

// --- Metadata cho SEO ---
const title = 'Liên hệ | Học Bá Education';
const description =
  'Câu chuyện hình thành, sứ mệnh và đội ngũ đằng sau Học Bá Education. Chúng tôi cung cấp giải pháp Tiếng Trung uy tín và chất lượng.';

const baseUrl = import.meta.env.PUBLIC_CLIENT_URL ?? 'https://hoc-ba.edu.vn';

const jsonLd: Graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Trang chủ',
          item: baseUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Liên hệ',
          item: `${baseUrl}/lien-he`,
        },
      ],
    },
  ],
};

const qaData = [
  {
    id: 'item-1',
    question: 'Sau khi gửi form, bao lâu Học Bá liên hệ lại?',
    answer:
      'Sau khi nhận được form đăng ký, đội ngũ tư vấn của Học Bá sẽ liên hệ với bạn trong vòng 24 giờ làm việc qua kênh bạn đã lựa chọn (Gọi điện/Zalo/Email). Trường hợp gửi form ngoài giờ hành chính, Học Bá sẽ phản hồi vào khung giờ làm việc gần nhất.',
  },
  {
    id: 'item-2',
    question: 'Em chưa biết mình phù hợp khoá nào, có cần chọn sẵn không?',
    answer:
      'Không bắt buộc. Bạn có thể chọn “Chưa rõ – Cần Học Bá tư vấn giúp”, đội ngũ tư vấn sẽ trao đổi thêm và gợi ý lộ trình phù hợp nhất với mục tiêu và trình độ hiện tại của bạn.',
  },
  {
    id: 'item-3',
    question: 'Em đi làm giờ hành chính, có thể tư vấn buổi tối được không?',
    answer:
      'Hoàn toàn được. Bạn chỉ cần chọn khung giờ “Buổi tối” trong form đăng ký, Học Bá sẽ sắp xếp tư vấn viên phù hợp để hỗ trợ bạn.',
  },
  {
    id: 'item-4',
    question: 'Học Bá có dạy thử/giờ trải nghiệm không?',
    answer:
      'Tùy theo từng giai đoạn và từng khóa học. Bạn có thể để lại thông tin, đội ngũ tư vấn của Học Bá sẽ cập nhật chính xác các chương trình học thử & ưu đãi đang áp dụng tại thời điểm đăng ký.',
  },
];
---

<BaseLayout {title} {description}>
  <JsonLd data={jsonLd} />
  <div class="relative">
    <section class="w-full overflow-hidden">
      <div class="relative h-full min-h-[344px] md:min-h-[718px]">
        <Image
          src={IMAGES.contact.bgContact}
          width={1920}
          height={718}
          alt="Hình nền liên hệ Học Bá"
          widths={[640, 768, 1024, 1280, 1920]}
          sizes="100vw"
          format="webp"
          quality={85}
          loading="eager"
          decoding="async"
          class="absolute inset-0 z-0 h-[344px] w-full object-cover md:h-full"
        />

        <div class="container relative z-10 flex h-[344px] flex-col md:h-[718px]">
          <Breadcrumb className="px-4 pt-12 md:px-0">
            <BreadcrumbList className="text-xs text-white md:text-lg">
              <BreadcrumbItem>
                <BreadcrumbLink asChild>
                  <a href="/">Trang chủ</a>
                </BreadcrumbLink>
              </BreadcrumbItem>
              <BreadcrumbSeparator />
              <BreadcrumbItem>
                <BreadcrumbPage>Liên hệ</BreadcrumbPage>
              </BreadcrumbItem>
            </BreadcrumbList>
          </Breadcrumb>

          <div
            class="relative mx-auto flex h-10 w-fit items-center bg-gradient-to-t from-[#FFF8F8] to-[#FFDF89] bg-clip-text px-4 text-2xl font-black uppercase text-transparent md:mt-2 md:h-[66px] md:px-10 md:text-[52px]"
          >
            <AnimatedArrow
              toColor="#FFF8F8"
              fromColor="#FFDF89"
              className="absolute -left-1 top-2 size-4 object-cover md:-top-4 md:left-2 md:size-8"
              client:load
            />
            <h1>Liên hệ với học bá</h1>
            <VectorArrow
              toColor="#FFF8F8"
              fromColor="#FFDF89"
              className="absolute -right-1 bottom-2 size-4 rotate-180 object-cover md:-bottom-4 md:right-2 md:size-8"
            />
          </div>

          <div class="mx-auto mb-10 mt-auto">
            <Image
              src={IMAGES.contact.bgGvContact}
              width={853}
              height={428}
              alt={'hopTac'}
              densities={[1, 2]}
              class={'object-cover w-auto h-[170px] md:h-[428px]'}
            />
          </div>
        </div>
      </div>

      <div class="relative z-10 mx-auto w-full max-w-[1354px]">
        <div class="relative -mt-20 rounded-t-[18px] bg-white shadow-[-3px_20px_68.2px_0px_#B90E0A1A]">
          <div
            class="grid h-auto grid-cols-1 px-11 py-8 shadow-[-3px_20px_68.2px_0px_#B90E0A1A] md:h-[486px] md:grid-cols-2 md:px-24 md:py-12"
          >
            <div class="col-span-1 space-y-5">
              <div class="flex h-8 items-center gap-2 md:h-16">
                <div
                  class="flex size-[30px] items-center justify-center rounded-full bg-primary text-white md:size-[50px]"
                >
                  <Phone className="size-4 md:size-6" />
                </div>
                <div class="flex flex-col">
                  <p class="text-[15px] font-black uppercase text-black md:text-2xl">HOTLINE HỖ TRỢ</p>
                  <a
                    href={`tel:${CONTACTS.hotline}`}
                    class="text-[15px] font-black uppercase text-primary hover:underline md:text-[31px]"
                  >
                    {CONTACTS.hotline}
                  </a>
                </div>
              </div>
              <div class="flex h-8 items-center gap-2 md:h-16">
                <div
                  class="flex size-[30px] items-center justify-center rounded-full bg-primary text-white md:size-[50px]"
                >
                  <Mail className="size-4 md:size-6" />
                </div>
                <div class="flex flex-col">
                  <a href={`mailto:${CONTACTS.email}`} class="text-[15px] font-medium hover:underline md:text-2xl">
                    {CONTACTS.email}
                  </a>
                </div>
              </div>
              <div class="flex h-8 items-center gap-2 md:h-16">
                <div
                  class="flex size-[30px] flex-shrink-0 items-center justify-center rounded-full bg-primary text-white md:size-[50px]"
                >
                  <MapPinned className="size-4 md:size-6" />
                </div>
                <div class="flex flex-col">
                  <a
                    href={CONTACTS.address.value}
                    target="_blank"
                    class="text-[15px] font-medium hover:underline md:text-2xl"
                  >
                    {CONTACTS.address.label}
                  </a>
                </div>
              </div>
              <div class="flex h-8 items-center gap-2 md:h-16">
                <div
                  class="flex size-[30px] flex-shrink-0 items-center justify-center rounded-full bg-primary text-white md:size-[50px]"
                >
                  <Globe className="size-4 md:size-6" />
                </div>
                <div class="flex flex-col">
                  <a
                    href={baseUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[15px] font-medium hover:underline md:text-2xl"
                  >
                    {CONTACTS.linkWeb}
                  </a>
                </div>
              </div>
              <button
                class="h-8 rounded-[19px] bg-primary from-[#B90E0A] to-[#F3C650] px-10 text-[15px] font-black uppercase text-white transition-all duration-1000 hover:bg-gradient-to-l hover:shadow-[0px_4.66px_37.87px_0px_#FFCE46] md:h-14 md:text-2xl"
                onclick="document.getElementById('lien-he-hop-tac').scrollIntoView({ behavior: 'smooth' })"
              >
                Đối tác / Yêu cầu hợp tác
              </button>
            </div>
            <div class="col-span-1 mt-[30px] space-y-5 md:mt-0">
              <div class="flex h-8 items-center gap-2 md:h-16">
                <div
                  class="flex size-[30px] flex-shrink-0 items-center justify-center rounded-full bg-primary text-white md:size-[50px]"
                >
                  <CalendarClock className="size-4 md:size-6" />
                </div>
                <div class="flex flex-col">
                  <p class="text-[15px] font-black text-black md:text-2xl">Thời gian làm việc: 8:00 - 18:30</p>
                  <p class="text-[15px] font-medium md:text-2xl">(Từ Thứ Hai đến Thứ Bảy)</p>
                </div>
              </div>
              <div class="flex h-8 items-center gap-2 md:h-16">
                <div
                  class="flex size-[30px] items-center justify-center rounded-full bg-[#1877F2] text-[#1877F2] md:size-[50px]"
                >
                  <FacebookIcon />
                </div>
                <div class="flex flex-col">
                  <a
                    href={CONTACTS.facebookEducationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Fanpage Học Bá Education"
                    title="Fanpage Học Bá Education"
                    class="text-[15px] font-black hover:underline md:text-2xl"
                  >
                    Fanpage Học Bá Education
                  </a>
                </div>
              </div>
              <div class="flex h-8 items-center gap-2 md:h-16">
                <div
                  class="flex size-[30px] items-center justify-center rounded-full bg-[#1877F2] text-[#1877F2] md:size-[50px]"
                >
                  <FacebookIcon />
                </div>
                <div class="flex flex-col">
                  <a
                    href={CONTACTS.facebookHskUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Facebook của Học Bá"
                    title="Facebook của Học Bá"
                    class="text-[15px] font-black hover:underline md:text-2xl"
                  >
                    Fanpage Học Bá HSK
                  </a>
                </div>
              </div>
              <div class="flex h-8 items-center gap-2 md:h-16">
                <div
                  class="flex size-[30px] items-center justify-center rounded-full bg-[#1877F2] text-[#1877F2] md:size-[50px]"
                >
                  <FacebookIcon />
                </div>
                <div class="flex flex-col">
                  <a
                    href={CONTACTS.facebookChineseUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Facebook của Học Bá"
                    title="Facebook của Học Bá"
                    class="text-[15px] font-black hover:underline md:text-2xl"
                  >
                    Fanpage Học Bá Chinese
                  </a>
                </div>
              </div>
              <div class="flex h-14 gap-10 md:gap-16">
                <a
                  href={CONTACTS.tiktokUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Facebook của Học Bá"
                  title="Tiktok của Học Bá"
                  class="text-[15px] font-black hover:underline md:text-2xl"
                >
                  <div
                    class="flex size-[30px] items-center justify-center rounded-full bg-black text-black md:size-[50px]"
                  >
                    <TiktokIcon />
                  </div>
                </a>
                <a
                  href={CONTACTS.igUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Ig của Học Bá"
                  title="Ig của Học Bá"
                  class="text-[15px] font-black hover:underline md:text-2xl"
                >
                  <div
                    class="flex size-[30px] items-center justify-center rounded-full bg-[#FF3DA1] text-[#FF3DA1] md:size-[50px]"
                  >
                    <InstagramIcon />
                  </div>
                </a>
                <a
                  href={CONTACTS.ytbkUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Ytb của Học Bá"
                  title="Ytb của Học Bá"
                  class="text-[15px] font-black hover:underline md:text-2xl"
                >
                  <div
                    class="flex size-[30px] items-center justify-center rounded-full bg-[#EC3323] text-[#EC3323] md:size-[50px]"
                  >
                    <YtbIcon />
                  </div>
                </a>
              </div>
            </div>
          </div>

          <div
            id="lien-he-hop-tac"
            class="relative flex h-full scroll-mt-[80px] overflow-hidden bg-[#F6F6F6] pb-[30px] pl-0 pt-8 md:h-[536px] md:pb-0 md:pl-[52px]"
          >
            <div
              class="absolute left-0 top-[152px] z-50 w-[159px] flex-shrink-0 md:relative md:top-0 md:z-10 md:w-[498px]"
            >
              <Image
                src={IMAGES.contact.hopTac}
                width={498}
                height={520}
                alt={'hopTac'}
                densities={[1, 2]}
                class={'object-cover w-full h-auto scale-90 object-top'}
              />
            </div>
            <div class="pt-0 md:pt-5">
              <div class="flex items-center justify-start gap-4 md:justify-center">
                <ArrowAnimation />
                <h2 class="ml-10 mr-0 text-2xl font-black uppercase text-primary md:ml-0 md:mr-28 md:text-[42px]">
                  Liên hệ hợp tác
                </h2>
              </div>
              <p class="px-4 text-center text-[15px] font-bold md:px-20 md:text-[28px]">
                Nếu bạn là đối tác, doanh nghiệp, trường học muốn hợp tác về đào tạo - workshop - sự kiện
              </p>
              <div
                class="relative mx-4 mt-16 w-auto rounded-xl bg-white py-4 pl-36 md:mx-auto md:w-[630px] md:pl-[42px] md:pr-[42px]"
              >
                <button
                  class="absolute -top-5 left-40 h-7 rounded-xl bg-primary px-4 text-[15px] font-black text-white md:left-10 md:h-10 md:px-10 md:text-2xl"
                >
                  Vui lòng gửi email đến
                </button>
                <div class="mt-0 flex h-10 items-center gap-2 md:mt-4 md:h-16">
                  <div
                    class="flex size-[30px] items-center justify-center rounded-full bg-primary text-white md:size-[50px]"
                  >
                    <Mail className="size-4 md:size-6" />
                  </div>
                  <div class="flex flex-col">
                    <p class="text-[15px] font-medium text-[#373737] md:text-2xl md:font-bold">{CONTACTS.email}</p>
                  </div>
                </div>
                <p class="text-xs font-bold italic text-[#373737] md:text-lg">
                  Tiêu đề email ghi rõ : <br /> “Hợp tác - [Tên đơn vị] x <br class="block md:hidden" /> Học Bá Education”
                </p>
                <Image
                  src={IMAGES.contact.emailContact}
                  width={206}
                  height={206}
                  alt={'email'}
                  densities={[1, 2]}
                  class={'object-cover w-auto h-[71px] md:h-full absolute right-0 md:-right-[80px] top-full md:top-1/2 -translate-y-1/2'}
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SimpleFormRegister dataInput={DATA_VALUE.CONTACT} />

    <section
      class="h-auto w-full overflow-hidden bg-gradient-to-t from-[#FFF8F800] to-[#FFD3D3] px-4 md:h-[690px] md:px-0"
    >
      <div class="mx-auto grid w-full max-w-[1354px] grid-cols-1 md:grid-cols-2">
        <div class="col-span-1">
          <div class="flex h-24 items-center justify-center md:h-[129px] md:justify-start">
            <div class="text-[58px] font-black text-primary md:text-[108px]">?</div>
            <h2 class="text-[20px] font-black uppercase text-primary md:text-[42px]">Câu hỏi thường gặp</h2>
          </div>
          <QAAccordion {qaData} />
        </div>
        <div class="relative col-span-1 h-[378px] md:h-auto">
          <div class="absolute right-0 top-8 md:top-[9.5rem]">
            <Image
              src={IMAGES.contact.qaBook}
              width={214}
              height={181}
              alt={'qaBook'}
              densities={[1, 2]}
              class={'object-cover h-auto w-[109px] md:w-[214px] z-10 absolute top-[17%] md:-top-[6%] left-[42%] md:left-[45%] -translate-x-[54%]'}
            />
            <Image
              src={IMAGES.introduce.machine}
              width={94}
              height={58}
              alt={'qaBook'}
              densities={[1, 2]}
              class={'object-cover h-auto w-12 md:w-[94px] z-10 absolute top-[46%] md:top-[34%] left-0 '}
            />
            <SpringContact className="absolute right-0 top-0 size-20 md:size-auto" />
            <SpringContact className="absolute -right-4 top-[40%] size-16 md:-right-10 md:size-20" />
            <Image
              src={IMAGES.contact.fdBook}
              width={614}
              height={680}
              alt={'fdBook'}
              densities={[1, 2]}
              class={'object-cover h-[349px] md:h-auto w-auto md:w-[614px] z-50 relative'}
            />
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
