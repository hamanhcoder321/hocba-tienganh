const formatSmartTechnologyClass = await Promise.all(
  smartTechnologyClass.map(async (item) => {
    // Get the original ImageMetadata for getImage - must be ImageMetadata, not string
    const originalMainImage = item.mainImage;
    const mainImageSrc = typeof originalMainImage === 'string' ? originalMainImage : originalMainImage.src;

    let optimizedMainImage;

    // Only optimize if mainImage is ImageMetadata (not already a string)
    if (typeof originalMainImage !== 'string' && originalMainImage) {
      optimizedMainImage = await getImage({
        src: originalMainImage,
        format: 'webp',
        densities: [1, 2],
        quality: 85,
      });
    }

    const originalSubImages = item.subImages || [];
    const optimizedSubImages = await Promise.all(
      originalSubImages.map(async (subImageItem) => {
        const subImage = subImageItem.image;
        const subImageSrc = typeof subImage === 'string' ? subImage : subImage.src;

        let optimizedSubImage;

        // Only optimize if subImage is ImageMetadata (not already a string)
        if (typeof subImage !== 'string' && subImage) {
          optimizedSubImage = await getImage({
            src: subImage,
            format: 'webp',
            densities: [1, 2],
            quality: 85,
          });
        }

        return {
          image: optimizedSubImage?.src ?? subImageSrc,
          position: subImageItem.position,
          isMobile: subImageItem.isMobile,
        };
      }),
    );

    return {
      ...item,
      mainImage: optimizedMainImage?.src ?? mainImageSrc,
      subImages: optimizedSubImages,
    };
  }),
);

