<script>
  (function () {
    const dots = document.querySelectorAll('#dot-indicators .dot-item');
    const total = dots.length;
    let current = 0;

    function showDot(index: number, isShrink: boolean) {
      const el = dots[index] as HTMLElement;
      el.style.opacity = '1';
      el.classList.remove('dot-bounce', 'dot-shrink');
      void el.offsetWidth;
      el.classList.add(isShrink ? 'dot-shrink' : 'dot-bounce');
    }

    showDot(current, false);

    setInterval(() => {
      const prev = current;
      (dots[prev] as HTMLElement).style.opacity = '0';
      current = (current + 1) % total;
      // Khi quay về dot đầu (từ dot cuối) thì dùng shrink
      const isShrink = prev === total - 1 && current === 0;
      showDot(current, isShrink);
    }, 1000);
  })();
</script>

