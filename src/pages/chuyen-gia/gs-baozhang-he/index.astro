---
// export const prerender = true;

import ArrowAnimation from '@/components/common/ArrowAnimation.astro';
import AboutRegisterSection from '@/components/features/about/AboutRegisterSection.astro';
import ButtonTitle from '@/components/common/ButtonTitle.astro';
import {
  CommaIcon,
  EllipseVtcg1,
  EllipseVtcg2,
  FourPointedStar,
  FourPointedStarMini,
  GraduationCap1,
  GraduationCap,
  StarColorGradient,
  StarColorWhite,
  TextHBC1,
  TextHBC2,
  VectorChatLarge2,
} from '@/components/common/icons';
import JsonLd from '@/components/common/JsonLd.astro';
import SimpleFormRegister from '@/components/common/SimpleFormRegister.astro';
import NewsEventsCarousel from '@/components/features/introduce/NewsEventsCarousel';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DATA_VALUE } from '@/lib/constants/enums';
import { IMAGES } from '@/lib/constants/images';
import { cn } from '@/lib/utils';
import { Image } from 'astro:assets';
import type { Graph } from 'schema-dts';

const title = 'Cố Vấn Chuyên Môn | Học Bá Education';
const description =
  'Giáo sư Baozhang He - Cố vấn chuyên môn quốc tế, nguyên Giám đốc Chương trình tiếng Trung tại Đại học Harvard. Chuyên gia hàng đầu về ngữ pháp nhận thức và giảng dạy Hán ngữ.';

const baseUrl = import.meta.env.PUBLIC_CLIENT_URL ?? 'https://hoc-ba.edu.vn';

const jsonLd: Graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Trang chủ',
          item: baseUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Cố vấn chuyên môn',
          item: `${baseUrl}/chuyen-gia/gs-baozhang-he`,
        },
      ],
    },
    {
      '@type': 'ProfilePage',
      name: 'GS. Baozhang He - Cố vấn chuyên môn | Học Bá Education',
      url: `${baseUrl}/chuyen-gia/gs-baozhang-he`,
      dateModified: new Date().toISOString(),
      mainEntity: {
        '@type': 'Person',
        '@id': `${baseUrl}/chuyen-gia/gs-baozhang-he#person`,
        name: 'GS. Baozhang He',
        jobTitle: 'Cố vấn chuyên môn',
        worksFor: {
          '@id': `${baseUrl}/#organization`,
        },
        url: `${baseUrl}/chuyen-gia/gs-baozhang-he`,
        image: IMAGES.introduce.gs_hbc.src,
        description:
          'Cố vấn chuyên môn tại Học Bá Education, đồng hành xây dựng định hướng chuyên môn và chất lượng chương trình.',
      },
    },
  ],
};

const expertInformation = [
  {
    title: 'KINH NGHIỆM VÀ VỊ TRÍ TỪNG ĐẢM NHIỆM',
    fromColor: '#F2F5FF',
    toColor: '#FFFDF9',
    options: [
      'Quản lý Chương trình Đào tạo Tiếng Anh – Đại học Western Sydney. Hơn 4 năm quản lý và phát triển các chương trình đào tạo tiếng Anh tại Đại học Western Sydney, Úc.',
      'Quản lý Cơ sở Đào tạo – Đại học Wollongong. Phụ trách quản lý và vận hành cơ sở đào tạo Sydney CBD thuộc Đại học Wollongong, Úc.',
      'Cựu Giám khảo IELTS Speaking & Writing. Trực tiếp đánh giá năng lực thí sinh ở hai kỹ năng Speaking và Writing theo hệ thống tiêu chí của IELTS.',
      'Giám đốc Học thuật tại Việt Nam & Malaysia. Từng phụ trách chương trình đào tạo, quản lý đội ngũ giáo viên, phát triển chuyên môn và đảm bảo chất lượng giảng dạy tại các tổ chức Anh ngữ quốc tế.',
    ],
    type: 1,
    albums: [
      IMAGES.introduce.hv_vttng_1,
      IMAGES.introduce.hv_vttng_2,
      IMAGES.introduce.hv_vttng_3,
      IMAGES.introduce.hv_vttng_4,
    ],
  },
  {
    title: 'DẤU ẤN CHUYÊN MÔN NỔI BẬT',
    fromColor: '#F2F5FF',
    toColor: '#FFFDF9',
    options: [
      'Chuyên môn sâu về IELTS: Kinh nghiệm từ giảng dạy đến trực tiếp khảo thí IELTS Speaking & Writing, với hiểu biết sâu về tiêu chí đánh giá và năng lực cần thiết ở từng band điểm',
      'Quản lý học thuật quốc tế: Nhiều năm đảm nhiệm các vị trí quản lý chương trình, đội ngũ giáo viên và chất lượng đào tạo tại các tổ chức giáo dục ở Úc và Châu Á.',
      'Nghiên cứu phương pháp giảng dạy: Tham gia nghiên cứu về ứng dụng công nghệ và phương pháp phản hồi trong giảng dạy tiếng Anh, được công bố trên Cambridge English Research Notes #64 (2016).',
      'Đào tạo giáo viên tiếng Anh: Từng tham gia đào tạo chứng chỉ TEFL, hướng dẫn phương pháp giảng dạy và phát triển kỹ năng chuyên môn cho giáo viên.',
      'Kinh nghiệm giáo dục đa quốc gia: Kinh nghiệm giảng dạy và quản lý giáo dục tại Úc, Việt Nam, Malaysia và Trung Quốc, làm việc với người học thuộc nhiều trình độ và nền tảng khác nhau.',
    ],
    type: 2,
    albums: [IMAGES.introduce.cthtnb_1, IMAGES.introduce.cthtnb_2, IMAGES.introduce.cthtnb_3],
  },
  // {
  //   title: 'HỘI THẢO HỌC THUẬT TỪNG THAM GIA',
  //   fromColor: '#FFF3F3',
  //   toColor: '#FFFDF9',
  //   options: [
  //     '📌  Giáo sư Baozhang He là diễn giả chính tại nhiều hội thảo quốc tế như ACTFL, CLTA, NECLTA, chia sẻ về mô hình ngữ pháp nhận thức trong giảng dạy Hán ngữ',
  //   ],
  //   type: 3,
  //   albums: [
  //     IMAGES.introduce.hoi_thao_1,
  //     IMAGES.introduce.hoi_thao_2,
  //     IMAGES.introduce.hoi_thao_3,
  //     IMAGES.introduce.hoi_thao_4,
  //   ],
  // },
];

const expertRoles = [
  'Định hướng chiến lược học thuật: Tham gia xây dựng định hướng chuyên môn và tiêu chuẩn đào tạo, đảm bảo chương trình IELTS có mục tiêu rõ ràng và lộ trình phát triển năng lực phù hợp.',
  'Chuẩn hóa chương trình IELTS: Cố vấn nội dung và phương pháp đào tạo dựa trên tiêu chí đánh giá IELTS, hướng học viên phát triển đúng năng lực cần thiết ở từng band điểm.',
  'Cố vấn phương pháp giảng dạy: Định hướng phương pháp giúp giáo viên nhận diện điểm yếu, phân tích lỗi sai và đưa ra phản hồi hiệu quả cho từng học viên.',
  'Phát triển chất lượng đội ngũ: Góp phần định hướng chuyên môn cho giáo viên, nâng cao năng lực giảng dạy, đánh giá và theo sát sự tiến bộ của học viên.',
  'Kiểm soát chất lượng học thuật: Tham gia xây dựng các tiêu chuẩn nhằm đảm bảo tính nhất quán và chất lượng trong quá trình triển khai chương trình đào tạo.',
  'Kết nối tiêu chuẩn quốc tế: Vận dụng kinh nghiệm từ khảo thí IELTS, giảng dạy và quản lý giáo dục quốc tế để đưa các chuẩn mực đào tạo phù hợp vào THE IELTS SPACE.',
];
---

<BaseLayout {title} {description}>
  <JsonLd data={jsonLd} />
  <div class="relative">
    <section class="relative mx-auto h-auto w-full overflow-hidden xl:max-w-[1440px] xl:px-[36px]">
      <Breadcrumb className="container mt-12 px-4 md:px-0 xl:mx-0 xl:max-w-none xl:px-0">
        <BreadcrumbList className="text-foreground text-xs md:text-lg">
          <BreadcrumbItem>
            <BreadcrumbLink asChild>
              <a href="/" class="hover:text-primary hover:underline">Trang chủ</a>
            </BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>Cố vấn chuyên môn</BreadcrumbPage>
          </BreadcrumbItem>
          <!-- <BreadcrumbSeparator /> -->
          <!-- <BreadcrumbItem>
            <BreadcrumbPage> GS. Baozhang He </BreadcrumbPage>
          </BreadcrumbItem> -->
        </BreadcrumbList>
      </Breadcrumb>
      <div class="relative z-10 flex h-auto w-full flex-col md:h-[642px] md:px-0 xl:flex-row xl:justify-between xl:gap-[16px] 2xl:gap-[32px]">
        <div class="container z-50 flex h-full bg-transparent px-4 xl:mx-0 xl:w-fit xl:min-w-fit xl:px-0">
          <div class="py-5 md:py-14">
            <h1 class="flex flex-col gap-0 text-4xl font-bold leading-normal md:gap-4">
              <span class="block text-xl font-black uppercase text-[#072899] md:text-[32px] lg:text-[42px]"
                >Cố vấn chuyên môn quốc tế</span
              >
              <span
                class="mt-2 flex h-8 w-fit items-center rounded-md bg-[#F97316] px-4 text-lg font-black uppercase text-white md:mt-1 md:h-12 md:rounded-xl md:px-6 md:text-2xl lg:h-16 lg:px-8 lg:text-3xl"
                >CỦA THE IELTS SPACE</span
              >
              <span class="mt-1 block text-lg font-black uppercase md:text-[24px] lg:text-[32px]">THẠC SĨ</span>
              <span class="block text-lg font-black uppercase md:text-[32px] lg:text-[42px]">JACKSON HOWARD</span>
            </h1>
            <div
              class="relative mt-4 w-[316px] rounded-[12px] bg-gradient-to-r from-[#FFF8F8] to-[#C0CFFB] pb-4 pl-8 pr-2 pt-7 md:mt-10 md:w-[35vw] md:max-w-[380px] md:pb-7 md:pl-10 md:pt-[40px] lg:mt-16 lg:w-[30vw] lg:max-w-[450px] lg:pb-9 lg:pl-14 lg:pt-[54px] xl:h-[198px] xl:w-[554px] xl:max-w-none"
            >
              <div
                class="absolute -top-4 left-7 flex h-[30px] w-8 items-center justify-center rounded-[54px] md:-top-5 md:left-8 md:size-10 lg:-top-7 lg:left-10 lg:size-14"
                style="background-color: #083AD4;"
              >
                <CommaIcon className="md:scale-110 lg:scale-150" />
              </div>
              <p class="text-sm italic font-light leading-[1.3] tracking-normal md:text-[20px] lg:text-[26px]">
                Học IELTS là cả một quá trình xây dựng năng lực ứng dụng ngôn ngữ bền vững và phát triển tư duy để tiến xa hơn
              </p>
            </div>
          </div>
        </div>
        <div
          class="relative bottom-0 left-0 z-0 flex w-full flex-col items-end justify-end pl-4 max-sm:h-[307px] md:absolute md:top-0 md:flex-row md:pl-0 xl:relative xl:w-auto"
        >
          <div
            class="relative h-[307px] w-full max-sm:translate-x-0 md:-mr-[100px] md:h-[642px] md:w-[848px] md:origin-right md:scale-[0.8] lg:scale-[0.9] xl:-ml-[160px] xl:mr-0 xl:scale-[0.8] 2xl:ml-0 2xl:scale-100 3xl:mr-0"
          >
            <div
              class="absolute -left-[6.55px] top-[26px] z-50 h-[281px] w-[281px] md:-left-[11px] md:bottom-auto md:top-[47px] md:h-[595px] md:w-[595px]"
            >
              <Image
                src={IMAGES.introduce.gs_hbc}
                alt={'gs_hbc'}
                widths={[281, 595, 1200]}
                sizes={`(max-width: 768px) 281px, 595px`}
                quality={100}
                format={'webp'}
                class={'h-[281px] w-[281px] object-contain md:h-[595px] md:w-[595px]'}
                loading={'eager'}
                fetchpriority={'high'}
                decoding={'sync'}
              />
              <div class="absolute -top-[20px] left-[160px] md:-top-[20px] md:left-[380px]">
                <div class="relative flex items-center justify-center">
                  <VectorChatLarge2 className="h-auto w-[111px] md:w-[238px]" />
                  <p
                    class="absolute left-[54%] top-[42%] -translate-x-1/2 -translate-y-1/2 text-nowrap text-[6px] font-bold uppercase leading-[1.08] tracking-[0.16em] text-white md:text-[18.38px]"
                  >
                    HỌC GIẢ QUỐC TẾ
                  </p>
                </div>
              </div>
              <!-- <div class="absolute -right-6 top-[30%] -translate-y-2/3 scale-50 md:-right-0 md:top-1/3 md:scale-100">
                <TextHBC2 />
              </div>
              <div
                class="absolute -right-32 top-[#B2100900] top-[40%] -translate-y-1/2 scale-50 rounded-md bg-gradient-to-b from-[#FFE4E4] p-1 md:-right-36 md:top-1/2 md:scale-100"
              >
                <div class="rounded-md bg-gradient-to-b from-[#B90E0A] to-[#A51107] p-4">
                  <TextHBC1 />
                </div>
              </div> -->
            </div>
            <div
              class="absolute bottom-0 right-0 z-0 h-[240px] w-full rounded-tl-[50px] bg-[#C0CFFB] md:h-[463px] md:w-[848px] md:rounded-tl-[100px]"
            >
            </div>
            <div
              class="absolute bottom-0 right-0 z-10 ml-auto h-[270px] w-full rounded-tl-[50px] bg-gradient-to-tl from-[#04195C] via-[#052284] to-[#3464F8] opacity-[28%] max-sm:w-[calc(100%-12px)] md:h-[522px] md:w-[827px] md:rounded-tl-[100px]"
            >
            </div>
            <div
              class="absolute bottom-0 right-0 z-20 ml-auto h-[263px] w-[339px] rounded-tl-[47px] bg-gradient-to-tl from-[#04195C] via-[#052284] to-[#3464F8] opacity-100 md:h-[522px] md:w-[800px] md:rounded-tl-[100px]"
            >
              {/* Inner wrapper for overflow hidden elements */}
              <div class="absolute inset-0 overflow-hidden rounded-tl-[47px] md:rounded-tl-[100px]">
                {/* Faded top right star */}
                <div class="absolute right-2 top-[30%] z-0 max-sm:-right-6 md:right-2 md:top-[25%]">
                  <FourPointedStar
                    fromColor="#001F7D"
                    toColor="#FFFFFF"
                    className="size-28 opacity-20 md:size-[200px]"
                  />
                </div>
              </div>

              <!-- <div class="absolute -top-12 left-4 z-50 flex md:-top-20 md:left-10">
                <FourPointedStar className="size-7 md:size-auto" />
                <FourPointedStarMini className="mt-auto size-3 md:size-auto" />
              </div> -->

              {/* White stars on the right */}
              <div class="absolute bottom-[15%] right-[15%] z-50 md:bottom-[20%] md:right-[22%]">
                <FourPointedStar fromColor="#FFFFFF" toColor="#001F7D" className="size-14 opacity-90 md:size-[100px]" />
                <FourPointedStarMini
                  fromColor="#FFFFFF"
                  toColor="#001F7D"
                  className="absolute -bottom-2 -right-4 size-5 opacity-90 md:-bottom-3 md:-right-8 md:size-8"
                />
              </div>

              {/* Text on the right */}
              <div
                class="absolute right-[5%] top-[5%] z-30 flex items-stretch gap-2 md:right-[15%] md:top-[8%] md:gap-4"
              >
                <div class="flex flex-col justify-center font-black uppercase leading-none text-white">
                  <span class="text-left text-[20px] tracking-wide md:text-[32px] lg:text-[42px]">Jackson</span>
                  <span class="text-left text-[28px] tracking-tight md:text-[46px] lg:text-[62px]">Howard</span>
                </div>
                <div class="w-[3px] bg-white md:w-[5px]"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container relative h-auto w-full overflow-hidden pt-4 md:pt-0">
      <ButtonTitle title="Triết lý & Tầm nhìn" icon={GraduationCap1} className="ml-4 md:ml-0" iconClassName="size-[36px]" />
      <div class="mt-6 flex flex-col-reverse gap-7 px-4 md:mt-16 md:flex-row md:gap-6 md:gap-[52px]">
        <div class="w-full md:w-3/5">
          <Image
            src={IMAGES.introduce.tl_tn}
            alt={'tl_tn'}
            width={637}
            height={340}
            loading={'lazy'}
            class={'object-cover object-[50%_10%] md:w-full w-auto md:h-[262px]'}
          />
          <p class="mt-4 px-2 text-justify text-base font-medium md:mt-12 md:w-4/5 md:px-0 md:text-lg lg:w-[70%]">
            Với 20 năm kinh nghiệm giảng dạy và đào tạo tiếng Anh, thầy Jackson Howard hướng người học đến việc hiểu bản chất ngôn ngữ, học có hệ thống và biết cách vận dụng - không chỉ để đạt mục tiêu IELTS mà còn tạo nền tảng cho học tập và công việc sau này.
          </p>
        </div>
        <div class="flex w-full flex-col gap-3 md:w-2/5 md:gap-16">
          <div
            class="flex h-10 w-full items-center justify-start gap-3 rounded-tl-[15px] bg-[#072899] pl-12 pr-4 md:h-24 md:gap-6 md:rounded-tl-[30px] md:pl-16 lg:pl-20"
          >
            <StarColorWhite className="size-4 shrink-0 md:size-8" />
            <h3 class="text-left text-[15px] font-black uppercase text-white md:text-2xl">HIỂU BẢN CHẤT</h3>
          </div>
          <div
            class="flex h-10 w-full items-center justify-start gap-3 rounded-tl-[15px] bg-[#072899] pl-12 pr-4 md:h-24 md:gap-6 md:rounded-tl-[30px] md:pl-16 lg:pl-20"
          >
            <StarColorWhite className="size-4 shrink-0 md:size-8" />
            <h3 class="text-left text-[15px] font-black uppercase text-white md:text-2xl"> HỌC CÓ ĐỊNH HƯỚNG</h3>
          </div>
          <div
            class="flex h-12 w-full items-center justify-start gap-3 rounded-tl-[15px] bg-[#072899] pl-12 pr-4 md:h-[106px] md:gap-6 md:rounded-tl-[30px] md:pl-16 lg:pl-20"
          >
            <StarColorWhite className="size-4 shrink-0 md:size-8" />
            <h3 class="flex flex-col items-start">
              <span class="text-left text-[15px] font-black uppercase text-white md:text-2xl"> TIẾN BỘ BỀN VỮNG </span>
            </h3>
          </div>
        </div>
      </div>
      <div
        class="mt-4 flex w-full flex-col gap-4 rounded-tl-[20px] bg-[#083AD4] px-[34px] py-[14px] md:mt-16 md:flex-row md:gap-6 md:rounded-tl-[60px] md:px-[65px] md:py-9"
      >
        <div class="flex flex-1 flex-col gap-3 md:gap-[26px]">
          <svg
            width="61"
            height="62"
            viewBox="0 0 61 62"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="size-8 md:size-[62px]"
          >
            <path
              d="M0 29.1716V32.8022L0.651787 37.4063C3.22438 49.7083 13.332 59.5941 25.595 61.5787L28.7182 61.9777C29.9008 61.925 31.1155 62.0479 32.2931 61.9777C52.0887 60.8034 65.8405 40.48 59.3448 21.2404C59.1399 20.6357 58.4116 18.5482 58.0881 18.1593C57.9721 18.0187 57.977 17.9987 57.8536 18.1542L52.5776 23.5563C56.4537 35.4744 50.3309 48.5366 38.8777 52.9877C20.7708 60.0256 2.74788 42.9163 8.28314 24.0857C11.9618 11.5729 25.5531 4.39198 37.821 8.56206L43.2007 3.01952C29.2144 -3.96072 12.4827 1.63953 4.48104 14.895C1.93562 19.1127 0.286388 24.2362 0.00246811 29.1691L0 29.1716Z"
              fill="white"></path>
            <path
              d="M45.6227 25.556L43.376 25.6037L39.3196 29.844C40.4701 38.7211 29.4391 43.7744 23.652 36.7992C18.9784 31.1688 22.7533 22.244 29.965 21.9028C30.4785 21.8777 31.3081 22.0759 31.6315 22.0333C32.1104 21.968 35.1274 18.4202 35.8064 17.9109L35.873 15.6928C27.2615 12.293 17.5242 17.5772 15.0479 26.4818C11.4902 39.2731 23.5804 50.8123 35.9298 46.3637C44.171 43.3955 48.6743 33.9739 45.6227 25.556Z"
