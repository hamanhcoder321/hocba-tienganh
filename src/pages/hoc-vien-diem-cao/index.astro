---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StudentHero from '@/components/features/home/student-achievements/StudentHero.astro';
import StudentShowcase from '@/components/features/home/student-achievements/StudentShowcase.astro';
import StudentExperiencesGrid from '@/components/features/home/student-achievements/StudentExperiencesGrid.astro';
import StudentTestimonials from '@/components/features/home/student-achievements/StudentTestimonials.astro';
import SimpleFormRegister from '@/components/common/SimpleFormRegisterchitietkhoahoc.astro';
import JsonLd from '@/components/common/JsonLd.astro';
import type { Graph } from 'schema-dts';

const title = 'Bảng vàng Học Bá Education | Học viên điểm cao';
const description = 'Nơi những Bá sinh chia sẻ hành trình chinh phục Tiếng Trung đầy thử thách và cảm hứng.';

const baseUrl = import.meta.env.PUBLIC_CLIENT_URL ?? 'https://hoc-ba.edu.vn';

const jsonLd: Graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Trang chủ',
          item: baseUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Học viên điểm cao',
          item: `${baseUrl}/hoc-vien-diem-cao`,
        },
      ],
    },
  ],
};
---

<BaseLayout {title} {description}>
  <JsonLd data={jsonLd} />
  <main class="mx-auto max-w-[1920px] overflow-hidden bg-white font-gilroy">
    <StudentHero />

    <div class="flex flex-col gap-2 pb-0 pt-0 md:gap-10">
      <div><StudentShowcase /></div>
      <div><StudentExperiencesGrid /></div>
      <div><StudentTestimonials /></div>
    </div>

    <SimpleFormRegister dataInput="Học viên điểm cao" isSimpleForm />
  </main>
</BaseLayout>
