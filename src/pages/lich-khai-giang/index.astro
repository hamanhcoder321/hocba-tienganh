            <div class="absolute -top-8 left-1 z-50 flex w-fit md:-left-4 md:-top-2">
              <FourPointedStarMini
                className="absolute -bottom-1 -right-2 mt-auto size-2 md:-bottom-2 md:-right-2 md:size-3"
              />
              <FourPointedStar className="size-[28px] md:size-[30px]" />
            </div>
            <h2
              class="whitespace-nowrap px-2 text-center font-gilroy text-[18px] font-[1000] uppercase leading-[1.2] text-primary md:px-0 md:text-[36px] xl:text-[42px]"
            >
              Nền tảng công nghệ vượt trội
            </h2>
          </div>
          <div
            class="relative z-20 mt-2 text-center font-gilroy text-[18px] font-bold capitalize leading-[1.2] text-[#1E242C] md:text-[24px] xl:text-[28px]"
          >
            Tối ưu hiệu suất học
          </div>
          <div class={'relative z-50 px-6 md:px-12 xl:px-0'}>
            <ScheduleAISmartSlide slides={formatAISmart} client:load />
          </div>
          <div
            class="absolute -right-[15%] top-[5%] z-0 size-[186px] md:-right-[10%] md:size-[365px] xl:-right-[6%] xl:top-[12%]"
          >
            <img
              src={IMAGES.khoaChinese.gridRedChinese.src}
