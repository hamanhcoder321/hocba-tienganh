                >
                  <!-- Hiệu ứng nhấp nháy rực rỡ: Chuyển sang dải màu rồi quay lại đỏ -->
                  <div
                    class="animate-pulse-custom absolute left-0 top-0 z-0 h-full w-full bg-gradient-to-r from-[#FE8E39] to-[#8F1E15] opacity-0 transition-opacity duration-1000"
                  >
                  </div>

                  <div class="relative z-10 flex items-center gap-3 md:gap-5 xl:gap-2 2xl:gap-2">
                    <PlayIcon />
                    <span
                      class="font-gilroy text-[20px] font-black uppercase leading-none text-white md:text-[28px] lg:text-[24px] xl:text-[28px] 2xl:whitespace-nowrap 3xl:whitespace-nowrap 3xl:text-[22px]"
                    >
                      ĐĂNG KÝ NGAY
