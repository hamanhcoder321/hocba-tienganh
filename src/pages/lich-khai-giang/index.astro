---
import { FourPointedStar, FourPointedStarMini, PlayIcon } from '@/components/common/icons';
import ScheduleAISmartSlide, {
  type ScheduleAISmartSlideItem,
} from '@/components/features/schedule/ScheduleAISmartSlide';
import JsonLd from '@/components/common/JsonLd.astro';
import ScheduleTableNew from '@/components/features/schedule/ScheduleTableNew';
import HocBaFeatures from '@/components/features/schedule/HocBaFeatures';
import LecturerShowcase from '@/components/features/lecturer/LecturerShowcase';
import StudentExperience from '@/components/features/schedule/StudentExperience.astro';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { IMAGES } from '@/lib/constants/images';
import { fetchOpeningSchedule, fetchTeacherListV2 } from '@/lib/static-data';
import { HOME_CATEGORIES } from '@/lib/constants/content';
import { getImage, Image } from 'astro:assets';
import type { Graph } from 'schema-dts';
import ScheduleFormRegister from '@/components/features/schedule/ScheduleFormRegister.astro';
import { DATA_VALUE } from '@/lib/constants/enums';

const baseUrl = import.meta.env.PUBLIC_CLIENT_URL;

// Fetch data at build time
const scheduleDataPromises = HOME_CATEGORIES.map(async (category) => {
  const data = await fetchOpeningSchedule(String(category.id));
  return { categoryId: category.id, data: data || [] };
});

const scheduleResults = await Promise.all(scheduleDataPromises);

const teacherData = await fetchTeacherListV2({ page: 1, limit: 100 });
const teachers = teacherData?.list ?? [];

const teacherLists = teachers.map((teacher: TLecturer) => {
    const rawAvatar = teacher?.avatar_url?.file_path || IMAGES.course.profilePic.src;

    let highlights: TLecturer['teacherHighlights'] = [];
    try {
      if (teacher.qualification && Array.isArray(teacher.qualification) && teacher.qualification.length > 0) {
        highlights = teacher.qualification.map((q: TQualification, index: number) => ({
          id: index,
          teacher_id: 0,
          section: q.name || '',
          content: q.description || '',
        }));
      } else if (typeof teacher.qualification_info === 'string') {
        const info = JSON.parse(teacher.qualification_info) as { title: string }[];
        highlights = info.map((i: { title: string }, index: number) => ({
          id: index,
          teacher_id: 0,
          section: '',
          content: i.title,
        }));
      }
    } catch (e) {
      console.error('Error parsing teacher highlights:', e);
    }

    return {
      ...teacher,
      optimizedAvatar: rawAvatar,
      teacherHighlights: highlights,
    };
  });

// --- Metadata cho SEO ---
const title = 'Lịch Khai Giảng Tiếng Trung Học Bá | Học Bá Education';
const description =
  'Cập nhật lịch khai giảng các khóa học tiếng Trung mới nhất tại Học Bá Education. Lịch học linh hoạt, cá nhân hóa, cam kết đầu ra HSK/HSKK. Đăng ký nhận tư vấn ngay!';

const jsonLd: Graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Trang chủ',
          item: baseUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Lịch khai giảng',
          item: `${baseUrl}/lich-khai-giang`,
        },
      ],
    },
    ...scheduleResults.flatMap((result) =>
      result.data.map((item: any) => ({
        '@type': 'Course' as const,
        name: item.Course?.name || 'Khóa học tiếng Trung',
        description: item.Course?.description || 'Khóa học tiếng Trung tại Học Bá Education',
        provider: {
          '@type': 'Organization' as const,
          name: 'Học Bá Education',
          url: baseUrl,
        },
      })),
    ),
  ],
};

const aiSmartSlide: ScheduleAISmartSlideItem[] = [
  {
    id: '01',
    title: 'Hệ thống học tập số hoá tất cả loại nội dung',
    mainImage: IMAGES.schedule.lms_slide1,
  },
  {
    id: '02',
    title: 'Cá nhân hóa bài giảng và bài luyện tập',
    mainImage: IMAGES.schedule.lms_slide2,
  },
  {
    id: '03',
    title: 'Tích hợp công nghệ AI chấm chữa bài tự động',
    mainImage: IMAGES.schedule.lms_slide3,
  },
  {
    id: '04',
    title: 'Kho học liệu đa dạng, cập nhập liên tục',
    mainImage: IMAGES.schedule.lms_slide4,
  },
];

const formatAISmart = aiSmartSlide.map((item) => {
  const originalMainImage = item.mainImage;
  const mainImageSrc = typeof originalMainImage === 'string' ? originalMainImage : originalMainImage.src;

  return {
    ...item,
    mainImage: mainImageSrc,
  };
});
---

<script>
  const handleScrollToForm = () => {
    const formRegister = document.getElementById('dang-ki-tu-van');
    if (formRegister) {
      formRegister.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  };

  // Attach event listeners to all buttons
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('[data-scroll-to-form]');
    buttons.forEach((button) => {
      button.addEventListener('click', handleScrollToForm);
    });
  });
</script>

