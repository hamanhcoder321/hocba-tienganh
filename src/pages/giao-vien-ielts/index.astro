---
import AnimatedArrow from '@/components/common/AnimatedArrow';
import { VectorArrow } from '@/components/common/icons';
import JsonLd from '@/components/common/JsonLd.astro';
import SimpleFormRegister from '@/components/common/SimpleFormRegister.astro';
import AboutRegisterSection from '@/components/features/about/AboutRegisterSection.astro';
import LecturerPageClient from '@/components/features/lecturer/LecturerPageClient';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DATA_VALUE } from '@/lib/constants/enums';
import { IMAGES } from '@/lib/constants/images';
import { fetchTeacherListV2 } from '@/lib/static-data';
import { LECTURER_BASE_PATH } from '@/lib/constants/content';
import { Image, getImage } from 'astro:assets';
import type { Graph } from 'schema-dts';
// --- Metadata cho SEO ---
const title = 'Đội Ngũ Giáo Viên IELTS | The IELTS Space';
const description =
  'Tìm hiểu đội ngũ giáo viên IELTS tại The IELTS Space với chuyên môn vững vàng, kinh nghiệm giảng dạy và khả năng theo sát từng học viên.';

const baseUrl = import.meta.env.PUBLIC_CLIENT_URL ?? 'https://thespace.edu.vn';

const jsonLd: Graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Trang chủ',
          item: baseUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Đội ngũ giảng viên',
          item: `${baseUrl}${LECTURER_BASE_PATH}`,
        },
      ],
    },
  ],
};

const heroData = [
  {
    id: 1,
    title: '150+ Giảng viên',
    description: 'Trình độ cao',
    image: IMAGES.lectuter.hero1,
  },
  {
    id: 2,
    title: '100% Đạt chuẩn',
    description: 'IELTS 8.0',
    image: IMAGES.lectuter.hero2,
  },
  {
    id: 3,
    title: '5 -> 10+ Năm kinh',
    description: 'Nghiệm sư phạm',
    image: IMAGES.lectuter.hero3,
  },
  {
    id: 4,
    title: 'Đào tạo +1100 Học',
    description: 'Viên',
    image: IMAGES.lectuter.hero4,
  },
];

// Initial fetch for SSR - will be replaced by client-side filtering
const teacherData = await fetchTeacherListV2({ page: 1, limit: 100 });
const teachers = teacherData?.list ?? [];

const initialLecturers = await Promise.all(
  teachers.map(async (teacher) => {
    const AVATAR_WIDTH = 700;
    const AVATAR_HEIGHT = 900;
    // 1. Tối ưu Avatar chính
    const rawAvatar = teacher?.avatar_url?.file_path || IMAGES.course.profilePic;

    const optimizedAvatar = await getImage({
      src: rawAvatar,
      width: AVATAR_WIDTH,
      height: AVATAR_HEIGHT,
      format: 'webp',
      quality: 80,
      position: 'top',
    });

    return {
      ...teacher,
      optimizedAvatar: optimizedAvatar.src,
    };
  }),
);
---

<BaseLayout {title} {description}>
  <JsonLd data={jsonLd} />
  <div class="relative">
    <section class="relative flex h-auto w-full flex-col overflow-hidden bg-gradient-to-b from-white via-navy-50 to-navy-100 md:h-[854px]">
      <div class="relative z-10 flex h-auto flex-col md:h-[688px] md:px-0">
        <Breadcrumb className="container mt-6 px-4 md:mt-12 md:px-0">
          <BreadcrumbList className="text-foreground text-xs md:text-lg">
            <BreadcrumbItem>
              <BreadcrumbLink asChild>
                <a href="/" class="hover:text-primary hover:underline">Trang chủ</a>
              </BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbPage>Đội ngũ giảng viên</BreadcrumbPage>
            </BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>
        <div class="container z-50 px-4">
          <div class="w-full md:w-[600px]">
            <h1 class="mt-6 font-black uppercase leading-tight md:mt-14">
              <p class="text-ielts-gray text-[28px] md:text-[52px]">Đội ngũ giảng viên</p>
              <p class="text-[24px] text-orange md:text-[52px]">TẠI THE IELTS SPACE</p>
            </h1>
            <div
              class="mt-6 flex h-auto w-full flex-col gap-4 rounded-[20px] md:bg-gradient-to-r bg-gradient-to-b from-[#B8C9FF] to-[#B8C9FF]/0 px-5 py-5 text-[15px] md:mt-14 md:from-orange-100 md:to-orange-100/0 md:px-9 md:py-6 md:text-[20px]"
            >
              <p class="font-medium">
                Tại The IELTS Space, đội ngũ 150+ giảng viên IELTS được tuyển chọn kỹ lưỡng, 
                sở hữu nền tảng chuyên môn vững chắc cùng nhiều năm kinh nghiệm luyện thi IELTS thực chiến.
              </p>
              <p class="font-medium">
                Các giảng viên không chỉ nắm vững tiêu chí đánh giá của kỳ thi mà còn liên tục cập nhật phương pháp giảng dạy tiên tiến,
                đồng thời theo dõi sát sao quá trình học của từng học viên để điều chỉnh lộ trình phù hợp, tối ưu hóa kết quả đầu ra.
              </p>
            </div>
            <Image
              src={IMAGES.lectuter.headBanner}
              width={944}
              height={643}
              alt={'headBanner2'}
              class={'mt-6 aspect-[381/345] w-full rounded-2xl object-cover md:hidden'}
              densities={[1, 2]}
            />
          </div>
        </div>
      </div>
      <div class="relative z-10 mt-auto flex h-auto flex-col justify-center bg-navy px-2 md:h-[166px] xl:px-0">
        <div class="mx-auto grid w-full grid-cols-2 gap-4 py-3 pl-0 md:w-[1264px] md:grid-cols-4 md:py-0">
          {
            heroData.map((item) => (
              <div class="col-span-1 flex gap-3">
                <div class="flex size-12 items-center justify-center rounded-xl bg-white md:size-[86px] md:rounded-3xl">
                  <Image
                    src={item.image}
                    width={80}
                    height={80}
                    alt={`hero${item.id}`}
                    class={'size-11 object-cover md:size-20'}
                    densities={[1, 2]}
                  />
                </div>
                <div class="mt-2 flex flex-col gap-1 text-xs md:leading-4 leading-3 font-bold uppercase text-white md:gap-3 md:text-[20px]">
                  <p>{item.title}</p>
                  <p>{item.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <Image
        src={IMAGES.lectuter.headBanner}
        width={944}
        height={643}
        alt={'headBanner2'}
        class={'absolute hidden md:top-[44%] 3xl:top-[43%] -translate-y-1/2 right-0 md:block md:h-[580px] 3xl:right-[6%] 3xl:h-[643px] w-auto'}
        densities={[1, 2]}
      />
    </section>

    <section class="relative w-full overflow-clip bg-white px-4 md:px-0">
      <Image
        src={IMAGES.introduce.bg_nen}
        alt={'gs_hbc'}
        width={993}
        height={994}
        class={'object-cover w-auto mb-auto absolute scale-75 -top-[18%] -right-[50%] md:-top-[45%] md:-right-[22%] 2xl:-top-[16%] md:-right-[50%] 2xl:-right-[22%] 3xl:-top-[18%] 3xl:-right-[16%] z-0'}
      />
      <div class="h-audo relative z-10 mx-auto flex w-full flex-col pt-4 md:px-10 md:pt-20 2xl:w-[1362px]">
        <div
          class="relative mx-auto flex h-14 w-fit items-center gap-6 px-4 text-lg font-black uppercase text-navy md:h-[80px] md:px-10 md:text-[42px]"
        >
          <AnimatedArrow
            toColor="#072899"
            fromColor="#072899"
            className={'absolute -left-4 top-0 size-4 object-cover md:-top-[30px] md:left-0 md:size-8'}
            client:load
          />
          <p class="md:leading-[60px] leading-6 text-center">TÌM HIỂU giảng viên TẠI </br> THE IELTS SPACE</p >
          <VectorArrow
            toColor="#072899"
            fromColor="#072899"
            className={'absolute -right-1 bottom-2 size-4 rotate-180 object-cover md:-bottom-[20px] md:right-2 md:size-8'}
          />
        </div>
        <LecturerPageClient {initialLecturers} client:load />
      </div>
    </section>
    <!-- <SimpleFormRegister dataInput={DATA_VALUE.CONTACT} /> -->
    <AboutRegisterSection dataInput={DATA_VALUE.LECTURER} defaultObjective="Du học, xin học bổng" />
  </div>
</BaseLayout>
