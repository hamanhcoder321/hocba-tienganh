---
export const prerender = false; // Render SSR để TeacherCarousel được render trên server

import AnimatedArrow from '@/components/common/AnimatedArrow';
import ButtonTitle from '@/components/common/ButtonTitle.astro';
import { Owl, StarColorGradient, VectorArrow, VectorChat, VectorChatLarge, CustomHomeIcon } from '@/components/common/icons';
import JsonLd from '@/components/common/JsonLd.astro';
import AboutRegisterSection from '@/components/features/about/AboutRegisterSection.astro';
import AnimatedBadges from '@/components/features/introduce/AnimatedBadges';
import StaticTeacherCarousel from '@/components/features/home/quality-expert/StaticTeacherCarousel';
import TimeLineCarousel from '@/components/features/introduce/TimeLineCarousel';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DATA_VALUE } from '@/lib/constants/enums';
import { IMAGES } from '@/lib/constants/images';
import { fetchTeacherListV2 } from '@/lib/static-data';
import { cn } from '@/lib/utils';
import { Image } from 'astro:assets';
import imgRocketGioiThieu from '@/assets/images/img-hocba-tienganh/img-rocket-gioi-thieu.png';
import { Globe, Home, MapPin, Star, GraduationCap, Sparkles, TrendingUp, BrainCircuit, BookOpen, LineChart } from 'lucide-react';
import bannerGioiThieu from '@/assets/images/img-hocba-tienganh/banner-gioi-thieu.png';
import bannerGioiThieuMobile from '@/assets/images/img-hocba-tienganh/banner-gioi-thieu-mobile.png';
import trophyIcon from '@/assets/images/img-hocba-tienganh/img-icon-cup.png';
import iconTenLua from '@/assets/images/img-hocba-tienganh/icon-tenlua.png';
import iconMuiTenXanh from '@/assets/images/img-hocba-tienganh/icon-mui-ten-xanh.png';
import imgAnhMo from '@/assets/images/img-hocba-tienganh/img-anh-mo.png';
import iconGroupNhom from '@/assets/images/img-hocba-tienganh/icon-group-nhom.png';
import iconLike from '@/assets/images/img-hocba-tienganh/icon-like.png';
import iconBanCung from '@/assets/images/img-hocba-tienganh/icon-ban-cung.png';
import coVanTiengAnh from '@/assets/images/img-hocba-tienganh/co-van-tienganh.png';
import iconSach from '@/assets/images/img-hocba-tienganh/so-sach-2.png';
import type { Graph } from 'schema-dts';
// --- Metadata cho SEO ---
const title = 'Về Học Bá | Học Bá Education';
const description =
  'Câu chuyện hình thành, sứ mệnh và đội ngũ đằng sau Tiếng Trung Học Bá. Chúng tôi cung cấp giải pháp [Lĩnh vực của bạn] uy tín và chất lượng.';

const baseUrl = import.meta.env.PUBLIC_CLIENT_URL ?? 'https://hoc-ba.edu.vn';

// Breadcrumb Schema cho trang giới thiệu
const jsonLd: Graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Trang chủ',
          item: baseUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Giới thiệu',
          item: `${baseUrl}/gioi-thieu`,
        },
      ],
    },
  ],
};

// Fetch teachers from API
let teachers: TLecturer[] = [];
const teacherData = await fetchTeacherListV2({ page: 1, limit: 10 });

if (teacherData?.list) {
  teachers = teacherData.list;
} else {
  console.log('No teacher data from API, using empty array');
}

const statistics = [
  {
    number: '6.000+',
    description: '<span class="md:hidden">Học viên đã tin tưởng & lựa<br/>chọn THE IELTS SPACE</span><span class="hidden md:inline">Học viên đã tin tưởng & lựa<br/>chọn THE IELTS SPACE</span>',
  },
  {
    number: '275+',
    description: '<span class="md:hidden">Học viên sử dụng kết quả<br/>phục vụ mục tiêu du học</span><span class="hidden md:inline">Học viên sử dụng kết quả<br/>phục vụ mục tiêu du học</span>',
  },
  {
    number: '99,9%',
    description: '<span class="md:hidden">Tỷ lệ học viên đạt chuẩn đầu<br/>ra theo lộ trình</span><span class="hidden md:inline">Tỷ lệ học viên đạt chuẩn<br/>đầu ra theo lộ trình</span>',
  },
  {
    number: '80+',
    description: '<span class="md:hidden">Doanh nghiệp đã tin tưởng và<br/>đồng hành cùng THE IELTS<br/>SPACE</span><span class="hidden md:inline">Doanh nghiệp đã tin<br/>tưởng và đồng hành cùng<br/>THE IELTS SPACE</span>',
  },
  {
    number: '813+',
    description: '<span class="md:hidden">Nội dung học thuật được<br/>nghiên cứu và phát triển</span><span class="hidden md:inline">Nội dung học thuật được<br/>nghiên cứu và phát triển</span>',
  },
  {
    number: '25+',
    description: '<span class="md:hidden">Đầu sách nội bộ đã được sử<br/>dụng phục vụ đào tạo & xây<br/>học liệu</span><span class="hidden md:inline">Đầu sách nội bộ đã được<br/>sử dụng phục vụ đào tạo<br/>& xây học liệu</span>',
  },
];

const timeline = [
  {
    date: 'Tháng 06/2024',
    description:
      'THE IELTS SPACE chính thức được thành lập, đặt nền móng đầu tiên cho hành trình xây dựng một hệ sinh thái đào tạo tiếng Anh bài bản. Lấy chất lượng giảng dạy, kết quả đầu ra và giá trị dài hạn của học viên làm trọng tâm.',
    position: 'top' as const,
