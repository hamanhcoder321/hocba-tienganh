    ],
    image: IMAGES.introduce.dkb2,
    position: 'object-center',
  },
  {
    number: 3,
    bgColor: '#0B36BD',
    title: 'CỐ VẤN HỌC THUẬT & GIẢNG<br class="block md:hidden"/> VIÊN GIỎI CHUYÊN MÔN, GIÀU<br class="block md:hidden"/> KINH NGHIỆM',
    subtitle: '⭐ Cố vấn Quốc tế Mr.Jackson Howard và các<br class="hidden md:block"/> giảng viên Thạc sĩ, NCS Tiến sĩ giàu kinh nghiệm,<br class="hidden md:block"/> đảm bảo chuyên môn.',
