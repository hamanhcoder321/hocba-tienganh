  },
  {
    date: 'Tháng 12/2024',
    description:
      'THE IELTS SPACE bắt đầu quá trình nghiên cứu chuyên sâu thị trường đào tạo tiếng Anh tại Việt Nam và Quốc tế, tập trung phân tích những khoảng trống trong hành trình từ học tập - luyện thi - đến chinh phục mục tiêu đầu ra.',
    position: 'top' as const,
  },
  {
    date: 'Tháng 05/2025',
    description:
      'Hoàn thiện và ra mắt THE IELTS SPACE, chương trình luyện thi IELTS được thiết kế bài bản với hệ thống 6 level từ 0.0 đến 8.0 IELTS, hướng tới xây dựng lõi sản phẩm là năng lực tư duy và phát triển ngôn ngữ vững chắc thay vì chỉ tập trung vào các mẹo và kỹ thuật làm bài.',
    position: 'top' as const,
  },
  {
    date: 'Tháng 01/2026',
    description:
      'Giới thiệu chương trình luyện thi IELTS mới với giáo trình nội bộ, phương pháp học riêng và hệ thống LMS luyện tập Online, hướng tới một hành trình học tập liền mạch, có thể đo lường và tối ưu theo từng giai đoạn.',
    position: 'bottom' as const,
    colStart: 'col-start-3',
  },
  {
    date: 'Tháng 08/2026',
    description:
      'Chính thức ra mắt LMS E-Power và Không gian học tập tích hợp thế hệ mới. Phiên bản nâng cấp toàn diện của sản phẩm luyện thi IELTS Hybird, đánh dấu bước chuyển mình trở thành doanh nghiệp tiên phong định hình xu hướng giáo dục mới',
    position: 'bottom' as const,
  },
  // {
  //   date: '07/2025 – 12/2025',
  //   description:
  //     'Giới thiệu Học Bá Plus – phiên bản nâng cấp toàn diện về sản phẩm, học liệu, hệ thống LMS và trải nghiệm học viên, đánh dấu bước tiến quan trọng trong chiến lược phát triển dài hạn và bền vững của Học Bá Education.',
  //   position: 'bottom' as const,
  // },
];

const coreValues = [
  {
    image: iconGroupNhom,
    alt: 'tt_hq_tc',
    title: 'TẬN TÂM - QUYẾT LIỆT',
    width: 'md:w-[330px]',
  },
  {
    image: iconLike,
    alt: 'ht_dd_ptld',
    title: 'HỌC THẬT - KẾT QUẢ THẬT',
    width: 'md:w-[376px]',
  },
  {
    image: iconBanCung,
    alt: 'cmmd_vmnt',
    title: 'KHÔNG NGỪNG ĐỔI MỚI',
    width: 'md:w-[330px]',
  },
];

const cards = [
  {
    number: 1,
    bgColor: '#0B36BD',
    title: 'HỆ SINH THÁI HỌC TẬP TỐI ƯU<br class="block md:hidden"/> VỚI LMS E-SPACE',
    points: [
      'Tích hợp công nghệ AI chấm chữa bài tự động, cá nhân hoá bài luyện dựa trên điểm mạnh, yếu và năng lực tiếp thu ngôn ngữ của học viên.',
      'Kho bài tập và đề thi mô phỏng đa dạng được giáo viên nghiên cứu, kiểm duyệt và cập nhật liên tục.',
      'Bộ từ điển xây dựng độc quyền đầy đủ Collocation, từ đồng nghĩa và trái nghĩa. Học từ vựng qua phương pháp Spaced Repetition và Mindmap.',
      'Dashboard trực quan giúp học viên biết rõ mình đang ở đâu và cần làm gì tiếp theo.',
    ],
    image: IMAGES.introduce.dkb1,
    position: 'object-center',
  },
  {
    number: 2,
    bgColor: '#0B36BD',
    title: 'PHƯƠNG PHÁP HỌC ĐỘC<br class="block md:hidden"/> QUYỀN ĐƯỢC<br class="hidden md:block"/> NGHIÊN CỨU<br class="block md:hidden"/> BỞI ĐỘI NGŨ QUỐC TẾ',
    points: [
      'Phương pháp SPACE by TES phát triển năng lực xử lý ngôn ngữ có hệ thống và xây dựng lộ trình tư duy có chủ đích.',
      'Học viên được rèn luyện cách tư duy theo bài thi IELTS, phân tích thông tin với lăng kính đa chiều và tái ứng dụng kiến thức vào những tình huống mới.',
      'Phát triển 7 năng lực cốt lõi cho người học, giúp việc học tập trung đúng trọng tâm, giảm tải thời gian nhưng nâng cao hiệu quả gấp nhiều lần.'
    ],
    image: IMAGES.introduce.dkb2,
    position: 'object-center',
  },
  {
    number: 3,
    bgColor: '#0B36BD',
    title: 'CỐ VẤN HỌC THUẬT & GIẢNG<br class="block md:hidden"/> VIÊN GIỎI CHUYÊN MÔN, GIÀU<br class="block md:hidden"/> KINH NGHIỆM',
    subtitle: '⭐ Cố vấn Quốc tế Mr.Jackson Howard và các<br class="hidden md:block"/> giảng viên Thạc sĩ, NCS Tiến sĩ giàu kinh nghiệm,<br class="hidden md:block"/> đảm bảo chuyên môn.',
    points: [
      '1 cố vấn học thuật quốc tế',
      '120+ Giáo viên, Giảng viên IELTS từ 8.0 trở lên.',
