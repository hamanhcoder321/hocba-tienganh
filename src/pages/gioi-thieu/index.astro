---
export const prerender = false; // Render SSR để TeacherCarousel được render trên server

import AnimatedArrow from '@/components/common/AnimatedArrow';
import ButtonTitle from '@/components/common/ButtonTitle.astro';
import { Owl, StarColorGradient, VectorArrow, VectorChat, VectorChatLarge } from '@/components/common/icons';
import JsonLd from '@/components/common/JsonLd.astro';
import SimpleFormRegister from '@/components/common/SimpleFormRegister.astro';
import AnimatedBadges from '@/components/features/introduce/AnimatedBadges';
import TeacherCarousel from '@/components/features/introduce/TeacherCarousel';
import TimeLineCarousel from '@/components/features/introduce/TimeLineCarousel';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DATA_VALUE } from '@/lib/constants/enums';
import { IMAGES } from '@/lib/constants/images';
import { fetchTeacherListV2 } from '@/lib/static-data';
import { cn } from '@/lib/utils';
import { Image } from 'astro:assets';
import { Globe, Home, MapPin, Star } from 'lucide-react';
import type { Graph } from 'schema-dts';
// --- Metadata cho SEO ---
const title = 'Về Học Bá | Học Bá Education';
const description =
  'Câu chuyện hình thành, sứ mệnh và đội ngũ đằng sau Tiếng Trung Học Bá. Chúng tôi cung cấp giải pháp [Lĩnh vực của bạn] uy tín và chất lượng.';

const baseUrl = import.meta.env.PUBLIC_CLIENT_URL ?? 'https://hoc-ba.edu.vn';

// Breadcrumb Schema cho trang giới thiệu
const jsonLd: Graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Trang chủ',
          item: baseUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Giới thiệu',
          item: `${baseUrl}/gioi-thieu`,
        },
      ],
    },
  ],
};

// Fetch teachers from API
let teachers: TLecturer[] = [];
const teacherData = await fetchTeacherListV2({ page: 1, limit: 10 });

if (teacherData?.list) {
  teachers = teacherData.list;
} else {
  console.log('No teacher data from API, using empty array');
}

const statistics = [
  {
    number: '10.000+',
    description: 'Học viên đã tin tưởng & lựa chọn Học Bá Education',
  },
  {
    number: '586+',
    description: 'Học viên sử dụng kết quả phục vụ mục tiêu du học',
  },
  {
    number: '99,9%',
    description: 'Tỷ lệ học viên đạt chuẩn đầu ra theo lộ trình',
  },
  {
    number: '100+',
    description: 'Doanh nghiệp đã tin tưởng & đồng hành cùng Học Bá Education',
  },
  {
    number: '1.668+',
    description: 'Nội dung học thuật được nghiên cứu và phát triển',
  },
  {
    number: '25+',
    description: 'Đầu sách nội bộ phục vụ đào tạo & xây học liệu',
  },
];

const timeline = [
  {
    date: 'Tháng 06/2023',
    description:
      'Học Bá Education chính thức được thành lập, khởi đầu cho hành trình xây dựng một hệ sinh thái đào tạo tiếng Trung bài bản, nơi chất lượng học thuật, chuẩn đầu ra và giá trị dài hạn cho người học được đặt làm trọng tâm.',
    position: 'top' as const,
    colStart: 'col-start-2',
  },
  {
    date: 'Tháng 01/2024',
    description:
      'Học Bá Education bắt tay vào quá trình nghiên cứu chuyên sâu các chương trình đào tạo Hán ngữ tại Việt Nam, tập trung phân tích cấu trúc chương trình, chuẩn năng lực và khoảng cách giữa việc học – thi – ứng dụng thực tế.',
    position: 'top' as const,
  },
  {
    date: 'Tháng 06/2024',
    description:
      'Hoàn thiện và ra mắt Học Bá HSK, sản phẩm đào tạo luyện thi HSK được thiết kế theo tư duy hệ thống, hướng tới việc xây dựng nền tảng năng lực bền vững thay vì chỉ tập trung vào kỹ thuật làm bài.',
    position: 'top' as const,
  },
  {
    date: 'Tháng 12/2024',
    description:
      'Hoàn thiện Học Bá Chinese – Tiếng Trung cho người đi làm, chương trình đào tạo tập trung vào giao tiếp ứng dụng, môi trường công sở và các tình huống thực tế, đáp ứng nhu cầu học tiếng Trung phục vụ công việc và sự nghiệp.',
    position: 'bottom' as const,
    colStart: 'col-start-3',
  },
  {
    date: 'Tháng 01/2025',
    description:
      'Chính thức ra mắt Học Bá HSK 3.0 – hệ thống luyện thi HSK Online thế hệ mới, được phát triển dựa trên chuẩn năng lực thực, lộ trình cá nhân hóa và trải nghiệm học tập tối ưu.',
    position: 'bottom' as const,
  },
  {
    date: '07/2025 – 12/2025',
    description:
      'Giới thiệu Học Bá Plus – phiên bản nâng cấp toàn diện về sản phẩm, học liệu, hệ thống LMS và trải nghiệm học viên, đánh dấu bước tiến quan trọng trong chiến lược phát triển dài hạn và bền vững của Học Bá Education.',
    position: 'bottom' as const,
  },
];

const coreValues = [
  {
    image: IMAGES.introduce.tt_hq_tc,
    alt: 'tt_hq_tc',
    title: 'Tận Tâm - Hiệu quả - Thực chiến',
    width: 'md:w-[330px]',
  },
  {
    image: IMAGES.introduce.ht_dd_ptld,
    alt: 'ht_dd_ptld',
    title: 'Học thật - Dùng được - Phát triển lâu dài',
    width: 'md:w-[376px]',
  },
  {
    image: IMAGES.introduce.cmmd_vmnt,
    alt: 'cmmd_vmnt',
    title: 'Chung một đích đến - Vững một niềm tin',
    width: 'md:w-[330px]',
  },
];

const cards = [
  {
    number: 1,
    bgColor: '#780000',
    title: 'Phương pháp học hiện đại theo chuẩn các đại học hàng đầu thế giới',
    subtitle: '⭐ Phát triển bởi GS. Baozhang He, nguyên Giám đốc chương trình tiếng Trung Harvard',
    points: [
      'Phương pháp học "Project-Based Learning chuẩn quốc tế - học bằng hành động, thuyết trình, giải quyết vấn đề thực tế.',
      'Phương pháp học Visual Learning kết hợp flashcard, hình ảnh, trò chơi ngôn ngữ, tranh luận nhóm.',
      'Học đúng đường - không học vẹt, kết hợp Phương pháp học Functional Learning để ghi nhớ và ứng dụng ngữ pháp HSK 3.0.',
    ],
    image: IMAGES.introduce.dkb_slide1,
    position: 'object-right',
  },
  {
    number: 2,
    bgColor: '#B90E0A',
    title: 'Lớp học Công nghệ - kết hợp nền tảng LMS hiện đại',
    points: [
      'Hệ thống học tập số hóa: lưu tiến độ, chấm bài, ôn tập tự động.',
      'Cá nhân hóa bài giảng và bài luyện, giúp học viên học chủ động, không rơi rớt kiến thức.',
      'Hệ thống tích hợp công nghệ AI chấm chữa bài tự động',
      'Kho học liệu đa dạng (video, flashcards, slides bài giảng..)',
    ],
    image: IMAGES.introduce.dkb_slide2,
    position: 'object-center',
  },
  {
    number: 3,
    bgColor: '#D94C00',
    title: 'Cố vấn học thuật & giảng viên giỏi chuyên môn, giàu kinh nghiệm',
    subtitle: '⭐ GS. Baozhang He và các giảng viên Thạc sĩ, NCS Tiến sĩ giàu kinh nghiệm, đảm bảo chuyên môn.',
    points: [
      '1 cố vấn học thuật quốc tế',
      '20+ chuyên gia cao cấp',
      'Nghiên cứu - phát triển 424 điểm ngữ pháp HSK 3.0',
      'Đội ngũ xây dựng chương trình HSK & Chinese Application',
    ],
    image: IMAGES.introduce.dkb_slide3,
    position: 'object-center',
  },
  {
    number: 4,
    bgColor: '#FFA10A',
    title: 'Mentor HỌC THUẬT đồng hành sát sao, HỖ TRỢ HỌC VIÊN 24/7',
    subtitle: '⭐ “Huấn luyện viên thầm lặng” giúp mọi học viên Học Bá chinh phục mục tiêu Tiếng Trung',
    points: [
      'Luôn sẵn sàng giải đáp mọi thắc mắc về bài học, bài tập. Giao thêm tài liệu, bài luyện tập phù hợp với trình độ để học viên tiến bộ',
      'Theo dõi sát sao tiến độ học tập của từng học viên',
      'Sửa bài tập, góp ý chi tiết để học viên nắm chắc kiến thức.',
      'Gắn kết lớp học, tạo không khí học tập tích cực và hứng thú.',
    ],
    image: IMAGES.introduce.dkb_slide4,
    position: 'object-center',
  },
];
---

<BaseLayout {title} {description}>
  <JsonLd data={jsonLd} />
  <div class="relative">
    <section class="relative h-[328px] w-full overflow-hidden md:h-[652px]">
      <div
        class="absolute inset-0 z-0 w-full bg-[linear-gradient(180deg,#B90E0A_0%,#7D1900_137.89%)] pt-5 max-sm:flex max-sm:justify-center"
      >
        <div class="mx-auto flex size-[600px] items-center justify-center rounded-full bg-[#FFA2A221] md:size-[1253px]">
          <div
            class="mx-auto flex size-[484px] items-center justify-center rounded-full bg-[#FF999921] md:size-[1007px]"
          >
            <div
              class="mx-auto flex size-[429px] items-center justify-center rounded-full bg-[#FF999952] md:size-[895px]"
            >
              <div
                class="mx-auto size-[310px] rounded-full bg-[radial-gradient(53.34%_53.34%_at_49.91%_39.55%,_#FFFFFF_0%,_rgba(255,246,246,0.8)_100%)] md:size-[646px]"
              >
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="container relative z-10 flex h-[328px] flex-col px-4 pt-4 md:h-[652px] md:px-0 md:pt-8">
        <Breadcrumb>
          <BreadcrumbList className="text-xs text-white md:text-lg">
            <BreadcrumbItem>
              <BreadcrumbLink asChild>
                <a href="/">Trang chủ</a>
              </BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbPage className="text-white"> Về chúng tôi </BreadcrumbPage>
            </BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>

        <div class="flex w-full flex-1 flex-col items-center">
          <div class="text-base font-black uppercase text-white md:text-[32px]">HỌC BÁ EDUCATION</div>
          <div
            class="relative flex h-10 items-center bg-gradient-to-t from-[#FFF8F8] to-[#FFDF89] bg-clip-text px-4 text-2xl font-black uppercase text-transparent md:mt-2 md:h-[66px] md:px-10 md:text-[52px]"
          >
            <AnimatedArrow
              toColor="#FFF8F8"
              fromColor="#FFDF89"
              className={'absolute -left-1 top-2 size-4 object-cover md:-top-4 md:left-2 md:size-8'}
              client:load
            />
            <p>Học từ người giỏi nhất</p>
            <VectorArrow
              toColor="#FFF8F8"
              fromColor="#FFDF89"
              className={'absolute -right-1 bottom-2 size-4 rotate-180 object-cover md:-bottom-4 md:right-2 md:size-8'}
            />
          </div>
          <AnimatedBadges client:load />
          <div class="relative">
            <div class="absolute -left-2 top-6 flex md:-left-6 md:top-8">
              <VectorChat className="h-7 w-[50px] md:h-auto md:w-auto" />
              <p
                class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-2/3 text-nowrap text-[10px] font-bold text-white md:text-base"
              >
                学霸教育
              </p>
            </div>

            <Image
              src={IMAGES.introduce.instructor}
              height={495}
              width={575}
              alt={'instructor'}
              densities={[1, 2]}
              quality={95}
              class={'object-cover w-[264px] md:w-[575px] h-auto mt-6 md:mt-4'}
            />
            <div class="absolute right-2 top-8 flex md:right-6">
              <VectorChatLarge className="h-7 w-8 md:h-auto md:w-[50px] md:w-auto" />
              <p
                class="absolute -right-1 top-1/2 -translate-x-1/2 -translate-y-2/3 text-nowrap text-[10px] font-bold text-white md:-right-0 md:text-base"
              >
                你好
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="w-full overflow-hidden px-4 md:px-0">
      <div class="h-audo container relative z-10 flex w-full flex-col pt-4 md:h-[652px] md:pt-12">
        <div
          class="relative flex h-14 w-fit items-center gap-6 px-4 text-lg font-black uppercase text-primary md:h-[64px] md:px-10 md:text-[42px]"
        >
          <AnimatedArrow
            toColor="#AF0000"
            fromColor="#AF0000"
            className={'absolute -left-1 top-2 size-4 object-cover md:-top-4 md:left-2 md:size-8'}
            client:load
          />
          <h1>Câu chuyện về học bá</h1>
          <Owl className="size-8 md:size-auto text-primary" />
          <VectorArrow
            toColor="#AF0000"
            fromColor="#AF0000"
            className={'absolute -right-1 bottom-2 size-4 rotate-180 object-cover md:-bottom-4 md:right-2 md:size-8'}
          />
        </div>
        <div class="flex grid-cols-2 flex-col md:grid">
          <div class="col-span-1">
            <ButtonTitle title="Lịch sử hình thành" icon={Home} className="mt-2 md:mt-8" />
            <div class="mt-0 px-0 py-4 text-base font-medium md:mt-4 md:px-9 md:py-10">
              <p>
                <strong>Học Bá Education</strong> là hệ thống đào tạo Hán ngữ trực tuyến theo phương pháp chuẩn quốc tế, hướng
                tới việc chuẩn hóa năng lực người học và nâng cao khả năng ứng dụng tiếng Trung trong học tập, công việc và
                sự nghiệp dài hạn.
              </p>
              <p class="mt-4">
                Thành lập từ tháng 06/2023, <strong>Học Bá Education</strong> xây dựng hệ sinh thái đào tạo tiếng Trung Online
                với các chương trình luyện thi HSK 3.0, YCT và tiếng Trung cho người đi làm, được triển khai trên nền tảng
                số với hệ thống LMS, học liệu số hóa và lộ trình học cá nhân hóa.
              </p>
              <p class="mt-4">
                Chúng tôi tin rằng, khi phương pháp đúng được kết hợp với công nghệ phù hợp, người học có thể xây dựng
                năng lực tiếng Trung bền vững và sử dụng hiệu quả trong thực tế.
              </p>
            </div>
          </div>
          <div class="relative col-span-1 mb-16 h-[236px] w-[344px] md:mb-0 md:h-full md:w-auto">
            <Image
              src={IMAGES.introduce.lich_su_hinh_thanh2}
              alt="lich_su_hinh_thanh2"
              width={422}
              height={422}
              quality={95}
              densities={[1, 2]}
              class={'object-cover size-[112px] md:size-[211px] absolute top-0 md:-top-10 -right-[2%] md:-right-10 rounded-lg'}
            />
            <Image
              src={IMAGES.introduce.lich_su_hinh_thanh1}
              alt="lich_su_hinh_thanh1"
              width={822}
              height={768}
              quality={95}
              densities={[1, 2]}
              class={'object-cover object-left w-[218px] md:w-[411px] h-[204px] md:h-[384px] absolute bottom-0 left-[44%] max-sm:-translate-x-1/2 md:left-20 rounded-lg md:rounded-3xl brightness-125'}
            />
            <Image
              src={IMAGES.introduce.staff_founder}
              alt="staff_founder"
              width={374}
              height={374}
              quality={95}
              densities={[1, 2]}
              class={'object-cover size-[100px] md:size-[187px] absolute -bottom-6 md:-bottom-10 left-0 md:left-0 rounded-lg'}
            />
          </div>
        </div>
      </div>
    </section>

    <section class="w-full overflow-hidden bg-[#FFF4F4] px-4 py-6 md:px-0 md:py-16">
      <div class="container relative z-10 flex w-full flex-col">
        <ButtonTitle title="Cột mốc phát triển" icon={MapPin} className="mb-6 md:mb-16" />
      </div>
      <div class="relative flex text-[#373737] md:flex-col 3xl:px-[240px]">
        <div class="container hidden grid-cols-12 border-b border-black md:grid">
          {
            timeline
              .filter((item) => item.position === 'top')
              .map((item) => (
                <div
                  class={`relative col-span-3 flex flex-col gap-4 border-l border-black px-6 py-4 ${item.colStart || ''}`}
                >
                  <div class="absolute -left-2 top-0 size-4 rounded-full bg-black" />
                  <h3 class="text-base font-black md:text-[28px]">{item.date}</h3>
                  <p class="text-base font-medium">{item.description}</p>
                </div>
              ))
          }
        </div>
        <div class="container hidden grid-cols-12 md:grid">
          {
            timeline
              .filter((item) => item.position === 'bottom')
              .map((item) => (
                <div
                  class={`relative col-span-3 flex flex-col gap-4 border-l border-black px-6 py-4 ${item.colStart || ''}`}
                >
                  <div class="absolute -left-2 bottom-0 size-4 rounded-full bg-black" />
                  <h3 class="text-base font-black md:text-[28px]">{item.date}</h3>
                  <p class="text-base font-medium">{item.description}</p>
                </div>
              ))
          }
        </div>
        <div class="container md:hidden">
          <TimeLineCarousel client:load {timeline} />
        </div>
      </div>
    </section>

    <section class="relative w-full overflow-hidden px-4 py-4 md:px-0 md:py-10">
      <Image
        src={IMAGES.introduce.su_menh_tam_nhin}
        alt={'su_menh_tam_nhin'}
        width={1920}
        height={470}
        class={'object-cover h-[223px] md:h-auto absolute top-1/2 -translate-y-1/2 left-0 z-0 md:mt-24 opacity-40'}
      />
      <div class="container relative z-10">
        <ButtonTitle title="Sứ mệnh & Tầm nhìn" icon={Globe} className="mb-6 md:mb-16" />
        <div class="flex flex-col items-start justify-center gap-16 px-4 md:flex-row md:gap-40 md:px-0 md:px-6">
          <div class="flex w-full flex-col md:w-[422px]">
            <div class="flex items-center justify-center gap-2 md:gap-6">
              <Image
                src={IMAGES.introduce.coin}
                alt={'coin'}
                width={68}
                height={68}
                class={'object-cover size-[50px] md:size-[68px]'}
              />
              <p class="text-2xl font-black uppercase text-primary md:text-[52px]">Sứ mệnh</p>
            </div>
            <p class="text-justify text-base font-medium">
              Cam kết mang đến môi trường học tập tối ưu, khai phóng tiềm năng và phát triển cá nhân thông qua chương
              trình đào tạo tiếng Trung chuẩn quốc tế, ứng dụng phương pháp hiện đại & công nghệ tiên tiến. Học Bá đồng
              hành toàn diện với học viên, trang bị kỹ năng ngôn ngữ, giao tiếp & công sở chuyên sâu để mở rộng cơ hội
              nghề nghiệp và tự tin làm việc trong môi trường Trung Quốc/Đài Loan.
            </p>
          </div>
          <div class="flex w-full flex-col md:w-[422px]">
            <div class="flex items-center justify-center gap-6">
              <Image
                src={IMAGES.introduce.target_3d}
                alt={'coin'}
                width={68}
                height={68}
                class={'object-cover size-[50px] md:size-[68px]'}
              />
              <p class="text-2xl font-black uppercase text-primary md:text-[52px]">Tầm nhìn</p>
            </div>
            <p class="text-justify text-base font-medium">
