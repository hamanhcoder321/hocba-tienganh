          <div class="w-full md:w-1/2">
            <Image
              src={IMAGES.introduce.hocba_education}
              alt={'hocbachinese'}
              width={402}
              height={225}
              densities={[1, 2]}
              class={'object-cover w-[300px] md:w-auto h-auto md:h-[255px] mx-auto'}
            />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-x-2 gap-y-8 px-4 md:grid-cols-3 md:gap-x-12 md:gap-y-16 md:px-0">
          {
            statistics.map((stat) => (
              <div class="col-span-1 flex flex-col border-l-[3px] border-[#6D6D6D] pl-[10px] pr-1 md:px-5 md:border-l-4">
                <div class="mb-1 text-[20px] font-black leading-none text-[#072899] md:mb-0 md:text-[28px]">{stat.number}</div>
                <p class="text-[11px] font-medium leading-tight md:text-[15px] md:leading-normal" set:html={stat.description}></p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative w-full px-7 py-4 md:px-0 md:pt-24">
      <div class="container relative z-10 flex flex-col gap-4 md:gap-8">
        <div
          class="relative mx-auto flex flex-col items-center gap-0 px-0 text-[52px] font-black uppercase md:gap-2 md:px-10"
        >
          <div class="flex gap-2">
            <Image
              src={IMAGES.introduce.machine}
              alt={'hocbachinese'}
              width={70}
              height={40}
              densities={[1, 2]}
              class={'object-cover w-7 md:w-auto h-full'}
            />
            <h2 class="text-lg md:text-[38px]">Điểm khác biệt</h2>
          </div>
          <div class="flex flex-col items-center justify-center">
            <div
              class="flex h-auto items-center text-center md:text-nowrap rounded-[18px] px-0 text-lg font-black uppercase text-[#072899] md:h-[52px] md:px-6 md:text-[42px]"
            >
              tạo nên thương hiệu của <br class="block md:hidden" /> THE IELTS SPACE
            </div>
            <div class="mt-1 h-1 w-16 rounded-full bg-[#F97316] md:hidden"></div>
          </div>
        </div>
        <div class="relative mt-0 md:mb-0 md:mb-[100px] md:mt-0 md:mt-10">
          {
            cards.map((card, index) => (
              <div
                class="relative mt-8 md:mt-0 md:sticky md:top-32 h-auto md:h-[650px] md:pt-[calc(var(--card-index)*20px)]"
                style={{
                  '--card-index': index,
                }}
              >
                <div
                  class="relative flex flex-col md:flex-row h-auto w-full transform-none gap-2 rounded-lg px-4 py-6 transition-transform duration-500 md:mx-auto md:mb-auto md:h-[480px] md:w-[1060px] md:translate-x-[calc(var(--card-index)*20px)] md:transform md:gap-4 md:rounded-[28px] md:py-10 md:pl-14 md:pr-7"
                  style={`background-color: ${card.bgColor};`}
                >
                  <div
                    class="absolute -top-6 left-8 flex h-6 w-10 items-center justify-center rounded-t-lg text-sm font-black text-white md:left-[calc(var(--card-index)*50px+64px)] md:h-[34px] md:w-[70px] md:rounded-t-xl md:text-2xl md:text-lg"
                    style={`--card-index: ${index}; background-color: ${card.bgColor};`}
                  >
                    {card.number}
                  </div>
                  <div class="contents md:block md:w-[583px]">
                    <h3
                      class={cn(
                        'order-1 w-full rounded-[10px] bg-white px-4 py-3 text-[14px] font-black uppercase leading-[1.4] shadow-lg md:rounded-[20px] md:px-9 md:text-[28px]',
                        index === 1 ? 'md:w-max md:relative md:z-10' : 'md:w-fit'
                      )}
                      style={`color: ${card.bgColor}`}
                      set:html={card.title}
                    >
                    </h3>
                    {card.subtitle && (
                      <div class="order-3 mb-4 mt-2 rounded-[8px] bg-[#2A3E7C] p-3 text-[12px] font-bold leading-relaxed text-white md:order-none md:mb-0 md:mt-3 md:bg-transparent md:p-0 md:text-[20px] md:leading-snug" set:html={card.subtitle}></div>
                    )}
                    <div class="order-4 mt-2 flex flex-col gap-3 text-[11px] font-normal text-white md:mt-3 md:gap-[10px] md:text-[16px] xl:text-lg leading-[1.6] md:leading-snug">
                      {card.points.map((point) => (
                        <p class="flex items-start">
                          <span class="mr-2 mt-[6px] md:mt-[10px] shrink-0 inline-block size-[4px] md:size-2 rounded-full bg-white" />
                          <span set:html={point}></span>
                        </p>
                      ))}
                    </div>
                  </div>
                  <div class="contents md:block md:flex-1">
                    <div class="order-2 mb-2 mt-4 flex w-full justify-center overflow-hidden md:mb-0 md:mt-0 md:h-[390px] md:w-[365px] md:justify-end">
                      <Image
                        src={card.image}
                        alt={'hocbachinese'}
                        width={365}
                        height={390}
                        densities={[1, 2]}
                        class={cn(
                          'h-auto w-full rounded-[10px] object-contain md:h-full md:w-auto md:rounded-[20px]',
                          card.position,
                        )}
                      />
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative z-50 pt-12 md:pb-0 md:pt-0">
      <AboutRegisterSection dataInput={DATA_VALUE.ABOUT} />
    </section>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const readMoreBtn = document.getElementById('read-more-btn');
      const readMoreContainer = document.getElementById('read-more-container');
      const dots = document.getElementById('history-dots');
      const moreText = document.getElementById('history-more-text');
      const moreP = document.getElementById('history-more-p');
      
      if (readMoreBtn && readMoreContainer) {
        readMoreBtn.addEventListener('click', () => {
          if (dots) dots.classList.add('hidden');
          if (moreText) {
            moreText.classList.remove('hidden');
            moreText.classList.add('inline');
          }
          if (moreP) {
            moreP.classList.remove('hidden');
            moreP.classList.add('block');
          }
          readMoreContainer.style.display = 'none';
        });
      }
    });
  </script>
</BaseLayout>
