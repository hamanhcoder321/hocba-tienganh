      'Đội ngũ bảo trợ chuyên môn'
    ],
    image: IMAGES.introduce.dkb3,
    position: 'object-center',
  },
  {
    number: 4,
    bgColor: '#0B36BD',
    title: 'MENTOR HỌC THUẬT ĐỒNG HÀNH<br class="block md:hidden"/> SÁT SAO, HỖ TRỢ HỌC VIÊN 24/7',
