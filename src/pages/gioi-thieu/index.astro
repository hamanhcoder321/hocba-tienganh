---

<BaseLayout {title} {description}>
  <JsonLd data={jsonLd} />
  <div class="relative">
    <section id="hero-banner" class="w-full overflow-hidden bg-[#083AD4] bg-[linear-gradient(135deg,#042278_0%,#052284_100%)]">
      <div class="relative mx-auto w-full max-w-[1440px] min-h-[400px] md:min-h-[710px]">
        {/* 
          Background Colors and effects to remember:
          - Glow effect: bg-white opacity-20 blur-[150px]
        */}
        <div class="absolute -bottom-1/4 -right-1/4 h-[80%] w-[80%] rounded-full bg-white opacity-20 blur-[150px]"></div>

        <div 
          id="breadcrumb-container"
          class="absolute z-20 flex items-center gap-1 md:left-[57px] md:top-[38px] left-4 top-4 opacity-100"
        >
          <Breadcrumb>
            <BreadcrumbList className="flex gap-1 text-white/80 text-sm">
              <BreadcrumbItem>
                <BreadcrumbLink asChild>
                  <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
                </BreadcrumbLink>
              </BreadcrumbItem>
              <BreadcrumbSeparator className="text-white/80" />
              <BreadcrumbItem>
                <BreadcrumbPage className="text-white font-semibold">Về chúng tôi</BreadcrumbPage>
              </BreadcrumbItem>
            </BreadcrumbList>
          </Breadcrumb>
        </div>

        <div id="hero-content" class="relative z-10 w-full min-h-[400px] md:min-h-[710px] flex flex-col md:block">
          {/* Left Content */}
          <div 
            id="hero-text-left" 
            class="relative z-20 mt-16 px-4 md:px-0 md:mt-0"
          >
            <h1 class="text-left text-white font-sans">
              <span class="block md:absolute md:top-[107px] md:left-[53px] md:w-[404px] md:h-[116px] md:text-[70px] md:font-bold md:leading-[1.34] text-[38px] font-black leading-[1.2]">
                Không gian
              </span>
              <br class="md:hidden" />
              <span class="text-[#FFC224] inline-block md:absolute md:top-[194px] md:left-[53px] md:w-auto whitespace-nowrap md:h-[116px] md:text-[78px] md:font-bold md:leading-[1.34] text-[38px] font-black leading-[1.2]">
                học tập tích hợp
              </span>
              <br class="md:hidden" />
              <span class="uppercase inline-block mt-4 md:absolute md:top-[310px] md:left-[53px] text-[38px] md:text-[86px] font-black md:leading-[1.34] leading-[1.2]">THẾ HỆ MỚI</span>
            </h1>
          </div>

          {/* Right Image */}
          <div 
            id="hero-image-right"
            class="relative z-10 mt-10 flex justify-center md:absolute md:-bottom-10 md:left-[517px] md:w-[931px] md:h-[715px] md:mt-0 pointer-events-none"
          >
            {/* Sparkle details memory: bg-white rounded-full */}
            <Image
              src={bannerGioiThieu}
              alt={'Banner Học Bá'}
              densities={[1, 2]}
              quality={95}
              class="hidden md:block w-full h-full object-contain object-bottom"
            />
            <Image
              src={bannerGioiThieuMobile}
              alt={'Banner Học Bá Mobile'}
              densities={[1, 2]}
              quality={95}
              class="md:hidden w-[358px] h-[305px] object-contain mt-[10px]"
            />
          </div>
          
          {/* Features / Icons */}
          <div id="hero-features" class="relative z-20 mt-8 mb-10 px-4 flex flex-col gap-5 md:gap-0 md:justify-between md:absolute md:top-[474px] md:left-[72px] md:w-[284px] md:h-[157px] md:mt-0 md:mb-0 md:px-0 text-white">
            <div class="flex items-center gap-4 max-md:[animation:none_!important] md:animate-in md:fade-in md:zoom-in-95 md:slide-in-from-bottom-6 md:fill-mode-both" style="animation-duration: 5s; animation-delay: 200ms; animation-iteration-count: infinite; animation-direction: alternate;">
              {/* Icon 1 */}
              <div class="flex size-10 flex-shrink-0 items-center justify-center rounded-full border border-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5">
                  <path d="M2 10v6M2 10l10-5 10 5-10 5z" />
                  <path d="M6 12v5c3 3 9 3 12 0v-5" />
                </svg>
              </div>
              <span class="text-sm font-bold uppercase md:text-base">GIÁO VIÊN DẪN DẮT</span>
            </div>
            <div class="flex items-center gap-4 max-md:[animation:none_!important] md:animate-in md:fade-in md:zoom-in-95 md:slide-in-from-bottom-6 md:fill-mode-both" style="animation-duration: 5s; animation-delay: 500ms; animation-iteration-count: infinite; animation-direction: alternate;">
              {/* Icon 2 */}
              <div class="flex size-10 flex-shrink-0 items-center justify-center rounded-full border border-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5">
                  <path d="M9 18h5" />
                  <path d="M10 21h3" />
                  <path d="M14 14.5c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5 0-.8-.2-1.5-.5-2.2" />
                  <path d="M12 4c-3.3 0-6 2.7-6 6 0 1.5.5 2.8 1.5 3.7.8.8 1.3 1.5 1.5 2.8" />
                  <path d="M18 4 c0 2.5 1.5 4 4 4 -2.5 0 -4 1.5 -4 4 0 -2.5 -1.5 -4 -4 -4 2.5 0 4 -1.5 4 -4z" fill="currentColor" stroke="none" />
                </svg>
              </div>
              <span class="text-sm font-bold uppercase md:text-base">CÔNG NGHỆ TỐI ƯU</span>
            </div>
            <div class="flex items-center gap-4 max-md:[animation:none_!important] md:animate-in md:fade-in md:zoom-in-95 md:slide-in-from-bottom-6 md:fill-mode-both" style="animation-duration: 5s; animation-delay: 800ms; animation-iteration-count: infinite; animation-direction: alternate;">
              {/* Icon 3 */}
              <div class="flex size-10 flex-shrink-0 items-center justify-center rounded-full border border-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5">
                  <path d="M4 4v16h16" />
                  <path d="M8 12 l 5 3 l 6 -7" />
                  <circle cx="8" cy="12" r="1.5" fill="currentColor" stroke="none" />
                  <circle cx="13" cy="15" r="1.5" fill="currentColor" stroke="none" />
                  <circle cx="19" cy="8" r="1.5" fill="currentColor" stroke="none" />
                </svg>
              </div>
              <span class="text-sm font-bold uppercase md:text-base">DỮ LIỆU THỰC TẾ</span>
            </div>
          </div>
        </div>
    </section>

    <section id="history-section" class="w-full relative bg-white pt-10 xl:pt-0 pb-10 md:pb-[100px] overflow-x-clip">
      <div class="relative mx-auto w-full max-w-[1440px] px-4 xl:pl-10 xl:pr-0 2xl:px-0">
        <div 
          id="history-header"
          class="relative flex items-center justify-center gap-[12px] py-4 xl:py-0 xl:absolute xl:-top-[120px] xl:left-1/2 xl:-translate-x-1/2 xl:w-[790px] xl:h-[106px] z-20"
        >
          <AnimatedArrow
            fromColor="#FFA500"
            toColor="#072899"
            stopOffset="0.2"
            className="absolute -top-2 left-0 md:top-0 md:left-0 size-4 md:size-8"
            client:load
          />
          <h2 class="text-[#072899] font-black uppercase text-center text-lg md:text-[42px] md:leading-[64px]">CÂU CHUYỆN VỀ THE IELTS SPACE</h2>
          <Image src={imgRocketGioiThieu} alt="Rocket" class="h-6 w-auto md:h-12 object-contain" densities={[1, 2]} quality={95} />
          <VectorArrow
            fromColor="#FFA500"
            toColor="#072899"
            stopOffset="0.2"
            className="absolute -bottom-2 right-0 md:bottom-0 md:right-0 size-4 md:size-8 rotate-180"
          />
        </div>
        
        <div id="history-content" class="flex flex-col xl:flex-row justify-between items-start gap-4 md:gap-[40px] xl:gap-[4%] w-full mt-4 md:mt-[40px] xl:mt-[150px] relative z-10">
          <div id="history-text-left" class="w-full xl:w-[52%] flex flex-col shrink-0">
            <ButtonTitle 
              title="Lịch sử hình thành" 
              icon={CustomHomeIcon} 
              className="mt-2 md:mt-0 w-max md:w-[275px] px-5 md:px-[13px] h-[60px] gap-[10px] rounded-[20px] border py-[18px] z-10" 
            />
