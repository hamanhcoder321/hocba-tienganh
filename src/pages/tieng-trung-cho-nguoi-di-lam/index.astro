const handleOptimizeImage = async (
  image: ImageMetadata,
  option?: {
    width?: number;
    height?: number;
  },
) => {
  const img = await getImage({
    src: image,
    width: option?.width || 691,
    height: option?.height || 411,
    format: 'webp',
    densities: [1, 2],
    quality: 95,
  });
  return img.src;
};

