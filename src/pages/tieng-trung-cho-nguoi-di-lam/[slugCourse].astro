---
import {
  CourseDetailsContentNew,
  CourseDetailsDocumentNew,
  CourseDetailsTarget,
  CourseDetailsWho,
  PlaySolidIcon,
  ChineseHeroBgCorner1,
  ChineseHeroBgCorner2,
  HskHeroBgCorner1Mobile,
  CourseDetailsBullet,
  CourseDetailsCheck,
  PrivilegeLightning,
  PrivilegeShieldCheck,
  PrivilegeAiStar,
  PrivilegeGift,
  PrivilegeHeart,
} from '@/components/common/icons';
import JsonLd from '@/components/common/JsonLd.astro';
import { formatDescription, formatTargets } from '@/lib/utils';
import SimpleFormRegister from '@/components/common/SimpleFormRegister.astro';
import ScheduleTableNew from '@/components/features/schedule/ScheduleTableNew';
import LecturerShowcase from '@/components/features/lecturer/LecturerShowcase';
import CourseRegistrationForm from '@/components/features/course/CourseRegistrationForm';
import CourseSectionAccordion from '@/components/features/course/CourseSectionAccordion';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HOME_CATEGORIES } from '@/lib/constants/content';
import { CATEGORY_TYPES } from '@/lib/constants/enums';
import { IMAGES } from '@/lib/constants/images';
import { fetchClassesList, fetchCourseDetail, fetchTeacherList, fetchCourseListHeader } from '@/lib/static-data';
import { CalendarCheck, Clock, MonitorSmartphone } from 'lucide-react';
import type { Graph } from 'schema-dts';
import type { TClasses } from '@/types/schedule';

const { slugCourse } = Astro.params;

// Fetch course detail by slug
const course = await fetchCourseDetail(slugCourse || '');

if (!slugCourse || !course) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
  return Astro.rewrite('/404');
}

const baseUrl = import.meta.env.PUBLIC_CLIENT_URL ?? 'https://hoc-ba.edu.vn';
const url = `${baseUrl}/khoa-hoc-ielts/${course?.slug}`;

const title = course?.meta_title || `${course?.name} | Học Bá Education`;
const description = course?.meta_description || `Khoá học ${course?.name} tại Tiếng Trung Học Bá`;
const keywords =
  course && course?.meta_keyword
    ? course?.meta_keyword.split(',').map((k) => k.trim())
    : ['tiếng trung', 'HSK', course ? course.name : ''];

// Find theme color based on category
const themeColor =
  HOME_CATEGORIES.find((category) => category.id === CATEGORY_TYPES.TIENG_TRUNG_CHO_NGUOI_DI_LAM) || HOME_CATEGORIES[0]; // Default to HSK theme

// Get all courses in the same category using the header endpoint
let coursesInCategory: TCourse[] = [];
const headerCoursesData = await fetchCourseListHeader({
  page: 1,
  limit: 100,
});

if (headerCoursesData?.list) {
  const currentCategoryId = course?.category_id ?? CATEGORY_TYPES.TIENG_TRUNG_CHO_NGUOI_DI_LAM;
  coursesInCategory = (headerCoursesData.list as TCourse[]).filter(
    (item) => item.category_id === currentCategoryId
  );
}

const categoryName = themeColor.title || 'HSK';
const categoryLink = themeColor.link;
const isShortTitle = (course?.name || '').length < 20;

// Fetch teachers
let dataTeacher: TLecturer[] = [];
const teachersData = await fetchTeacherList({ page: 0, limit: 20 });

if (teachersData?.list) {
  dataTeacher = teachersData.list as TLecturer[];
}

// Fetch classes schedule
let classesSchedule: TResponsePagination<TClasses[]> | null = null;
const today = new Date();
const schedulesData = await fetchClassesList({
  limit: 10,
  page: 1,
  month: today.getMonth() + 1,
  year: today.getFullYear(),
  course_id: course?.id,
  start_date_order: 'asc',
});

if (schedulesData) {
  classesSchedule = schedulesData as TResponsePagination<TClasses[]>;
}

// Tối ưu hóa mảng giáo viên
const optimizedTeachers = dataTeacher.map((teacher) => {
  const rawAvatar = teacher?.avatar_url?.file_path || (typeof IMAGES.course?.profilePic === 'string' ? IMAGES.course?.profilePic : IMAGES.course?.profilePic?.src);

  const optimizedAlbum = Array.isArray(teacher.album_url)
    ? teacher.album_url.map((img) => img.file_path)
    : [];

  let highlights: TLecturer['teacherHighlights'] = [];
  try {
    if (teacher.qualification && Array.isArray(teacher.qualification) && teacher.qualification.length > 0) {
      highlights = teacher.qualification.map((q: TQualification, index: number) => ({
        id: index,
        teacher_id: 0,
        section: q.name || '',
        content: q.description || '',
      }));
    } else if (typeof teacher.qualification_info === 'string') {
      const info = JSON.parse(teacher.qualification_info) as { title: string }[];
      highlights = info.map((i: { title: string }, index: number) => ({
        id: index,
        teacher_id: 0,
        section: '',
        content: i.title,
      }));
    }
  } catch (e) {
    console.error('Error parsing teacher highlights:', e);
  }

  return {
    ...teacher,
    optimizedAvatar: rawAvatar,
    optimizedAlbum: optimizedAlbum,
    teacherHighlights: highlights,
  };
});

const imagesCourseTeacher = {
  profilePic: typeof IMAGES.course?.profilePic === 'string' ? IMAGES.course?.profilePic : IMAGES.course?.profilePic?.src,
};

// ==========================
// 3. JSON-LD (SEO)
// ==========================
const jsonLd: Graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Trang chủ',
          item: baseUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Khoá học Học Bá Chinese',
          item: `${baseUrl}/tieng-trung-cho-nguoi-di-lam`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: course?.name,
          item: `${baseUrl}/tieng-trung-cho-nguoi-di-lam/${course?.slug}`,
        },
      ],
    },
    {
      '@type': 'Course',
      name: `${course?.name}`,
      description: description,
      provider: {
        '@type': 'Organization',
        name: 'Học Bá Education',
        sameAs: baseUrl,
      },
    },
  ],
};

const formatCourseLabel = (name: string) => {
  return name.trim();
};

const formatCourseTitle = (name: string) => {
  return name.trim();
};

const normalizeCourseName = (name: string) =>
  name
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/đ/g, 'd')
    .replace(/Đ/g, 'D')
    .toLowerCase()
    .replace(/&/g, ' ')
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();

const chineseHeroImages: Record<string, (typeof IMAGES.khoaHsk)[keyof typeof IMAGES.khoaHsk]> = {
  'tieng trung giao tiep co ban': IMAGES.khoaHsk.heroChineseBasic,
  'tieng trung van phong cong so': IMAGES.khoaHsk.heroChineseOffice,
  'tieng trung thuong mai': IMAGES.khoaHsk.heroChineseCommerce,
  'tieng trung thuong mai chuyen sau': IMAGES.khoaHsk.heroChineseAdvancedCommerce,
  'tieng trung doanh nhan': IMAGES.khoaHsk.heroChineseBusiness,
  'tieng trung giao tiep doanh nhan': IMAGES.khoaHsk.heroChineseBusiness,
  'tieng trung cong xuong': IMAGES.khoaHsk.heroChineseFactory,
};

const courseHeroImage =
  chineseHeroImages[normalizeCourseName(course.name)] || IMAGES.khoaHsk.heroChineseBasic;
const courseHeroImageSrc = typeof courseHeroImage === 'string' ? courseHeroImage : courseHeroImage.src;
