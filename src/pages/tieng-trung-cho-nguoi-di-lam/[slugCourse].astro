  </div>

  <LecturerShowcase lecturers={optimizedTeachers} bgClass="bg-white" client:load />

  <ScheduleTableNew client:load courseId={course?.id as number} bgGradientClass="from-[#F3F3F3] to-[#FFFFFF]" />

  <SimpleFormRegister dataInput={`Khóa học ${course?.name}`} isSimpleForm />
</BaseLayout>

<script define:vars={{ categoryTitle: themeColor.title }}>
  // Save category to localStorage when breadcrumb link is clicked
  document.addEventListener('DOMContentLoaded', () => {
    const breadcrumbLinks = document.querySelectorAll('.breadcrumb-category-link');
    breadcrumbLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (categoryTitle) {
          localStorage.setItem('selectedCategory', categoryTitle);
        }
      });
    });
  });
</script>

