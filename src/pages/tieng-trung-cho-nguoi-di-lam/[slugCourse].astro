  @keyframes pulse-outline {
    0%,
    100% {
      box-shadow: 3px 4px 30px rgba(243, 198, 80, 0);
    }
    50% {
      box-shadow: 3px 4px 30px rgba(243, 198, 80, 0.6);
    }
  }
  @keyframes pulse-left {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 0.85;
    }
  }

  /* Custom thin gray scrollbar for mobile */
  .custom-mobile-scrollbar::-webkit-scrollbar {
    height: 3px;
  }
  .custom-mobile-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-mobile-scrollbar::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 10px;
    border-left: 90px solid transparent;
    border-right: 90px solid transparent;
