---
import { ArrowIcon, EllipContact, EllipContact2 } from '@/components/common/icons';
import ContactAdvisorRegistrationForm from '@/components/features/contact/ContactAdvisorRegistrationForm';
import { IMAGES } from '@/lib/constants/images';
import { cn } from '@/lib/utils';
import { getImage, Image } from 'astro:assets';

const optimizedNoteBook = await getImage({
  width: 80,
  height: 80,
  densities: [1, 2],
  src: IMAGES.contact.noteBook,
  format: 'webp',
});

const { dataInput, isSimpleForm, id = 'simple-register-form' } = Astro.props;
---

<section
  id={id}
  class={cn(
    'w-full overflow-hidden bg-gradient-to-l from-[#B90E0A] to-[#7D1900] h-auto',
    isSimpleForm ? 'md:h-[660px]' : 'md:h-[842px]',
  )}
>
  <div class="mx-auto w-full max-w-[1354px]">
    <div class="flex items-start pt-10">
      <Image
        src={IMAGES.contact.iconBook}
        width={90}
        height={90}
        alt={'icon-book'}
        densities={[1, 2]}
        class={'object-cover w-[50px] md:w-[90px] h-auto'}
      />
      <div class="relative flex flex-col gap-2 md:gap-4">
        <div
          class="flex h-8 w-fit items-center text-nowrap rounded bg-gradient-to-r from-[#B90E0A] to-[#F3C650] px-2 text-base font-bold uppercase text-white md:h-[58px] md:rounded-lg md:px-[13px] md:text-[32px]"
        >
          Học tiếng trung từ người giỏi nhất
        </div>
        <h2 class="text-lg font-black uppercase text-white md:text-[42px]">Đăng ký tư vấn ngay!</h2>
        <div class="absolute bottom-0 right-[30px] md:-bottom-2 md:right-[68px]">
          <ArrowIcon />
        </div>
      </div>
    </div>
    <div class="grid grid-cols-1 px-4 py-8 md:grid-cols-2 md:py-0">
      <div class="order-2 col-span-1 md:order-1">
        <div
          class="relative mx-auto mt-16 flex h-auto w-full items-center justify-center md:mt-4 md:h-[571px] md:w-[571px]"
        >
          <div class="absolute -top-10 left-1/2 size-[212px] -translate-x-1/2 md:left-1/2 md:top-0 md:size-[571px]">
            <EllipContact className="absolute left-0 top-0 z-10 size-[212px] opacity-30 md:size-[571px]" />
            <EllipContact2
              className="absolute left-1/2 top-1/2 z-20 size-[128px] -translate-x-1/2 -translate-y-1/2 opacity-20 md:size-[342px]"
            />
          </div>
          <div class="relative z-50 ml-16 flex items-center justify-center">
            <Image
              src={IMAGES.contact.btcContact}
              width={160}
              height={137}
              alt={'btcContact'}
              densities={[1, 2]}
              class={'icon-bct object-cover w-auto h-[80px] md:h-[137px] absolute top-8 -left-[27%] z-30 -rotate-12'}
            />
            <Image
              src={IMAGES.contact.cuContact}
              width={377}
              height={320}
              alt={'cuContact'}
              densities={[1, 2]}
              class={'icon-cu object-cover h-auto w-[216px] md:w-[377px] z-50'}
            />
            <Image
              src={IMAGES.contact.hskContact}
              width={90}
              height={70}
              alt={'hskContact'}
              densities={[1, 2]}
              class={'icon-hsk object-cover w-auto h-10 md:h-[70px] absolute bottom-[39%] -right-[17px] rotate-12'}
            />
          </div>
        </div>
      </div>
      <div class="order-1 col-span-1 md:order-2">
        <ContactAdvisorRegistrationForm
          icons={{ noteBook: optimizedNoteBook.src }}
          client:idle
          {dataInput}
          {isSimpleForm}
        />
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes moveBCT {
    0%,
    16.67% {
      top: 2rem;
      left: -27%;
      height: 80px;
      transform: rotate(-12deg);
    }
    25%,
    58.33% {
      top: 4.5rem;
      left: -30%;
      height: 56px;
      transform: rotate(0deg);
    }
    66.67%,
    100% {
      top: 2rem;
      left: -27%;
      height: 80px;
      transform: rotate(-12deg);
    }
  }

  @keyframes moveHSK {
    0%,
    16.67% {
      bottom: 39%;
      right: 0;
      height: 2.5rem;
      transform: rotate(12deg);
    }
    25%,
    58.33% {
      bottom: 56%;
      right: 17px;
      height: 56px;
      transform: rotate(0deg);
    }
    66.67%,
    100% {
      bottom: 39%;
      right: 0;
      height: 2.5rem;
      transform: rotate(12deg);
    }
  }

  @keyframes moveCU {
    0%,
    16.67%,
    66.67%,
    100% {
      transform: translateX(0);
    }
    25%,
    58.33% {
      transform: translateX(-1.5rem);
    }
  }

  @media (min-width: 768px) {
    @keyframes moveBCT {
      0%,
      16.67% {
        top: 2rem;
        left: -27%;
        height: 137px;
        transform: rotate(-12deg);
      }
      25%,
      58.33% {
        top: 9rem;
        left: -24%;
        height: 84px;
        transform: rotate(0deg);
      }
      66.67%,
      100% {
        top: 2rem;
        left: -27%;
        height: 137px;
        transform: rotate(-12deg);
      }
    }

    @keyframes moveHSK {
      0%,
      16.67% {
        bottom: 39%;
        right: -12px;
        height: 70px;
        transform: rotate(12deg);
      }
      25%,
      58.33% {
        bottom: 56%;
        right: 17px;
        height: 100px;
        transform: rotate(-12deg);
      }
      66.67%,
      100% {
        bottom: 39%;
        right: -12px;
        height: 70px;
        transform: rotate(12deg);
      }
    }

    @keyframes moveCU {
      0%,
      16.67%,
      66.67%,
      100% {
        transform: translateX(0);
      }
      25%,
      58.33% {
        transform: translateX(-2.5rem);
      }
    }
  }

  .icon-bct {
    animation: moveBCT 12s ease-in-out 3s infinite;
  }

  .icon-hsk {
    animation: moveHSK 12s ease-in-out 3s infinite;
  }

  .icon-cu {
    animation: moveCU 12s ease-in-out 3s infinite;
  }
</style>
