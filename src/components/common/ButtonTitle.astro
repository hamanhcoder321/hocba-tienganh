---
interface Props {
  title: string;
  icon?: any;
  className?: string;
  iconClassName?: string;
  textClassName?: string;
}

const { title, icon: Icon, className = '', iconClassName = 'size-4 md:size-6', textClassName = 'text-base font-medium md:text-2xl' } = Astro.props;
---

<div
  class:list={[
    'flex h-[30px] w-fit items-center gap-[5px] rounded-[10px] border-[0.5px] border-black px-[6.5px] md:h-[60px] md:gap-4 md:rounded-[20px] md:border md:px-5',
    className,
  ]}
>
  {Icon && <Icon className={iconClassName} />}
  <h2 class:list={[textClassName, "whitespace-nowrap"]}>{title}</h2>
</div>
