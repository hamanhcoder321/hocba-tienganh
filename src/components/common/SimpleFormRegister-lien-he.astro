---
import { ArrowIcon, EllipContact, EllipContact2 } from '@/components/common/icons';
import ContactAdvisorRegistrationForm from '@/components/features/contact/ContactAdvisorRegistrationForm-lien-he';
import { IMAGES } from '@/lib/constants/images';
import { cn } from '@/lib/utils';
import { getImage, Image } from 'astro:assets';

import cugaDangky from '@/assets/images/img-hocba-tienganh-optimized/img-cuga-dangky.webp';

const optimizedNoteBook = await getImage({
  width: 80,
  height: 80,
  densities: [1, 2],
  src: IMAGES.contact.noteBook,
  format: 'webp',
});

const { dataInput, isSimpleForm, id = 'simple-register-form', defaultObjective = '' } = Astro.props;
---

<section
  {id}
  class={cn(
    'w-full overflow-hidden bg-[linear-gradient(180deg,#04195C,#052284,#072899,#083AD4)] h-auto',
    isSimpleForm ? 'md:py-8' : 'md:py-16',
  )}
>
  <div class="mx-auto w-full max-w-[1354px]">
    <div
      class="relative flex flex-col items-center justify-center gap-2 px-4 pt-8 md:items-start md:gap-4 md:pl-[40px]"
    >
      <Image
        src={IMAGES.contact.iconBook}
        width={90}
        height={90}
        alt={'icon-book'}
        densities={[1, 2]}
        class={'absolute left-0 top-7 z-20 hidden h-auto w-[55px] object-cover drop-shadow-xl md:top-5 md:block md:w-[100px] -scale-x-100'}
      />
      <div
        class="relative z-10 flex w-full flex-col items-center justify-center gap-2 md:w-max md:items-start md:gap-4 md:pl-[60px]"
      >
        <div class="relative flex items-center">
          <svg class="absolute -left-6 h-4 w-4 text-[#A8C7FA] md:hidden" viewBox="0 0 24 24" fill="currentColor"
            ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
          >
          <div
            class="relative z-0 flex h-8 w-fit items-center justify-center text-nowrap rounded-full bg-gradient-to-r from-[#FFFFFF] via-[#EEF4FF] to-[#DCE8FF] px-6 text-[13px] font-bold capitalize text-[#052284] shadow-md sm:text-[14px] md:h-[58px] md:w-[591px] md:gap-[10px] md:rounded-[8px] md:px-[13px] md:py-[18px] md:text-[32px] md:leading-none md:tracking-normal"
          >
            EVERYTHING YOU NEED IN ONE SPACE
          </div>
        </div>
        <h2
          class="relative z-10 flex items-center gap-2 text-center text-[22px] font-black uppercase text-white drop-shadow-md md:text-left md:text-[42px]"
        >
          ĐĂNG KÝ TƯ VẤN NGAY!
          <svg class="h-5 w-5 text-[#FF7A00] md:hidden" viewBox="0 0 24 24" fill="currentColor"
            ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
          >
        </h2>
        <div class="absolute -right-[30px] bottom-0 z-10 hidden sm:block md:-bottom-2 md:-right-[80px]"></div>
      </div>
    </div>
    <div class="grid grid-cols-1 items-center px-4 py-8 md:grid-cols-2 md:gap-8 md:py-0">
      <div class="order-1 col-span-1 hidden md:block">
        <div
          class="relative mx-auto mt-16 flex h-auto w-full items-center justify-center md:mt-4 md:h-[571px] md:w-[571px]"
        >
          <div class="relative z-50 flex w-full items-center justify-center">
            <Image
              src={cugaDangky}
              width={700}
              height={700}
              alt={'cuContact'}
              densities={[1, 2]}
              class={'z-50 h-auto w-[280px] object-contain md:w-[540px] drop-shadow-[0px_20px_20px_rgba(0,0,0,0.5)]'}
            />

            {/* 1. Left Orange Star */}
            <svg
              class="absolute left-[5%] top-[38%] z-20 h-4 w-4 text-[#FF7A00] md:left-[0%] md:h-6 md:w-6"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
            >

            {/* 2. Top-Left White Star */}
            <svg
              class="absolute left-[20%] top-[20%] z-20 h-3 w-3 text-white opacity-80 md:left-[15%] md:h-5 md:w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
            >

            {/* 3. Bottom-Left White Star */}
            <svg
              class="absolute bottom-[7%] left-[24%] z-20 h-3 w-3 text-white opacity-80 md:left-[16%] md:h-5 md:w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
            >

            {/* 4. Top-Right Orange Star */}
            <svg
              class="absolute right-[25%] top-[10%] z-20 h-2 w-2 text-[#FF7A00] md:right-[20%] md:h-4 md:w-4"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
            >

            {/* 5. Mid-Right Orange Star */}
            <svg
              class="absolute right-[25%] top-[34%] z-20 h-2 w-2 text-[#FF7A00] md:right-[20%] md:h-4 md:w-4"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
            >

            {/* 6. Far-Right White Star */}
            <svg
              class="absolute right-[5%] top-[40%] z-20 h-4 w-4 text-white opacity-90 md:right-[2%] md:h-6 md:w-6"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
            >

            {/* 7. Tiny White Star (mid-right) */}
            <svg
              class="absolute right-[26%] top-[48%] z-20 h-2 w-2 text-white opacity-60 md:right-[22%] md:h-3 md:w-3"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
            >
          </div>
        </div>
      </div>
      <div class="order-2 col-span-1">
        <ContactAdvisorRegistrationForm
          icons={{ noteBook: optimizedNoteBook.src }}
          client:idle
          {dataInput}
          {isSimpleForm}
        >
          <div class="relative mx-auto mb-4 mt-8 flex h-auto w-full items-center justify-center md:hidden">
            <div class="relative z-50 flex w-full items-center justify-center">
              <Image
                src={cugaDangky}
                width={700}
                height={700}
                alt={'cuContact'}
                densities={[1, 2]}
                class={'z-50 h-auto w-[280px] object-contain'}
              />
              <svg
                class="absolute left-[5%] top-[20%] z-20 h-5 w-5 text-[#FF7A00]"
                viewBox="0 0 24 24"
                fill="currentColor"
                ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
              >
              <svg
                class="absolute right-[5%] top-[35%] z-20 h-4 w-4 text-white opacity-90"
                viewBox="0 0 24 24"
                fill="currentColor"
                ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
              >
              <svg
                class="absolute bottom-[20%] left-[10%] z-20 h-4 w-4 text-white opacity-70"
                viewBox="0 0 24 24"
                fill="currentColor"
                ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
              >
              <svg
                class="absolute bottom-[10%] right-[10%] z-20 h-3 w-3 text-[#FF7A00]"
                viewBox="0 0 24 24"
                fill="currentColor"
                ><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z"></path></svg
              >
            </div>
          </div>
        </ContactAdvisorRegistrationForm>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes moveBCT {
    0%,
    16.67% {
      top: 2rem;
      left: -27%;
      height: 80px;
      transform: rotate(-12deg);
    }
    25%,
    58.33% {
      top: 4.5rem;
      left: -30%;
      height: 56px;
      transform: rotate(0deg);
    }
    66.67%,
    100% {
      top: 2rem;
      left: -27%;
      height: 80px;
      transform: rotate(-12deg);
    }
  }

  @keyframes moveHSK {
    0%,
    16.67% {
      bottom: 39%;
      right: 0;
      height: 2.5rem;
      transform: rotate(12deg);
    }
    25%,
    58.33% {
      bottom: 56%;
      right: 17px;
      height: 56px;
      transform: rotate(0deg);
    }
    66.67%,
    100% {
      bottom: 39%;
      right: 0;
      height: 2.5rem;
      transform: rotate(12deg);
    }
  }

  @keyframes moveCU {
    0%,
    16.67%,
    66.67%,
    100% {
      transform: translateX(0);
    }
    25%,
    58.33% {
      transform: translateX(-1.5rem);
    }
  }

  @media (min-width: 768px) {
    @keyframes moveBCT {
      0%,
      16.67% {
        top: 2rem;
        left: -27%;
        height: 137px;
        transform: rotate(-12deg);
      }
      25%,
      58.33% {
        top: 9rem;
        left: -24%;
        height: 84px;
        transform: rotate(0deg);
      }
      66.67%,
      100% {
        top: 2rem;
        left: -27%;
        height: 137px;
        transform: rotate(-12deg);
      }
    }

    @keyframes moveHSK {
      0%,
      16.67% {
        bottom: 39%;
        right: -12px;
        height: 70px;
        transform: rotate(12deg);
      }
      25%,
      58.33% {
        bottom: 56%;
        right: 17px;
        height: 100px;
        transform: rotate(-12deg);
      }
      66.67%,
      100% {
        bottom: 39%;
        right: -12px;
        height: 70px;
        transform: rotate(12deg);
      }
    }

    @keyframes moveCU {
      0%,
      16.67%,
      66.67%,
      100% {
        transform: translateX(0);
      }
      25%,
      58.33% {
        transform: translateX(-2.5rem);
      }
    }
  }

  .icon-bct {
    animation: moveBCT 12s ease-in-out 3s infinite;
  }

  .icon-hsk {
    animation: moveHSK 12s ease-in-out 3s infinite;
  }

  .icon-cu {
    animation: moveCU 12s ease-in-out 3s infinite;
  }
</style>
