---
import { Image } from 'astro:assets';
import { IMAGES } from '@/lib/constants/images';
import VideoStudentSlide from '@/components/features/course/hsk/VideoStudentSlide';

const videoStudentSlides = [
  {
    id: 1,
    videoUrl: 'https://www.youtube.com/shorts/_1k6jp1R6Rg',
    thumbnail: IMAGES.studentAchievements.hvdcNgocHang.src,
  },
  {
    id: 2,
    videoUrl: 'https://www.youtube.com/shorts/7TN4UYl5qtg',
    thumbnail: IMAGES.studentAchievements.hvdcTienVu.src,
  },
  {
    id: 3,
    videoUrl: 'https://www.youtube.com/shorts/r0AvMPQaSHE',
    thumbnail: IMAGES.studentAchievements.hvdcMaiMai.src,
  },
  // {
  //   id: 4,
  //   videoUrl: 'https://www.youtube.com/shorts/Y87HUHQNSA0',
  //   thumbnail: IMAGES.studentAchievements.hvdcNgocHang.src,
  // },
  // {
  //   id: 5,
  //   videoUrl: 'https://www.youtube.com/embed/MAnASob52M0',
  //   thumbnail: IMAGES.studentAchievements.hvdcTienVu.src,
  // },
  // {
  //   id: 6,
  //   videoUrl: 'https://www.youtube.com/shorts/MAnASob52M0',
  //   thumbnail: IMAGES.studentAchievements.hvdcMaiMai.src,
  // },
];

// Hàm hỗ trợ tự động trích xuất ID video từ link ytb/Shorts và trả về link ảnh bìa (thumbnail) mặc định của YouTube.
function getYouTubeThumbnail(url: string) {
  const regExp = /^.*(youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=|shorts\/)([^#\&\?]*).*/;
  const match = url.match(regExp);
  if (match && match[2].length === 11) {
    return `https://img.youtube.com/vi/${match[2]}/hqdefault.jpg`;
  }
  return null;
}

// Lặp qua mảng video hiện tại và thay thế ảnh thumbnail cũ bằng ảnh lấy tự động từ YouTube.
// Nếu link không hợp lệ hoặc lỗi, nó sẽ giữ nguyên ảnh cũ (fallback).
const processedSlides = videoStudentSlides.map(slide => ({
  ...slide,
  thumbnail: getYouTubeThumbnail(slide.videoUrl) || slide.thumbnail
}));
---

<section
  class="relative mx-auto mb-0 flex w-full max-w-[1920px] flex-col justify-start overflow-hidden bg-gradient-to-b from-[#7A97F8]/20 to-[#FFFFFF] pb-0 pt-6 md:h-[779px] md:py-0 md:pb-10 md:pt-[50px]"
>
  <div class="container relative z-10 mx-auto px-4 lg:px-10 xl:max-w-[1280px] 2xl:max-w-[1600px]">
    <div
      class="relative mx-auto flex w-full max-w-full flex-col items-center text-center md:mt-[6.91px] md:h-[80px] md:w-[540px] lg:w-[640px] xl:w-[778.98px] xl:max-w-none"
    >
      <div class="relative">
        <h2
          class="mx-auto w-[321.52px] text-center font-gilroy text-[18px] font-[1000] font-black uppercase leading-[26.9px] text-[#052284] md:mt-[-30px] md:w-full md:text-[32px] md:leading-[48px] lg:text-[38px] lg:leading-[54px] xl:text-[42px] xl:leading-[64px]"
        >
          HỌC VIÊN NÓI GÌ VỀ THE IELTS SPACE?
        </h2>
      </div>
      <p
        class="mx-auto mt-0 w-full px-[16px] text-center font-gilroy text-[12px] font-[700] leading-[14.4px] text-[#373737] md:mt-2 md:w-auto md:px-0 md:text-[18px] md:leading-[22px] lg:h-[48px] lg:w-auto lg:text-[20px] lg:leading-[24px] xl:h-[52px] xl:w-auto xl:text-[22px] xl:leading-[26.4px]"
      >
        Cùng “tận mắt” nghe Học viên nói về hành trình<br class="hidden md:block" /> chinh phục tiếng Anh cùng The IELTS Space
      </p>
    </div>

    <div class="-mx-4 mt-[-20px] md:mx-auto md:mt-[16px] md:max-w-[1028px]">
      <VideoStudentSlide slides={processedSlides} client:visible />
    </div>
  </div>
</section>
