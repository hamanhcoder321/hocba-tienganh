---

<section class="relative overflow-hidden bg-white pb-10 pt-0 md:-mt-8 lg:-mt-8 xl:-mt-12 2xl:-mt-8 3xl:-mt-8">
  {/* Background Patterns */}
  <div
    class="absolute left-[-43px] top-[23px] z-0 h-[138px] w-[138px] opacity-80 md:left-[-8%] md:top-[10%] md:h-[280px] md:w-[280px] lg:left-[-12%] lg:h-[397px] lg:w-[397px] xl:left-[-2%] 2xl:left-[0%] 3xl:left-[8%]"
  >
    <img src={IMAGES.khoaChinese.gridRedChinese.src} alt="" class="h-full w-full object-contain" />
  </div>
  <div
    class="absolute left-[255px] top-[673px] z-0 h-[187px] w-[186px] opacity-80 md:bottom-[2%] md:left-auto md:right-[-9%] md:top-auto md:h-[280px] md:w-[280px] lg:bottom-[2%] lg:right-[-8%] lg:h-[362px] lg:w-[362px] xl:right-[-6%] 2xl:right-[0%] 3xl:right-[9%]"
  >
    <img src={IMAGES.khoaChinese.gridRedChinese.src} alt="" class="h-full w-full object-contain" />
  </div>

  <div
    class="container relative z-10 mx-auto px-2 md:max-w-[710px] md:px-0 lg:max-w-[984px] lg:px-0 xl:max-w-[1280px] 2xl:max-w-[1182px] 2xl:px-0 3xl:max-w-[1182px] 3xl:px-0"
  >
    {/* Title Section */}
    <div class="mb-[26px] flex flex-col items-center text-center md:mb-16">
      <div class="flex items-center justify-center gap-[9.17px] md:gap-3">
        <Image
          src={IMAGES.schedule.chatPencil}
          alt="Notebook Icon"
          width={75}
          height={75}
          class="h-[34.38px] w-[34.38px] object-contain md:h-[75px] md:w-[75px]"
        />
        <h2
          class="bg-gradient-to-r from-[#052284] to-[#052284] bg-clip-text font-gilroy text-[18px] font-[1000] uppercase leading-[29.33px] text-transparent md:text-[42px] md:leading-[64px]"
        >
          LẮNG NGHE CÁC SPACERS CHIA SẺ
        </h2>
      </div>
      <!-- <p
        class="mx-auto mt-[9.17px] max-w-[299px] text-center font-gilroy text-[12px] font-[700] not-italic leading-[1.2] text-[#000000] md:mt-4 md:max-w-[547px] md:text-[18px] md:font-[300] md:italic"
      >
        Tổng hợp những tâm tình của “Bá sinh”, từ cảm nhận về Học Bá Education, review sau mỗi kỳ thi đến những tip học
        tập hiệu quả – bản hoà ca niềm vui nhỏ bé mà Học Bá nâng niu mỗi ngày.
      </p> -->
    </div>

    <div class="w-full overflow-x-auto hide-scrollbar pb-8 -mx-2 px-2 md:mx-0 md:px-0 md:pb-0">
      <div
        id="testimonials-grid"
        class="mx-auto grid w-max grid-cols-2 gap-x-2 gap-y-3 px-2 md:w-fit md:max-w-none md:grid-cols-2 lg:grid-cols-2 xl:gap-x-6 2xl:gap-x-[32px] 2xl:gap-y-[35px] 3xl:gap-x-[40px] 3xl:gap-y-[35px] justify-center"
      >
        {testimonials.map((item, index) => (
          <div class={index >= 4 ? 'hidden testimonial-item' : 'testimonial-item'}>
            <StudentExperienceCard item={item} />
          </div>
        ))}
      </div>
    </div>

    <div class="relative mt-[-100px] flex h-[160px] items-end justify-center bg-gradient-to-t from-white via-white/80 to-transparent pb-4 md:mt-[-150px] md:h-[200px]" id="show-more-container">
      <button
        id="show-more-btn"
        class="flex h-[42px] w-[210px] items-center justify-center gap-[6px] rounded-full border-[1.5px] border-[#052284] bg-white font-gilroy text-[16px] font-[600] text-[#052284] shadow-[0px_4px_10px_rgba(5,34,132,0.15)] transition-colors duration-300 hover:bg-[#052284] hover:text-white"
      >
        Xem thêm đánh giá <span class="text-[18px] leading-none">&raquo;</span>
      </button>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const showMoreBtn = document.getElementById('show-more-btn');
    const showMoreContainer = document.getElementById('show-more-container');
    const hiddenItems = document.querySelectorAll('.testimonial-item.hidden');

    if (showMoreBtn && hiddenItems.length > 0) {
      showMoreBtn.addEventListener('click', () => {
        hiddenItems.forEach(item => {
          item.classList.remove('hidden');
          item.classList.add('animate-fade-in'); // optional fade in
        });
        if (showMoreContainer) {
          showMoreContainer.style.display = 'none';
        }
      });
    } else if (showMoreContainer) {
      showMoreContainer.style.display = 'none';
    }
  });
</script>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
