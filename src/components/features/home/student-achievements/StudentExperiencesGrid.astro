---
import { IMAGES } from '@/lib/constants/images';
import StudentExperienceCard from './StudentExperienceCard.astro';
import { Image } from 'astro:assets';

const testimonials = [
  {
    name: 'Minh Anh',
    role: 'Nhân viên văn phòng',
    location: 'Hà Nội',
    hskLevel: '7.5 IELTS',
    timeSpent: 'Tháng 10, 2025',
    content:
      'Mình biết không phải chỉ mình mình có 7.5 IELTS. Mình biết có rất nhiều người cùng được 7.5 IELTS ở The IELTS Space nên cũng chứng cớ gì để nói cả. Ai phân tích kha rõ mình đang yếu kỹ năng nào, dạng bài nào dễ mất điểm nhiều và có những lỗi bị lặp lại. Đặt đầu mình cứ ngồi đổ ngữ pháp nhưng hoá ra thứ kéo điểm xuống nhiều nhất lại là vốn từ vựng collocation :)) Mình đã nhờ AI lên kế hoạch tập cùng cho mentor bổ sung thêm bài luyện riêng. Sau 4 tháng mình đã từ 6.0 lên 7.0 overall',
    likes: 348,
    shares: 67,
    avatar: IMAGES.home.MinhAnh,
    hasOwlSticker: false,
  },
  {
    name: 'Thu Hà',
    role: 'Nhân viên đi làm',
    location: 'Hà Nội',
    hskLevel: '7.0 IELTS',
    timeSpent: 'Tháng 8, 2025',
    content:
      'Mình là dân đi làm nên thật sự không có thời gian ngày nào cứng để cày 3-4 tiếng như các bạn. Cái mình thích nhất ở The IELTS Space là không bắt học đàn trải. Ai phân tích kha rõ mình đang yếu kỹ năng nào, dạng bài nào dễ mất điểm nhiều và có những lỗi bị lặp lại. Đặt đầu mình cứ ngồi đổ ngữ pháp nhưng hoá ra thứ kéo điểm xuống nhiều nhất lại là vốn từ vựng collocation :)) Mình đã nhờ AI lên kế hoạch tập cùng cho mentor bổ sung thêm bài luyện riêng. Sau 4 tháng mình đã từ 6.0 lên 7.0 overall',
    likes: 289,
    shares: 54,
    avatar: IMAGES.home.ThuHa,
    hasOwlSticker: false,
  },
  {
    name: 'Thanh Huyền',
    role: 'Học sinh',
    location: 'Hà Nội',
    hskLevel: '7.5 IELTS',
    timeSpent: 'Tháng 10, 2025',
    content:
      'Em khá ngại học tiếng Anh vì nền tảng không tốt. Trước đi học chả hiểu cái gì, học trước quên sau, bạn cùng lớp thi cứ gia toy trả lời đảm rất áp lực :( Quản thầy nên hệ thống nhóm hạn rất nhiều nhưng giáo viên thích từ bản chất, tư duy chứ không bắt nhớ quá nhiều công thức, sau đó có bài luyện nền hệ thống lối lại, mày phân yêu thì được luyện thêm chứ không phải học lót tốt cứ tự đầu. Học trọng LMS rất xịn, hiện đại và nhiều game mode mình thấy chăm làm. Cũng cảm ơn thầy cô Hương mentor về chứa bao giờ cứu đủ em cũng ổn những câu hỏi về cùng ngào ngô :))) Hiện em đã đạt 5.5 và đang học tiếp aim 6.5',
    likes: 412,
    shares: 89,
    avatar: IMAGES.home.ThanhHuyen,
    hasOwlSticker: false,
  },
  {
    name: 'Nhật Quân',
    role: 'Học sinh',
    location: 'Quảng Ninh',
    hskLevel: '7.0 IELTS',
    timeSpent: 'Tháng 2, 2026',
    content:
      'Mình từng bị stuck 6.0 khá lâu và đã cày rất nhiều đề Cambridge nhưng điểm cứ lên không nhúc nhích. Vào học mới hiểu là năng band không phải cứ làm nhiều đề mà còn phải cải thiện tư duy, chiến lược làm bài, phát triển bài nữa. Phải biết lỗi thường ở những phần nào, do tư duy hay ghi nhớ, do từ vựng hay ngữ pháp đặc biệt cần cải thiện. Cảm ơn thầy Minh vì đã thay đổi hoàn toàn cách mình học Reading và Writing. Sau 4 tháng mình đạt 7.5 kịp nộp hồ sơ du học, nhờ có người ti thì đi ✈',
