---
import { Image } from 'astro:assets';
import { StarReviewIcon, ShareReviewIcon, HeartIcon, LikeIcon } from '@/components/common/icons';

interface Props {
  item: {
    name: string;
    role: string;
    location: string;
    rating: number;
    hskLevel: string;
    timeSpent: string;
    content: string;
    likes: number;
    shares: number;
    avatar: ImageMetadata;
    hasOwlSticker?: boolean;
  };
}

const { item } = Astro.props;
---

<div
  class="experience-card relative mx-auto flex h-[207.55px] w-[168px] cursor-pointer flex-col justify-start gap-y-[6px] rounded-[11.65px] border-[0.49px] border-[#D9D9D9] bg-[#F4F4F4] px-[8.25px] pb-[16.51px] pt-[16.51px] shadow-[6px_6px_20px_0px_rgba(0,0,0,0.02)] md:h-[431.4px] md:w-[335px] md:cursor-default md:gap-y-[8px] md:rounded-[24px] md:border md:px-[17px] md:pb-[34px] md:pt-[34px] lg:w-[312px] xl:w-[348.4px]"
>
  {/* Top row */}
  <div class="mb-[6px] flex items-start justify-between md:mb-[6px]">
    <div class="flex items-start gap-4 md:gap-3">
      <div
        class="relative h-[43.7px] w-[43.7px] flex-shrink-0 rounded-full shadow-[0px_1.64px_41.03px_0px_rgba(0,0,0,0.1)] md:h-[90px] md:w-[90px] md:shadow-[0px_3.38px_84.5px_0px_rgba(0,0,0,0.1)]"
      >
        <Image
          src={item.avatar}
          width={150}
          height={150}
          alt={item.name}
          class="h-full w-full rounded-full border-[1.23px] border-white object-cover md:border-[2.54px]"
        />
      </div>
      <div>
        <h3
          class="mt-[1.5px] whitespace-nowrap font-gilroy text-[10px] font-[900] leading-none text-[#AF0000] md:mt-0 md:text-[18px] lg:text-[17px] xl:text-[22px]"
        >
          {item.name}
        </h3>
        <p
          class="mt-[8px] font-gilroy text-[8px] font-[500] leading-none text-[#000000] md:mt-[8px] md:text-[14px] md:leading-[1.3] lg:text-[13px] xl:mt-[12px] xl:text-[18px] xl:leading-none"
        >
          {item.role}, {item.location}
        </p>

        {/* 5 Stars */}
        <div class="mt-[8px] flex items-center gap-[2.33px] md:mt-[14px] md:gap-0.5">
          {
            [...Array(5)].map(() => (
              <StarReviewIcon className="h-[6.11px] w-[6.39px] fill-[#F3C650] text-[#F3C650] md:h-3.5 md:w-3.5" />
            ))
          }
        </div>
      </div>
    </div>

    {/* Share action */}
    <div class="flex translate-x-[2px] items-center gap-[2.91px] text-[#373737] md:translate-x-0 md:gap-1.5">
      <ShareReviewIcon
        className="h-[13px] w-[13px] -translate-y-[10px] md:h-[27px] md:w-[27px] md:-translate-y-[12px]"
      />
      <span
        class="-translate-y-[10.5px] font-gilroy text-[6.26px] font-[400] leading-none md:-translate-y-[13px] md:text-[12.91px]"
      >
        {item.shares}
      </span>
    </div>
  </div>

  {/* Review content */}
  <p
    class="md:custom-scrollbar box-content h-[97px] w-full flex-shrink-0 overflow-hidden text-justify font-gilroy text-[6.8px] font-[500] italic leading-[12.42px] text-[#504E4E] md:h-[200px] md:w-[291px] md:overflow-y-auto md:pr-3 md:text-[14px] md:leading-[25.58px] lg:w-[268px] xl:w-[305px]"
  >
    {item.content}
  </p>

  {/* Bottom row */}
  <div
    class="relative top-[2px] flex h-[10.19px] items-center justify-between md:top-[18px] md:-mx-[17px] md:h-[21px] md:px-[36.42px]"
    style="position: relative;"
  >
    {/* Reactions */}
    <div class="flex items-center gap-[2.18px] md:gap-[4.5px]">
      <div class="flex -space-x-[-2.91px] md:-space-x-[-6px]">
        <HeartIcon className="relative z-10 h-[10.12px] w-[10.12px] select-none md:h-[20.84px] md:w-[20.84px]" />
        <LikeIcon className="h-[10.12px] w-[10.12px] select-none md:h-[20.84px] md:w-[20.84px]" />
      </div>
      <span
        class="translate-y-[0.5px] font-gilroy text-[4.91px] font-[700] leading-none text-[#000000] md:text-[10.1px]"
      >
        {item.likes}
      </span>
    </div>

    {/* Green Badge */}
    <div
      class="flex h-[16.86px] w-[38.18px] flex-shrink-0 flex-col items-center justify-center rounded-[7.75px] bg-[#007E26] p-[3.23px] text-white shadow-[0px_1.29px_1.29px_0px_#FFDFDF] md:h-[35px] md:w-[78px] md:rounded-[15.96px] md:p-[6.65px] md:shadow-[0px_2.66px_2.66px_0px_#FFDFDF]"
    >
      <span class="font-gilroy text-[7.74px] font-[1000] uppercase leading-none text-[#FFFFFF] md:text-[15.96px]">
        {item.hskLevel}
      </span>
      <span
        class="mt-[0.5px] font-gilroy text-[4.52px] font-[700] leading-none text-[#FFFFFF] md:mt-[1px] md:text-[9.31px]"
      >
        {item.timeSpent}
      </span>
    </div>
  </div>
</div>

{/* Modal Popup for Mobile (Each card has its own modal) */}
<div
  class="experience-modal pointer-events-none fixed inset-0 z-[100] flex items-center justify-center bg-black/40 px-4 opacity-0 transition-all duration-300"
>
  <div
    class="relative flex h-[429px] w-[346px] max-w-full flex-col justify-between rounded-[24px] border-[1px] border-[#AF0000] bg-white px-[24px] pb-[34px] pt-[34px] shadow-[6px_4px_16.6px_rgba(0,0,0,0.3)]"
    style="box-sizing: border-box;"
  >
    {/* Top row */}
    <div class="flex items-start justify-between">
      <div class="flex items-start gap-3">
        <div
          class="relative h-[90px] w-[90px] flex-shrink-0 rounded-full shadow-[0px_3.38px_84.5px_0px_rgba(0,0,0,0.1)]"
        >
          <Image
            src={item.avatar}
            width={150}
            height={150}
            alt={item.name}
            class="h-full w-full rounded-full border-[2.54px] border-white object-cover"
          />
        </div>
        <div>
          <h3 class="whitespace-nowrap font-gilroy text-[22px] font-[900] leading-none text-[#AF0000]">
            {item.name}
          </h3>
          <p class="mt-[12px] w-[151px] font-gilroy text-[18px] font-[500] leading-none text-[#000000]">
            {item.role}, {item.location}
          </p>
          <div class="mt-[20px] flex items-center gap-0.5">
            <StarReviewIcon className="h-3.5 w-3.5 fill-[#F3C650] text-[#F3C650]" />
            <StarReviewIcon className="h-3.5 w-3.5 fill-[#F3C650] text-[#F3C650]" />
            <StarReviewIcon className="h-3.5 w-3.5 fill-[#F3C650] text-[#F3C650]" />
            <StarReviewIcon className="h-3.5 w-3.5 fill-[#F3C650] text-[#F3C650]" />
            <StarReviewIcon className="h-3.5 w-3.5 fill-[#F3C650] text-[#F3C650]" />
          </div>
        </div>
      </div>

      {/* Share action */}
      <div class="mr-[8px] flex items-center gap-1.5 text-[#373737]">
        <ShareReviewIcon className="h-[21.79px] w-[21.79px] -translate-y-[12px] opacity-80" />
        <span class="-translate-y-[13px] font-gilroy text-[12.91px] font-[400] leading-none text-[#373737]">
          {item.shares}
        </span>
      </div>
    </div>

    {/* Review content */}
    <p
      class="custom-scrollbar mt-[16px] box-content h-[200px] w-full flex-shrink-0 overflow-y-auto pr-3 text-justify font-gilroy text-[14px] font-[700] italic leading-[25.58px] text-[#373737]"
    >
      {item.content}
    </p>

    {/* Bottom row */}
    <div class="relative mt-auto flex h-[35px] translate-y-[6px] items-center justify-between">
      {/* Reactions */}
      <div class="flex items-center gap-[4.5px]">
        <div class="flex -space-x-[-6px]">
          <HeartIcon className="relative z-10 h-[20.84px] w-[20.84px] select-none" />
          <LikeIcon className="h-[20.84px] w-[20.84px] select-none" />
        </div>
        <span class="translate-y-[0.5px] font-gilroy text-[10.1px] font-[700] leading-none text-[#000000]">
          {item.likes}
        </span>
      </div>

      {/* Green Badge */}
      <div
        class="flex h-[35px] w-[78px] flex-shrink-0 flex-col items-center justify-center rounded-[15.96px] bg-[#007E26] p-[6.65px] text-white shadow-[0px_2.66px_2.66px_0px_#FFDFDF]"
      >
        <span class="font-gilroy text-[15.96px] font-[1000] uppercase leading-none text-[#FFFFFF]">
          {item.hskLevel}
        </span>
        <span class="mt-[1px] font-gilroy text-[9.31px] font-[700] leading-none text-[#FFFFFF]">
          {item.timeSpent}
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  // Setup click listeners for experience-cards to open their respective sibling modals
  const cards = document.querySelectorAll('.experience-card');
  cards.forEach((card) => {
    const modal = card.nextElementSibling;
    if (!modal || !modal.classList.contains('experience-modal')) return;

    const closeBtn = modal.querySelector('.modal-close');

    card.addEventListener('click', () => {
      // Trigger only on mobile screens (< 768px)
      if (window.innerWidth >= 768) return;

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
    });

    const closeModal = () => {
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      document.body.style.overflow = '';
    };

    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeModal();
      });
    }

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  });
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #d9d9d9;
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #bfbfbf;
  }
</style>
