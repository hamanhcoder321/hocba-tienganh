---
import { Image } from 'astro:assets';
import { HeartIcon, LikeIcon } from '@/components/common/icons';

interface Props {
  item: {
    name: string;
    role: string;
    location: string;
    // rating: number;
    hskLevel: string;
    timeSpent: string;
    content: string;
    likes: number;
    shares: number;
    avatar: ImageMetadata;
    hasOwlSticker?: boolean;
  };
}

const { item } = Astro.props;
---

<div
  class="experience-card overflow-hidden relative mx-auto flex h-full w-[280px] cursor-pointer flex-col justify-start gap-y-[6px] rounded-[11.65px] border-[0.49px] border-[#1877F2] bg-white px-[12px] pb-[16.51px] pt-[16.51px] shadow-[6px_6px_20px_0px_rgba(0,0,0,0.02)] md:w-[335px] md:cursor-default md:gap-y-[8px] md:rounded-[24px] md:border md:px-[17px] md:pb-[20px] md:pt-[34px] lg:w-[460px] xl:w-[560px] 2xl:w-[540px]"
>
  {/* Top row */}
  <div class="mb-[6px] flex items-start justify-between md:mb-[6px]">
    <div class="flex items-start gap-3 md:gap-4 lg:gap-5">
      <Image
        src={item.avatar}
        width={200}
        height={200}
        alt={item.name}
        class="h-[55px] w-[55px] flex-shrink-0 rounded-full object-cover md:h-[75px] md:w-[75px] lg:h-[85px] lg:w-[85px]"
      />
      <div>
        <h3
          class="mt-[1.5px] whitespace-nowrap font-gilroy text-[14px] font-[900] leading-none text-[#052284] md:mt-0 md:text-[18px] lg:text-[17px] xl:text-[22px]"
        >
          {item.name}
        </h3>
        <p
          class="mt-[6px] font-gilroy text-[12px] font-[500] leading-none text-[#052284] md:mt-[8px] md:text-[14px] md:leading-[1.3] lg:text-[13px] xl:mt-[12px] xl:text-[18px] xl:leading-none"
        >
          {item.location}
        </p>

        <p class="mt-[3px] font-gilroy text-[10px] font-[400] leading-none text-[#888] md:mt-[5px] md:text-[12px] lg:text-[11px] xl:mt-[6px] xl:text-[15px]">
          {item.timeSpent}
        </p>

      </div>
    </div>

    {/* Paper plane + IELTS Badge */}
    <div class="relative -translate-y-[8px] flex flex-shrink-0 items-center md:-translate-y-[10px]">
      <div class="relative mt-[6px] flex items-center justify-center whitespace-nowrap rounded-[3px] bg-gradient-to-r from-[#F97316] to-[#FFCF5A] px-[6px] py-[2px] md:mt-[10px] md:rounded-[5px] md:px-[8px] md:py-[3px]">
        <svg class="absolute -left-[8px] -top-[6px] h-[10px] w-[16px] flex-shrink-0 md:-left-[14px] md:-top-[10px] md:h-[18px] md:w-[28px]" viewBox="0 0 28 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M27.5 0.5L0.5 9L11 12.5L15.5 18L27.5 0.5Z" fill="#F97316"/>
          <path d="M11 12.5L15.5 18L21 13.5L11 12.5Z" fill="#C2410C"/>
          <path d="M11 12.5L27.5 0.5L14 10L11 12.5Z" fill="#FED7AA"/>
        </svg>
        <span class="font-gilroy text-[9px] font-[800] uppercase leading-none text-white md:text-[13px]">{item.hskLevel}</span>
      </div>
    </div>
  </div>

  {/* Review content */}
  <p
    class="md:custom-scrollbar box-content h-auto w-full flex-shrink-0 text-justify font-gilroy text-[11px] font-[500] italic leading-[16px] text-[#504E4E] md:h-[200px] md:overflow-y-auto md:w-full md:pr-3 md:text-[14px] md:leading-[25.58px]"
  >
    {item.content}
  </p>

  {/* Bottom row */}
  <div
    class="relative mt-auto pt-[8px] flex h-auto items-center justify-end md:mt-0 md:pt-0 md:-mx-[17px] md:h-[21px] md:px-[36.42px]"
    style="position: relative;"
  >
    {/* Facebook Icon */}
    <svg class="h-[18px] w-[18px] flex-shrink-0 md:h-[28px] md:w-[28px]" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="28" height="28" rx="6" fill="#1877F2"/>
      <path d="M19 5h-3a5 5 0 0 0-5 5v3H8v4h3v8h4v-8h3l1-4h-4V10a1 1 0 0 1 1-1h3z" fill="white"/>
    </svg>
  </div>
</div>

{/* Modal Popup for Mobile (Each card has its own modal) */}
<div
  class="experience-modal pointer-events-none fixed inset-0 z-[100] flex items-center justify-center bg-black/40 px-4 opacity-0 transition-all duration-300"
>
  <div
    class="relative flex h-[429px] w-[346px] max-w-full flex-col justify-between rounded-[24px] border-[1px] border-[#AF0000] bg-white px-[24px] pb-[34px] pt-[34px] shadow-[6px_4px_16.6px_rgba(0,0,0,0.3)]"
    style="box-sizing: border-box;"
  >
    {/* Top row */}
    <div class="flex items-start justify-between">
      <div class="flex items-start gap-3">
        <Image
          src={item.avatar}
          width={200}
          height={200}
          alt={item.name}
          class="h-[75px] w-[75px] flex-shrink-0 rounded-full object-cover"
        />
        <div>
          <h3 class="whitespace-nowrap font-gilroy text-[22px] font-[900] leading-none text-[#052284]">
            {item.name}
          </h3>
          <p class="mt-[12px] w-[151px] font-gilroy text-[18px] font-[500] leading-none text-[#052284]">
            {item.location}
          </p>

          <p class="mt-[6px] font-gilroy text-[15px] font-[400] leading-none text-[#888]">
            {item.timeSpent}
          </p>
        </div>
      </div>

      {/* Paper plane + IELTS Badge */}
      <div class="relative mr-[8px] -translate-y-[10px] flex flex-shrink-0 items-center">
        <div class="relative mt-[10px] flex items-center justify-center whitespace-nowrap rounded-[5px] bg-gradient-to-r from-[#F97316] to-[#FFCF5A] px-[8px] py-[3px]">
          <svg class="absolute -left-[14px] -top-[10px] h-[18px] w-[28px] flex-shrink-0" viewBox="0 0 28 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M27.5 0.5L0.5 9L11 12.5L15.5 18L27.5 0.5Z" fill="#F97316"/>
            <path d="M11 12.5L15.5 18L21 13.5L11 12.5Z" fill="#C2410C"/>
            <path d="M11 12.5L27.5 0.5L14 10L11 12.5Z" fill="#FED7AA"/>
          </svg>
          <span class="font-gilroy text-[13px] font-[800] uppercase leading-none text-white">{item.hskLevel}</span>
        </div>
      </div>
    </div>

    {/* Review content */}
    <p
      class="custom-scrollbar mt-[16px] box-content h-[200px] w-full flex-shrink-0 overflow-y-auto pr-3 text-justify font-gilroy text-[14px] font-[700] italic leading-[25.58px] text-[#373737]"
    >
      {item.content}
    </p>

    {/* Bottom row */}
    <div class="relative mt-auto flex h-[35px] translate-y-[6px] items-center justify-between">
      {/* Reactions */}
      <div class="flex items-center gap-[4.5px]">
        <div class="flex -space-x-[-6px]">
          <HeartIcon className="relative z-10 h-[20.84px] w-[20.84px] select-none" />
          <LikeIcon className="h-[20.84px] w-[20.84px] select-none" />
        </div>
        <span class="translate-y-[0.5px] font-gilroy text-[10.1px] font-[700] leading-none text-[#000000]">
          {item.likes}
        </span>
      </div>

      {/* Facebook Icon */}
      <svg class="h-[28px] w-[28px] flex-shrink-0" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="28" height="28" rx="6" fill="#1877F2"/>
        <path d="M19 5h-3a5 5 0 0 0-5 5v3H8v4h3v8h4v-8h3l1-4h-4V10a1 1 0 0 1 1-1h3z" fill="white"/>
      </svg>
    </div>
  </div>
</div>

<script>
  // Setup click listeners for experience-cards to open their respective sibling modals
  const cards = document.querySelectorAll('.experience-card');
  cards.forEach((card) => {
    const modal = card.nextElementSibling;
    if (!modal || !modal.classList.contains('experience-modal')) return;

    const closeBtn = modal.querySelector('.modal-close');

    card.addEventListener('click', () => {
      // Trigger only on mobile screens (< 768px)
      if (window.innerWidth >= 768) return;

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
    });

    const closeModal = () => {
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      document.body.style.overflow = '';
    };

    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeModal();
      });
    }

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  });
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #d9d9d9;
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #bfbfbf;
  }
</style>
