---
import { Image, getImage } from 'astro:assets';
import { IMAGES } from '@/lib/constants/images';
import {
  FourPointedStar,
  FourPointedStarMini,
  GraduationCapAchievement,
  TargetAchievement,
  DoubleChevronRight,
} from '@/components/common/icons';
import { SingleCertificateDialog } from './SingleCertificateDialog';
import { StudentShowcaseDialog } from './StudentShowcaseDialog';
import { fetchStudents } from '@/lib/static-data';

const studentsResponse = await fetchStudents({ page: 1, limit: 10 });
const studentList = studentsResponse?.list || [];

const students =
  studentList.length > 0
    ? studentList.map((item) => ({
        name: item.name,
        // role: item.profession,
        badge: item.course,
        // score: item.score ? `${item.score} điểm` : '',
        image: item.avatar_url || IMAGES.course.profilePic,
      }))
    : Array(8).fill({
        name: 'Nguyễn Văn A',
        // role: 'Sinh viên',
        badge: 'HSK5',
        score: '230 điểm',
        image: IMAGES.home.aboutClass, // Placeholder image matching the study group
      });

const optimizedHsk = await getImage({
  src: IMAGES.detailLectuter.hsk,
  format: 'webp',
  width: 250,
  height: 150,
  quality: 100,
  densities: [1, 2],
});
const optimizedMachine = await getImage({
  src: IMAGES.introduce.machine,
  format: 'webp',
  width: 40,
  height: 25,
  quality: 100,
});
const optimizedProfilePic = await getImage({
  densities: [1, 2],
  src: IMAGES.course.profilePic,
  width: 300,
  height: 300,
});

const icons = {
  hsk: optimizedHsk.src,
  machine: optimizedMachine.src,
  defaultAvatar: optimizedProfilePic.src,
};
