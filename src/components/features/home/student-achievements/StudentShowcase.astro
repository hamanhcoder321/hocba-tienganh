<style>
  .student-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  @media (hover: hover) and (min-width: 768px) {
    /*
    .student-card:hover {
      background: linear-gradient(135deg, #ffd568 0%, #fff5db 100%) !important;
      border-color: #d9d9d9 !important;
      box-shadow: 4px 11px 13.6px 0px rgba(175, 0, 0, 0.25) !important;
    }
    */
    .student-card:hover {
      background: linear-gradient(180deg, #E97E2E 0%, #D55F0D 100%) !important;
      border-color: #D55F0D !important;
      box-shadow: 4px 11px 13.6px 0px rgba(213, 95, 13, 0.25) !important;
    }
  }
</style>

<script is:inline>
  function setupAutoScroll(containerId, intervalMs) {
    const container = document.getElementById(containerId);
    if (!container) return;

    let timer = null;
    const cardWidth = 260;
    const totalCards = 4;

    container.scrollLeft = totalCards * cardWidth;

    function startInterval() {
      timer = setInterval(() => {
        let currentIndex = Math.round(container.scrollLeft / cardWidth);

        currentIndex++;

        container.scrollTo({
          left: currentIndex * cardWidth,
          behavior: 'smooth',
        });

        if (currentIndex === totalCards * 2) {
          setTimeout(() => {
            container.scrollTo({ left: totalCards * cardWidth, behavior: 'auto' });
          }, 500);
        }
      }, intervalMs);
    }

    startInterval();

    let resetTimer = null;

    container.addEventListener(
      'touchstart',
      () => {
        clearInterval(timer);
        timer = null;
      },
      { passive: true },
    );

    container.addEventListener(
      'touchend',
      () => {
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          let currentIndex = Math.round(container.scrollLeft / cardWidth);
          if (currentIndex >= totalCards * 2 || currentIndex < totalCards) {
            const normalizedIndex = (currentIndex % totalCards) + totalCards;
            container.scrollTo({ left: normalizedIndex * cardWidth, behavior: 'auto' });
          }
          startInterval();
        }, 3000);
      },
      { passive: true },
    );

    container.addEventListener(
      'scroll',
      () => {
        if (timer !== null) return;

        const middleStart = totalCards * cardWidth;
        const middleEnd = totalCards * cardWidth * 2;

        if (container.scrollLeft >= middleEnd) {
          container.scrollLeft -= middleStart;
        } else if (container.scrollLeft < middleStart) {
          container.scrollLeft += middleStart;
        }
      },
      { passive: true },
    );
  }

  setupAutoScroll('mobile-row-1', 4000);
  setupAutoScroll('mobile-row-2', 6000);

  // Thêm sự kiện click cho thẻ học viên
  document.addEventListener('DOMContentLoaded', () => {
    const studentCards = document.querySelectorAll('.student-card');
    studentCards.forEach((card) => {
      card.addEventListener('click', (e) => {
        const studentDataRaw = e.currentTarget.getAttribute('data-student');
        if (studentDataRaw) {
          const student = JSON.parse(studentDataRaw);
          window.dispatchEvent(new CustomEvent('openSingleCertificateDialog', { detail: { student } }));
        }
      });
    });
  });
</script>
