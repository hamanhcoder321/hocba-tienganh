---
import { HomeIcon } from '@/components/common/icons';
import { IMAGES } from '@/lib/constants/images';
import { Image } from 'astro:assets';
---

<section id="about-us" class="relative pb-16 pt-10 sm:pb-20 sm:pt-16">
  <div class="mx-auto max-w-[1380px] px-4 md:px-12 lg:px-8 xl:px-4">
    <div class="flex flex-col gap-12 lg:flex-row lg:items-stretch xl:gap-16">
      {/* leftimages */}
      <div class="relative hidden w-full lg:w-1/2 lg:flex justify-center lg:justify-start">
        <div class="relative w-full max-w-[550px] lg:max-w-[655px] ml-4 md:ml-10 lg:ml-8 lg:h-full group cursor-pointer">
          <div class="w-full h-auto lg:h-full aspect-[655/694] rounded-[24px] lg:rounded-[30px] overflow-hidden relative shadow-lg transition-shadow duration-500 group-hover:shadow-2xl">
            <Image
              src={IMAGES.home.pvHocba}
              width={655}
              height={677}
              alt="Phỏng vấn học viên The IELTS Space"
              class="h-auto lg:h-full w-full object-cover object-[15%_center] transition-transform duration-700 group-hover:scale-110"
              densities={[1, 2]}
            />
          </div>
          <div class="absolute -bottom-8 -left-6 md:-bottom-12 md:-left-12 w-[65%] sm:w-[60%] md:w-[55%] max-w-[340px] z-10 pointer-events-none">
            <Image
              src={IMAGES.home.thanhvien}
              width={500}
              height={400}
              alt="Thành viên The IELTS Space"
              class="h-auto w-full rounded-[16px] md:rounded-[20px]"
            />
          </div>
        </div>
      </div>

      {/* rght side: content */}
      <div class="flex w-full flex-col justify-center rounded-[24px] bg-[#EEF2FC] p-8 md:p-10 lg:w-[615px] lg:gap-[20px] lg:shrink-0 lg:p-12 xl:p-14 mt-6 md:mt-10 lg:mt-0">
        <div class="flex items-center gap-2">
          <HomeIcon className="size-5 md:size-6 text-[#373737]" />
          <span class="flex items-start gap-1 text-[16px] font-bold text-[#373737] lg:text-[26px] lg:leading-tight">
            Giới thiệu
            <svg class="w-3 h-3 text-[#F97316] mt-1" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
            </svg>
          </span>
        </div>

        <h2>
          <span class="block text-[32px] font-black uppercase text-[#0D1F5B] lg:text-[42px] lg:leading-[47px]">
            THE IELTS SPACE
          </span>
        </h2>
        
        <p class="text-[15px] font-black lg:font-bold uppercase text-[#373737] lg:text-[20px] lg:whitespace-nowrap">
          KHÔNG GIAN HỌC TẬP TÍCH HỢP THẾ HỆ MỚI
        </p>

        <div class="space-y-4 text-justify text-[14px] lg:text-[16px] font-medium lg:leading-[24px] text-[#4a4a4a]">
          <p>
            <strong class="font-bold text-[#373737]">THE IELTS SPACE</strong> tái thiết cách người học chinh phục tiếng Anh bằng một
            không gian sinh thái tích hợp - nơi giáo viên dẫn dắt kỹ càng, công nghệ
            liên tục tinh chỉnh tối ưu, mentor 1-1 đồng hành theo sát và dữ liệu tiến bộ
            trực quan thực tế. Toàn bộ quá trình từ học trên lớp, luyện tập, chữa bài
            đến theo dõi kết quả được kết nối trong một hệ trải nghiệm thống nhất,
            đi theo lộ trình cá nhân rõ ràng. Từ đó giúp người học chinh phục mục tiêu
            tiếng Anh một cách nhanh hơn, dễ dàng hơn, trực quan hơn và thú vị hơn.
          </p>
          <p>
            <strong class="font-bold text-[#373737]">THE IELTS SPACE</strong> cung cấp các chương trình tiếng Anh từ nền tảng đến
            nâng cao, tập trung vào IELTS và các chứng chỉ quốc tế. Giáo trình nội bộ
            được xây dựng theo khung năng lực quốc tế, thiết kế riêng cho từng trình
            độ và mục tiêu đầu ra, đồng thời liên tục cập nhật theo yêu cầu mới nhất
            của kỳ thi.
          </p>
        </div>

        <div class="mt-8 md:mt-10">
          <a
            href="/gioi-thieu"
            class="inline-flex w-full sm:w-auto items-center justify-center rounded-full bg-[#F97316] px-8 py-3.5 text-[14px] font-bold uppercase text-white shadow-[0_4px_15px_rgba(249,115,22,0.4)] transition-all duration-300 hover:bg-gradient-to-r hover:from-[#F97316] hover:to-[#FBBF24] hover:shadow-[0_10px_25px_rgba(249,115,22,0.5)] md:text-[15px]"
          >
            XEM THÊM VỀ THE IELTS SPACE
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
