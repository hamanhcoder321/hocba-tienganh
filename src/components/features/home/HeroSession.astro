---
import { IMAGES } from '@/lib/constants/images';
import { Image } from 'astro:assets';
import RegisterStudyModal from '@/components/common/RegisterStudyModal';

const heroData = [
  {
    number: '01',
    content: 'Lộ trình học cá nhân hóa theo năng lực',
    link: '#roadmap-section',
  },
  {
    number: '02',
    content: 'Mentor học tập đồng hành 1–1',
    link: '#mentor-content',
  },
  {
    number: '03',
    content: 'Chương trình chuẩn HSK 3.0 & thực chiến',
    link: '#detection-section',
  },
];
---

<section
  id="hero"
  class="relative flex w-full items-center bg-gradient-to-r from-[#0C1B4D] via-[#0C246E] to-[#063DE4] overflow-hidden lg:min-h-[646px] pb-8 pt-4 lg:pb-0 lg:pt-0"
  aria-labelledby="hero-heading"
>
  <div
    class="pointer-events-none absolute -left-[15%] top-9 h-[400px] w-[400px] rounded-full bg-[#F97316]/10 blur-[100px] max-lg:hidden z-0"
    aria-hidden="true"
  >
  </div>
  
  {/* xanh sáng phía sau ảnh bên phải */}
  <div
    class="pointer-events-none absolute -right-[5%] top-1/2 h-[600px] w-[600px] -translate-y-1/2 rounded-full bg-[#4185FF]/50 blur-[130px] max-lg:hidden z-0"
    aria-hidden="true"
  >
  </div>



  <div class="mx-auto w-full max-w-[1440px] px-4 lg:px-[60px] xl:px-[80px] relative z-10 flex flex-col lg:flex-row items-center justify-center lg:gap-[40px] xl:gap-[60px] lg:min-h-[646px]">
    

    
    {/* contet */}
    <div class="flex w-full max-w-[600px] xl:max-w-[650px] flex-col items-start text-left pt-2 pb-8 lg:py-16 z-20">
      
      {/* badge */}
      <div class="relative mb-4 inline-flex items-center gap-2 rounded-full bg-white/90 px-4 py-1.5 shadow-sm">
        {/* Star 1: Top-left of badge */}
        <svg class="absolute -top-[15px] -left-[20px] w-4 h-4 text-white/60 max-lg:hidden z-0 animate-pulse" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
        </svg>
        {/* Star 2: Top-right of badge */}
        <svg class="absolute -top-[30px] -right-[40px] w-4 h-4 text-white/60 max-lg:hidden z-0 animate-pulse" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
        </svg>
        <span class="inline-flex items-center gap-1.5 text-[14px] leading-[20px] font-bold text-[#072899] uppercase tracking-wide">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#FE9432" xmlns="http://www.w3.org/2000/svg">
            <path d="M13.13 22.19L11.5 18.36C13.07 17.78 14.54 17 15.9 16.09L13.13 22.19ZM5.64 12.5L1.81 10.87L7.91 8.1C7 9.46 6.22 10.93 5.64 12.5ZM21.61 2.39C21.61 2.39 16.66 .269 9 5.36C5.79 7.5 3.39 10.71 2.22 14.45L5.41 15.82L8.18 18.59L9.55 21.78C13.29 20.61 16.5 18.21 18.64 15C23.73 7.34 21.61 2.39 21.61 2.39ZM13.88 10.12C13.5 10.5 12.87 10.5 12.46 10.12C12.08 9.71 12.08 9.08 12.46 8.71C12.87 8.33 13.5 8.33 13.88 8.71C14.29 9.08 14.29 9.71 13.88 10.12Z"/>
          </svg>
          KHÔNG GIAN HỌC TẬP TÍCH HỢP THẾ HỆ MỚI
        </span>
      </div>

      {/* Heading */}
      <div class="mb-4 lg:mb-8 w-full md:w-auto">
        <h1 id="hero-heading" class="font-black tracking-tight">
          <span class="relative block w-max text-[28px] text-white lg:text-[54px] lg:leading-[1.34]">
            {/* Star 3: Left of Chương trình */}
            <svg class="absolute top-[20%] -left-[12px] -translate-y-1/2 w-5 h-5 text-[#F97316] max-lg:hidden z-0 animate-pulse" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
            </svg>
            Chương trình
            {/* Star 5: Bottom right of Chương trình */}
            <svg class="absolute -bottom-[5px] -right-[220px] w-3 h-3 text-white/60 max-lg:hidden z-0 animate-pulse" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
            </svg>
          </span>
          <span class="block text-[35px] font-black uppercase text-white lg:text-[72px] lg:leading-[1.34] mt-1">
            ĐÀO TẠO 
            <span class="relative inline-block">
              IELTS
              <svg class="absolute -bottom-[6px] lg:-bottom-[14px] left-[55%] lg:left-[15%] w-[106px] lg:w-[130%] h-[6px] lg:h-[12px] opacity-100" viewBox="0 0 300 8" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path d="M2 5C80 1 200 1 298 5" stroke="#F97316" class="stroke-[1.5px] lg:stroke-[3px]" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
              </svg>
            </span>
          </span>
          <span class="relative block w-max mt-3 lg:mt-5 text-nowrap text-[28px] font-black uppercase text-[#F97316] lg:text-[40px] xl:text-[46px]">
            {/* Star 4: Left of TOÀN DIỆN */}
            <svg class="absolute top-1/2 -left-[45px] -translate-y-1/2 w-4 h-4 text-white/50 max-lg:hidden z-0 animate-pulse" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
            </svg>
            TOÀN DIỆN 4 KỸ NĂNG
            {/* Star 7: Right of TOÀN DIỆN */}
            <svg class="absolute top-1/2 -right-[50px] -translate-y-1/2 w-4 h-4 text-[#F97316] max-lg:hidden z-0 animate-pulse" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
            </svg>
          </span>
        </h1>
      </div>

      {/* mobile banner (màn hình nhỏ) */}
      <div class="relative w-full flex justify-center lg:hidden mb-8">
        <Image
          src={IMAGES.home.bannerHeroHs}
          alt="Đào tạo IELTS toàn diện 4 kỹ năng"
          width={600}
          height={600}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full h-auto max-w-[450px] max-h-[500px] object-contain object-bottom [mask-image:linear-gradient(to_bottom,black_85%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,black_85%,transparent_100%)]"
        />
      </div>

      {/* Checklist */}
      <ul aria-label="Tính năng nổi bật" class="w-full lg:max-w-none flex flex-col items-start space-y-3 lg:space-y-4 md:w-auto mb-10 text-left px-2 lg:px-0">
        {[
          "GIẢI PHÁP HỌC TẬP CÁ NHÂN HÓA",
          "PHƯƠNG PHÁP HỌC TẬP X3 HIỆU QUẢ",
          "MỘT CÁCH HỌC KHÁC BIỆT ĐEM ĐẾN KẾT <br/> QUẢ BẤT NGỜ"
        ].map((text) => (
          <li class="flex items-center gap-3">
            {/* Mobile iocn */}
            <div class="flex lg:hidden h-[28px] w-[28px] shrink-0 items-center justify-center rounded-full bg-[#F97316] shadow-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                <path d="M13.13 22.19L11.5 18.36C13.07 17.78 14.54 17 15.9 16.09L13.13 22.19ZM5.64 12.5L1.81 10.87L7.91 8.1C7 9.46 6.22 10.93 5.64 12.5ZM21.61 2.39C21.61 2.39 16.66 .269 9 5.36C5.79 7.5 3.39 10.71 2.22 14.45L5.41 15.82L8.18 18.59L9.55 21.78C13.29 20.61 16.5 18.21 18.64 15C23.73 7.34 21.61 2.39 21.61 2.39ZM13.88 10.12C13.5 10.5 12.87 10.5 12.46 10.12C12.08 9.71 12.08 9.08 12.46 8.71C12.87 8.33 13.5 8.33 13.88 8.71C14.29 9.08 14.29 9.71 13.88 10.12Z"/>
              </svg>
            </div>
            {/* latop Icon  */}
            <div class="hidden lg:flex h-[24px] w-[24px] shrink-0 items-center justify-center rounded-full bg-white shadow-sm">
              <svg width="12" height="9" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1.5 5L4.5 8L12.5 1.5" stroke="#082381" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span class="text-sm font-semibold text-white lg:font-medium lg:text-[22px] lg:leading-[24px] lg:tracking-[-0.5px]" set:html={text}></span>
          </li>
        ))}
      </ul>

      {/* Buttons */}
      <div class="flex flex-col sm:flex-row items-center gap-3 lg:gap-4 w-full sm:w-auto">
        <RegisterStudyModal client:load dataInput="Banner Hero - Đăng kí tư vấn">
          <button type="button" class="group flex w-full sm:w-auto items-center justify-between lg:justify-center gap-2 rounded-full bg-[#F97316] px-8 py-3.5 text-[15px] lg:text-[18px] lg:leading-[21px] font-semibold text-white transition-all duration-300 hover:scale-105 hover:bg-gradient-to-r hover:from-[#F97316] hover:to-[#FBBF24] hover:shadow-[0_0_25px_rgba(249,115,22,0.7)] hover:[text-shadow:0_0_10px_rgba(255,255,255,0.9)]">
            <span class="flex-1 text-center lg:flex-none">Đăng Kí Tư Vấn</span>
            <svg class="w-4 h-4 lg:w-5 lg:h-5 shrink-0 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </RegisterStudyModal>
        <a href="#lo-trinh" class="group relative z-0 flex w-full sm:w-auto items-center justify-between lg:justify-center gap-2 rounded-full bg-[#22336D] px-8 py-3.5 text-[15px] lg:text-base font-semibold text-white transition-all duration-300 hover:bg-[#30458C] hover:shadow-[inset_0_15px_15px_-10px_rgba(255,255,255,0.6)] hover:border-t-white/60 border border-white/20 lg:pl-14">
          <svg class="lg:absolute lg:left-6 w-4 h-4 lg:w-3 lg:h-[14px]" viewBox="0 0 12 14" fill="white" xmlns="http://www.w3.org/2000/svg">
            <path d="M11.5 6.13397C12.1667 6.51887 12.1667 7.48113 11.5 7.86603L1.75 13.4952C1.08333 13.8801 0.250001 13.399 0.250001 12.6292L0.250001 1.37083C0.250001 0.601034 1.08333 0.119909 1.75 0.504809L11.5 6.13397Z"/>
          </svg>
          <span class="flex-1 text-center lg:flex-none">Tham Khảo Lộ Trình IELTS</span>
          <span class="w-4 h-4 lg:hidden"></span>
        </a>
      </div>
    </div>

    {/* banner (chỉ hiện trên laptop) */}
    <div class="hidden lg:flex relative w-full max-w-[600px] lg:max-w-[700px] xl:max-w-[750px] z-10 justify-center lg:justify-end mt-8 lg:mt-0 pt-0 lg:pt-4">
      <div class="relative w-full flex justify-center lg:justify-end">

        <Image
          src={IMAGES.home.bannerHeroHs}
          alt="Đào tạo IELTS toàn diện 4 kỹ năng"
          width={1000}
          height={1000}
          sizes="(max-width: 1024px) 100vw, 1000px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full h-auto max-h-[500px] lg:max-h-[600px] xl:max-h-[646px] object-contain object-right [mask-image:linear-gradient(to_bottom,black_80%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,black_80%,transparent_100%)]"
        />
      </div>
    </div>
  </div>
</section>

<style>
  #hero {
    scroll-margin-top: 80px;
  }

  .premium-glow {
    filter: drop-shadow(0 0 15px rgba(243, 198, 80, 0.4));
  }
</style>
