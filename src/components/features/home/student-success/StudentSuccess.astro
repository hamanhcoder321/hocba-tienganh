---
import { IMAGES } from '@/lib/constants/images';
import { getImage } from 'astro:assets';
import EvidenceGallery from './EvidenceGallery.astro';
import SuccessHeader from './SuccessHeader.astro';
import { TestimonialSlider, type TestimonialItem } from './TestimonialSlider.tsx';

const RAW_TESTIMONIALS: Omit<TestimonialItem, 'avatar'>[] = [
  {
    name: 'Minh Anh',
    role: 'Học sinh lớp 12',
    location: 'Hà Nội',
    rating: 5,
    hskLevel: 'IELTS 7.5',
    timeSpent: '',
    content:
      ' Em vừa nhận điểm nên phải lên feedback luôn ạ 😭 7.5 overall. Trước em học khá nhiều nhưng không biết kẹt ở đâu không lên band được, không biết trọng tâm để ôn. Sang đây em thích nhất là có AI sửa lỗi liên tục, dashboard rất rõ ràng để em tự biết mình là ai không ảo nữa =))) Sau đó mentor cho em luyện thêm những điểm yếu nữa nên đỡ học lan man hẳn. Cảm ơn cô Mai rất nhiều vì đã cứu Writing của em từ 5.5 lên 7.0, cô chữa bài kỹ thật sự ạ 🥹',
    likes: 348,
    shares: 67,
  },
  {
    name: 'Thu Thủy',
    role: 'Học sinh lớp 11',
    location: 'Đà Nẵng',
    rating: 5,
    hskLevel: 'IELTS 7.5',
    timeSpent: '',
    content:
      'Mình đã đi làm nên quỹ thời gian hạn chế. Tình cờ biết đến Học Bá có lớp online 100% thời gian linh động nên đăng ký học luôn. Mình học H6 trong thời gian cam kết 6 tháng của trung tâm cùng với ctrinh H6 học 100% với giáo viên bản xứ .Ở đây cách học Project Based Learning mình thấy hiệu quả, học qua project nên dễ hiểu, áp dụng nhanh, dù kiến thức HSK6 khá nặng & khó.Giảng viên bản xứ cực kỳ nhiệt tình, theo sát từng buổi, giúp mình tiến bộ rõ rệt Kết quả là mình đỗ HSK6 đợt thi tháng 9 / 2025. Rất cảm ơn trung tâm và cô Junchi đã support hết mình.',
    likes: 298,
    shares: 68,
  },
  {
    name: 'Tuấn Kiệt',
    role: 'Nhân viên IT',
    location: 'HCM',
    rating: 5,
    hskLevel: '7.5 IELTS',
    timeSpent: '',
    content: 'Ban đầu mình cũng hơi rén khoản học với AI vì thường AI tạo sinh có thể không chính xác =))) Trước từng học thử vài bên rồi AI tạo câu hỏi sai tùm lum. Với THE IELTS SPACE thì thống rất khác biệt vì AI không tự nghĩ ra đề lung tung, bài tập đều lấy từ kho nội dung do giáo viên nghiên cứu và kiểm duyệt trước. AI chỉ dựa vào những lỗi mình hay mắc để chọn bài phù hợp hơn thôi :))) Nói chung mình khá thích cách này, vì vẫn tận dụng được AI để cá nhân hóa nhưng phần kiến thức thì có giáo viên kiểm soát nên đáng tin hơn nhiều.',
    likes: 90,
    shares: 5,
  },
  {
    name: 'Nhật Quân',
    role: 'Học Sinh 12',
    location: 'Đà Nẵng',
    rating: 5,
    hskLevel: '7.5 IELTS',
    timeSpent: '',
    content: 'Mình từng bị stuck 6.0 khá lâu và đã cày rất nhiều đề Cambridge nhưng điểm gần như không nhúc nhích. Vào học mới hiểu là nâng band không phải cứ làm nhiều đề vào là được mà còn phải có tư duy, chiến lược làm bài, phát triển bài nữa. Phải biết lỗi thường ở những phần nào, do tư duy hay ghi nhớ, do từ vựng hay ngữ pháp để còn biết cải thiện. Cảm ơn thầy Minh vì đã thay đổi hoàn toàn cách mình học Reading và Writing. Sau 4 tháng mình đạt 7.5 kịp nộp hồ sơ du học, nhẹ cả người tí thì đi 😭',
    likes: 200,
    shares: 20,
  },
  {
    name: 'Thanh Huyền',
    role: 'Học sinh lớp 11',
    location: 'Hưng Yên',
    rating: 5,
    hskLevel: '5.5 IELTS',
    timeSpent: '',
    content: 'Em khá ngại học tiếng Anh vì nền tảng không tốt. Trước đi học chả hiểu cái gì, học trước quên sau, bạn cùng lớp thì cứ giơ tay trả lời ầm ầm rất áp lực :( Qua đây thấy nhẹ nhõm hơn rất nhìuuuu. Giáo viên giải thích từ bản chất, tư duy chứ không bắt nhớ quá nhiều công thức, sau đó có bài luyện ngay trên hệ thống nên dễ nhớ hơn. Sai ở đâu hệ thống lưu lại, mấy phần yếu thì được luyện thêm chứ không phải học lại tất cả từ đầu. Học trên LMS rất xịn xò, hiện đại và nhiều game thú vị nên chăm lắm. Cũng phải cảm ơn chị Hương mentor vì chưa bao giờ cáu dù em có những câu hỏi vô cùng ngáo ngơ :))) Hiện em đã đạt 5.5 và đang học tiếp aim 6.5',
    likes: 150,
    shares: 15,
  },

  {
    name: 'Thu Hà',
    role: 'Sale Manager',
    location: '',
    rating: 5,
    hskLevel: '7.0 IELTS',
    timeSpent: '',
    content: 'Mình là dân đi làm nên thật sự không có thời gian ngày nào cũng ngồi cày 3-4 tiếng như các bạn. Cái mình thích nhất ở THE IELTS SPACE là không bắt học dàn trải. AI phân tích khá rõ mình đang yếu kỹ năng nào, dạng bài nào mất điểm nhiều và cả những lỗi bị lặp lại. Đợt đầu mình cứ nghĩ do ngữ pháp yếu nhưng hóa ra thứ kéo điểm xuống nhiều nhất lại là vốn từ vựng collocation :)) Mình đã nhờ AI lên kế hoạch học tập cho và mentor bổ sung thêm bài luyện riêng. Sau 4 tháng mình đã từ 6.0 lên 7.0 overall',
    likes: 120,
    shares: 10,
  },
];

const AVATAR_IMAGES = [
  IMAGES.home.MinhAnh,
  IMAGES.home.ThuThuyHvdc,
  IMAGES.home.TuanKietHvdc,
  IMAGES.home.NhatQuanHvdc,
  IMAGES.home.ThanhHuyenHvdc,
  IMAGES.home.ThuHaHvdc,
];

const optimizedTestimonials: TestimonialItem[] = await Promise.all(
  RAW_TESTIMONIALS.map(async (item, index) => {
    const baseImage = AVATAR_IMAGES[index];

    const optimized = await getImage({
      src: baseImage,
      width: 300,
      height: 300,
      format: 'webp',
      densities: [1, 2],
    });

    return {
      ...item,
      avatar: optimized.src,
    };
  }),
);
---

<section id="student-success" class="student-success-section overflow-hidden bg-white">
  <SuccessHeader />
  <EvidenceGallery />
  <div class="py-2 md:py-8">
    <TestimonialSlider items={optimizedTestimonials} client:visible />
  </div>
</section>
