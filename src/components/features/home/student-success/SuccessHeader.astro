---
import { IMAGES } from '@/lib/constants/images';
import { Image } from 'astro:assets';
import { Star } from 'lucide-react';
import CommitmentBadge from '../ui/CommitmentBadge';
import imgCuonNhatKy from '@/assets/images/img-hocba-tienganh/img-cuon-nhat-ky.png';
---

<div
  class="container mx-auto mb-6 rounded-t-[24px] bg-gradient-to-b from-[#FFF7EF] to-[#FFFBF700] px-0 pt-8 md:mb-12 md:px-4 md:pt-10"
>
  <div class="flex flex-col items-center text-center">
    <div class="mb-4 flex flex-row items-center justify-center gap-2 sm:gap-4 md:mb-6" data-animate="fade-up">
      <div class="w-[50px] min-[375px]:w-[60px] md:w-32 flex-shrink-0">
        <Image src={imgCuonNhatKy} alt="Diploma Icon" class="h-auto w-full drop-shadow-lg" />
      </div>
      <div class="flex flex-col items-start">
        <h2
          class="text-[#1336B3] text-[15px] min-[375px]:text-[17px] sm:text-xl font-black uppercase leading-tight md:text-[24px] lg:text-[42px] whitespace-nowrap md:mb-3 lg:mb-5"
        >
          Được tin tưởng & lựa chọn bởi
        </h2>
        <div class="mt-1.5 w-full max-sm:pr-2">
          <CommitmentBadge className="text-[11px] min-[375px]:text-[12.5px] sm:text-[15px] font-bold md:text-[32px] md:px-8 !from-[#F97316] !to-[#F59E0B] whitespace-nowrap px-2 py-1 md:py-2 w-full justify-center">
            HÀNG NGHÌN HỌC VIÊN TRÊN TOÀN QUỐC
          </CommitmentBadge>
        </div>
      </div>
    </div>

    <div class="max-w-3xl px-4 md:px-0 mx-auto" data-animate="fade-up">
      <p class="mx-auto max-w-[692px] text-[9px] font-medium leading-[1.2] tracking-normal text-[#373737] md:text-xl md:leading-relaxed text-center translate-x-0 md:translate-x-12">
        <Star className="inline-block mr-1.5 sm:mr-2 size-4 sm:size-5 text-[#373737] md:size-6 align-text-bottom mb-[2px] md:mb-[3px]" strokeWidth={3} />Sự tiến bộ và kết quả thực tế của người học là minh chứng rõ ràng nhất<br class="block md:hidden" /> cho chất lượng đào tạo của THE IELTS SPACE. Đó cũng là động lực để<br class="block md:hidden" /> chúng tôi không ngừng nâng chuẩn chương trình, cải tiến phương pháp<br class="block md:hidden" /> và hoàn thiện trải nghiệm học tập mỗi ngày.
      </p>
    </div>
  </div>
</div>
