---
import { IMAGES } from '@/lib/constants/images';
import { Image } from 'astro:assets';
import { Star } from 'lucide-react';
import CommitmentBadge from '../ui/CommitmentBadge';
import imgCuonNhatKy from '@/assets/images/img-hocba-tienganh-optimized/img-cuon-nhat-ky.webp';
---

<div
  class="w-full pb-6 bg-[#E2E9FF] px-0 pt-6 md:pb-12 md:px-4 md:pt-10"
>
  <div class="w-full flex flex-col items-center text-center relative">
    <div class="mt-[25.65px] mb-2 flex flex-row items-center justify-center w-[372px] h-[127px] md:w-full md:h-auto md:mt-0 md:gap-4 md:mb-6 relative" data-animate="fade-up">
      <div class="absolute left-[4px] top-[14px] w-[42px] h-[44px] md:static md:w-32 md:h-auto md:-translate-y-10 z-10 flex-shrink-0">
        <Image src={imgCuonNhatKy} alt="Diploma Icon" class="w-full h-full object-contain md:h-auto drop-shadow-lg" />
      </div>
      <div class="flex flex-col items-center justify-center w-full md:w-fit md:items-start z-0 md:mt-4">
        <div class="flex flex-col items-center justify-center w-full md:w-fit md:gap-[12px] md:items-start z-0">
          <h2
            class="text-[#072899] text-[15px] min-[375px]:text-[17px] sm:text-xl font-black uppercase leading-tight whitespace-nowrap md:w-fit md:h-fit text-center md:text-left md:text-[46px] md:leading-[64px] md:tracking-normal"
          >
            Được tin tưởng & lựa chọn bởi
          </h2>
          <div class="mt-0 w-full flex justify-center md:justify-start">
            <CommitmentBadge className="text-[11px] min-[375px]:text-[12.5px] sm:text-[15px] font-bold md:text-[32px] md:leading-none !from-[#F97316] !to-[#FFCF5A] whitespace-nowrap px-4 py-1 md:w-[721px] md:h-[59px] md:gap-[10px] md:px-[13px] md:py-[18px] md:rounded-[8px] justify-center inline-flex items-center">
              HÀNG NGHÌN HỌC VIÊN TRÊN TOÀN QUỐC
            </CommitmentBadge>
          </div>
        </div>

        <div class="mt-2 md:mt-4 max-w-3xl px-4 md:px-0 flex justify-center md:justify-start w-full">
          <p class="mx-auto md:mx-0 w-[325.92px] h-[46px] md:max-w-[721px] md:w-full md:h-auto text-[9px] font-medium leading-[120%] tracking-normal text-[#373737] md:text-[20px] md:leading-[120%] text-center font-['SVN-Gilroy'] align-bottom">
            <Star className="inline-block mr-[4.93px] w-[14px] h-[14px] text-[#373737] md:w-6 md:h-6 align-text-bottom mb-[2px] md:mb-[3px]" strokeWidth={3} />Sự tiến bộ và kết quả thực tế của người học là minh chứng rõ ràng nhất<br />cho chất lượng đào tạo của THE IELTS SPACE. Đó cũng là động lực để<br />chúng tôi không ngừng nâng chuẩn chương trình, cải tiến phương pháp<br />và hoàn thiện trải nghiệm học tập mỗi ngày.
          </p>
        </div>
      </div>
  </div>
</div>
