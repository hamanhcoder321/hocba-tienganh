---
import { IeltsRoadmap } from './DetectionSlider';

// Dữ liệu nội dung 6 mốc lộ trình.
const roadmapData = [
  {
    id: 'khoi-dong',
    score: '3.0+',
    title: 'KHỞI ĐỘNG',
    subtitle: '0 - 3.0+ IELTS',
    color: '#014AEF',
    icon: 'BookOpen',
    details: [
      'Dành cho những bạn mất gốc hoặc gần như chưa có nền tảng tiếng Anh. Vốn từ, ngữ pháp, phát âm và khả năng nghe nói còn rất hạn chế.',
      'The IELTS SPACE sẽ giúp bạn xây lại nền tảng tiếng Anh từ đầu: làm quen và phát âm đúng các âm cơ bản, củng cố từ vựng', 
      '- ngữ pháp thông dụng và hình thành phản xạ nghe nói.',
      'Bạn có thể nghe nhận diện các thông tin quen thuộc, đọc hiểu đoạn văn ngắn, viết được đoạn 5-7 câu có liên kết và trả lời Speaking Part 1 bằng câu hoàn chỉnh.'
    ]
  },
  {
    id: 'cat-canh',
    score: '4.0+',
    title: 'CẤT CÁNH',
    subtitle: '3.0 - 4.0+ IELTS',
    color: '#A4BCF9',
    icon: 'Box',
    details: [
      '[Nội dung mẫu] Dành cho học viên đã có nền tảng cơ bản nhưng chưa vững, cần củng cố và hệ thống hóa kiến thức để bắt đầu làm quen với các kỹ năng IELTS.',
      'Tập trung xây dựng nền tảng từ vựng và ngữ pháp học thuật, làm quen với cấu trúc câu phức tạp và các chủ đề thường gặp trong kỳ thi.',
      'Phát triển kỹ năng nghe hiểu các đoạn hội thoại dài hơn, đọc hiểu bài văn trung bình, và bắt đầu viết các đoạn văn nghị luận cơ bản.'
    ]
  },
  {
    id: 'tang-toc',
    score: '5.0+',
    title: 'TĂNG TỐC',
    subtitle: '4.0 - 5.0+ IELTS',
    color: '#83DDF6',
    icon: 'Rocket',
    details: [
      '[Nội dung mẫu] Dành cho học viên đã nắm vững ngữ pháp, có vốn từ khá và bắt đầu đi sâu vào luyện tập 4 kỹ năng theo chuẩn format IELTS.',
      'Rèn luyện các chiến thuật làm bài thi, phân tích kỹ các dạng câu hỏi Reading & Listening, phát triển ý tưởng đa dạng cho Writing & Speaking.',
      'Mục tiêu đầu ra: Nghe hiểu các bài giảng học thuật, đọc các bài báo chuyên ngành, viết essay đúng cấu trúc và giao tiếp trôi chảy các chủ đề quen thuộc.'
    ]
  },
  {
    id: 'but-pha',
    score: '6.0+',
    title: 'BỨT PHÁ',
    subtitle: '5.0 - 6.0+ IELTS',
    color: '#FADE76',
    icon: 'TrendingUp',
    details: [
      '[Nội dung mẫu] Khóa học dành cho học viên mục tiêu đạt điểm khá, cần sự bứt phá về vốn từ vựng học thuật cao cấp và cấu trúc câu phức tạp.',
      'Tối ưu hóa thời gian làm bài, luyện tập chuyên sâu các dạng bài khó. Nâng cấp band điểm Speaking qua cách mở rộng ý và sử dụng idiom tự nhiên.',
      'Sửa lỗi chi tiết Writing Task 1 & 2, hướng tới lối viết súc tích, lập luận logic và mạch lạc.'
    ]
  },
  {
    id: 'vuon-xa',
    score: '7.0+',
    title: 'VƯƠN XA',
    subtitle: '6.0 - 7.0+ IELTS',
    color: '#FCA976',
    icon: 'Telescope',
    details: [
      '[Nội dung mẫu] Dành cho học viên hướng tới band điểm cao (7.0+). Tập trung vào sự tinh tế trong việc sử dụng ngôn ngữ và các chiến lược làm bài nâng cao.',
      'Luyện tập cường độ cao với các đề thi thật, phân tích chuyên sâu các lỗi sai thường gặp để tránh mất điểm đáng tiếc.',
      'Hoàn thiện kỹ năng phản biện trong Speaking và Writing, sử dụng từ vựng C1-C2 linh hoạt và chính xác.'
    ]
  },
  {
    id: 'chinh-phuc',
    score: '8.0+',
    title: 'CHINH PHỤC',
    subtitle: '7.0 - 8.0+ IELTS',
    color: '#F5876E',
    icon: 'Trophy',
    details: [
      '[Nội dung mẫu] Lớp học chuyên biệt dành cho các học viên hướng tới mức điểm xuất sắc (8.0+), chinh phục học bổng tại các trường đại học hàng đầu thế giới.',
      'Rèn luyện tư duy ngôn ngữ như người bản xứ, xử lý xuất sắc các chủ đề hóc búa nhất trong kỳ thi.',
      'Được hướng dẫn 1-1 bởi các chuyên gia IELTS hàng đầu, tinh chỉnh từng chi tiết nhỏ nhất trong Speaking và Writing để đạt điểm tối đa.'
    ]
  }
];
---

<section id="ielts-roadmap" class="relative overflow-hidden bg-[#F8FAFF] py-16 md:py-24">
  <div class="container mx-auto px-4 lg:px-8 max-w-[1200px]">
    <div class="text-center mb-12 md:mb-20 relative">
      {/* Decorative Icons */}
      <div class="absolute -top-6 left-4 md:-top-2 md:left-10 hidden md:block z-0">
        <div class="w-10 h-10 md:w-12 md:h-12 rounded-full border border-dashed border-[#5E87F9] flex items-center justify-center text-[#5E87F9] bg-transparent">
          <span class="text-lg md:text-xl font-bold">?</span>
        </div>
      </div>
      <div class="absolute top-12 left-16 md:top-16 md:left-32 hidden md:block text-[#5E87F9] opacity-30 z-0">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
      </div>
      <div class="absolute top-2 right-4 md:top-4 md:right-16 hidden md:block text-[#5E87F9] opacity-30 z-0">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
      </div>

      <h2 class="mb-4 relative z-10">
        <span class="block text-[16px] md:text-[22px] font-bold uppercase tracking-[0.15em] text-[#373737] mb-2 md:mb-3">
          CHƯƠNG TRÌNH HỌC TẬP TOÀN DIỆN
        </span>
        <span class="block text-[36px] md:text-[64px] font-black uppercase text-[#072899] leading-none tracking-tight">
          THE IELTS SPACE
        </span>
      </h2>
      <div class="flex items-center justify-center gap-3 mb-1 text-[#3659BB] relative z-10">
        <div class="w-10 md:w-20 h-[1px] bg-[#3659BB]/60"></div>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z"/>
        </svg>
        <div class="w-10 md:w-20 h-[1px] bg-[#3659BB]/60"></div>
      </div>
      <p class="max-w-[500px] mx-auto text-sm md:text-[15px] font-medium text-[#7a7a7a]">
        Hệ thống chương trình IELTS từ cơ bản đến nâng cao, được thiết kế khoa học để giúp bạn đạt được mục tiêu ngôn ngữ của mình.
      </p>
    </div>

    <IeltsRoadmap data={roadmapData} client:visible />
  </div>
</section>
