---
import { IeltsRoadmap } from './DetectionSlider';

// Dữ liệu nội dung 6 mốc lộ trình.
const roadmapData = [
  {
    id: 'khoi-dong',
    score: '3.0+',
    title: 'KHỞI ĐỘNG',
    subtitle: '0 - 3.0+ IELTS',
    color: '#014AEF',
    icon: 'BookOpen',
    details: [
      'Dành cho những bạn mất gốc hoặc gần như chưa có nền tảng tiếng Anh. Vốn từ, ngữ pháp, phát âm và khả năng nghe nói còn rất hạn chế.',
      'The IELTS SPACE sẽ giúp bạn xây lại nền tảng tiếng Anh từ đầu: làm quen và phát âm đúng các âm cơ bản, củng cố từ vựng', 
      '- ngữ pháp thông dụng và hình thành phản xạ nghe nói.',
      'Bạn có thể nghe nhận diện các thông tin quen thuộc, đọc hiểu đoạn văn ngắn, viết được đoạn 5-7 câu có liên kết và trả lời Speaking Part 1 bằng câu hoàn chỉnh.'
    ]
  },
  {
    id: 'cat-canh',
    score: '4.0+',
    title: 'CẤT CÁNH',
    subtitle: '3.0 - 4.0+ IELTS',
    color: '#638FEA', // Dịu hơn
    icon: 'Box',
    details: [
      'Dành cho những bạn đã có nền tảng tiếng Anh cơ bản nhưng kiến thức còn rời rạc và chưa biết cách tiếp cận IELTS bài bản. The IELTS Space sẽ giúp bạn xây nền đồng đều cả 4 kỹ năng và bắt đầu làm quen với tư duy bài thi IELTS. Bạn biết nghe để xác định ý chính và thông tin chi tiết, đọc và xử lý các dạng bài cơ bản, viết được bài Task 2 ở cấu trúc đơn giản và hoàn thành Speaking Part 1-2 với ý tưởng liên quan, phát âm dễ hiểu.'
    ]
  },
  {
    id: 'tang-toc',
    score: '5.0+',
    title: 'TĂNG TỐC',
    subtitle: '4.0 - 5.0+ IELTS',
    color: '#3BBFE6', // Dịu hơn
    icon: 'Rocket',
    details: [
      'Dành cho những bạn đã biết các dạng bài IELTS cơ bản nhưng khả năng xử lý bài và phát triển câu trả lời còn hạn chế. The IELTS Space sẽ giúp bạn nâng khả năng xử lý cả 4 kỹ năng và hoàn thiện cấu trúc bài thi IELTS. Bạn có thể nghe các nội dung học thuật đơn giản, đọc và xử lý câu hỏi cần suy luận, viết được Task 1 và Task 2 với bố cục - lập luận rõ ràng hơn, đồng thời hoàn thành đầy đủ Speaking Part 1-3 và biết mở rộng ý ở những câu hỏi khó.'
    ]
  },
  {
    id: 'but-pha',
    score: '6.0+',
    title: 'BỨT PHÁ',
    subtitle: '5.0 - 6.0+ IELTS',
    color: '#F4C842', // Dịu hơn
    icon: 'TrendingUp',
    details: [
      'Dành cho những bạn đã có nền tảng IELTS tương đối đầy đủ nhưng còn thiếu độ chính xác, tốc độ và sự ổn định để lên band 6.0.The IELTS Space sẽ giúp bạn hoàn thiện kỹ năng làm bài theo cấu trúc IELTS đầy đủ và kiểm soát tốt hơn những lỗi đang cản band. Bạn có thể xử lý Listening với nhiều giọng và thông tin ngầm định, Reading với câu hỏi suy luận và từ vựng học thuật; viết Task 1-2 đầy đủ với lập luận rõ ràng và giao tiếp tương đối trôi chảy cả 3 phần Speaking, kể cả những chủ đề ít quen thuộc.'
    ]
  },
  {
    id: 'vuon-xa',
    score: '7.0+',
    title: 'VƯƠN XA',
    subtitle: '6.0 - 7.0+ IELTS',
    color: '#FA9251', // Dịu hơn
    icon: 'Telescope',
    details: [
      'Dành cho những bạn đã có năng lực IELTS khá nhưng cần nâng độ chính xác, chiều sâu lập luận và khả năng xử lý các yêu cầu khó của bài thi. The IELTS Space sẽ giúp bạn nâng chất lượng bài làm từ ĐÚNG lên TỐT VÀ ỔN ĐỊNH. Bạn có thể xử lý tốc độ nói tự nhiên và thái độ người nói, đọc các văn bản học thuật khó trong giới hạn thời gian; phát triển Writing với lập luận sâu và đầy đủ hơn, sử dụng từ vựng linh hoạt; Speaking tự nhiên hơn, biết xử lý các câu hỏi trừu tượng và phát triển ý có chiều sâu.'
    ]
  },
  {
    id: 'chinh-phuc',
    score: '8.0+',
    title: 'CHINH PHỤC',
    subtitle: '7.0 - 8.0+ IELTS',
    color: '#F2694E', // Dịu hơn
    icon: 'Trophy',
    details: [
      'Dành cho những bạn đã có năng lực IELTS tốt nhưng khó vượt ngưỡng band cao do những lỗi tinh vi về độ chính xác, sắc thái và sự tự nhiên của ngôn ngữ. The IELTS Space sẽ giúp bạn tinh chỉnh năng lực ở mức độ cao trên từng tiêu chí chấm. Bạn có thể xử lý chính xác thông tin và sắc thái nghĩa phức tạp, đọc văn bản học thuật khó với tốc độ và độ chính xác cao; xây dựng bài viết có lập luận sâu, mạch lạc và ngôn ngữ linh hoạt; diễn đạt tự nhiên các ý tưởng phức tạp, trừu tượng với mức độ kiểm soát ngôn ngữ cao.'
    ]
  }
];
---

<section id="lo-trinh" class="relative overflow-hidden bg-[#F8FAFF] py-16 md:py-14">
  <div class="container mx-auto px-4 lg:px-8 max-w-[1200px]">
    <div class="text-center mb-6 md:mb-10 relative">
      {/* Decorative Icons */}
      <div class="absolute -top-6 left-4 md:-top-2 md:left-10 hidden md:block z-0 opacity-40">
        <div class="w-10 h-10 md:w-12 md:h-12 rounded-full border border-dashed border-[#5E87F9] flex items-center justify-center text-[#5E87F9] bg-transparent">
          <span class="text-lg md:text-xl font-bold">?</span>
        </div>
      </div>
      <div class="absolute top-12 left-16 md:top-16 md:left-32 hidden md:block text-[#5E87F9] opacity-30 z-0">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
      </div>
      <div class="absolute top-2 right-4 md:top-4 md:right-16 hidden md:block text-[#5E87F9] opacity-30 z-0">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
      </div>

      <h2 class="mb-4 relative z-10">
        <span class="block text-[16px] md:text-[24px] font-extrabold uppercase tracking-[1.2px] text-[#373737] mb-2 md:mb-3 md:leading-[32px]">
          CHƯƠNG TRÌNH HỌC TẬP TOÀN DIỆN
        </span>
        <span class="block text-[36px] md:text-[60px] font-extrabold uppercase text-[#072899] md:leading-[60px] tracking-normal">
          THE IELTS SPACE
        </span>
      </h2>
      <div class="flex items-center justify-center gap-3 mb-1 text-[#3659BB] relative z-10">
        <div class="w-10 md:w-20 h-[1px] bg-[#3659BB]/60"></div>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z"/>
        </svg>
        <div class="w-10 md:w-20 h-[1px] bg-[#3659BB]/60"></div>
      </div>
      <p class="max-w-[633px] mx-auto text-sm md:text-[18px] font-normal text-[#7a7a7a] md:leading-[28px] tracking-normal">
        Hệ thống chương trình IELTS từ cơ bản đến nâng cao, được thiết kế khoa học để giúp bạn đạt được mục tiêu ngôn ngữ của mình.
      </p>
    </div>

    <IeltsRoadmap data={roadmapData} client:visible />
  </div>
</section>
