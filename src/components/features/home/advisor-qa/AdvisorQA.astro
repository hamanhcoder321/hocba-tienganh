---
import hocbaQAImg from '@/assets/images/home/hocba-qa.png';
import IconMb from '@/assets/images/home/icon-maybay.png';
import QAAccordion from '@/components/features/home/advisor-qa/QAAccordion.astro';
import CommitmentBadge from '@/components/features/home/ui/CommitmentBadge';
import { Image } from 'astro:assets';
import imgGiaiDapCoVan from '@/assets/images/img-hocba-tienganh-optimized/img-giai-dap-co-van.webp';
import iconHoiCham from '@/assets/images/img-hocba-tienganh-optimized/icon-hoi-cham.webp';

const qaData = [
  {
    id: 'item-1',
    question: '<span class="hidden md:inline">1. </span>Lộ trình học tại THE IELTS SPACE như thế nào?',
    answer:
      'Lộ trình tại THE IELTS SPACE được xây dựng theo năng lực đầu vào và <br class="hidden md:block" /> mục tiêu band của từng học viên, tập trung vào đúng kiến thức, kỹ năng <br class="hidden md:block" /> và dạng bài còn yếu. Kết hợp giữa giảng dạy trên lớp, luyện tập trên LMS <br class="hidden md:block" /> E-Power, AI phân tích dữ liệu và mentor theo sát, THE IELTS SPACE giúp <br class="hidden md:block" /> học viên học đúng trọng tâm, cải thiện liên tục và rút ngắn thời gian <br class="hidden md:block" /> chinh phục mục tiêu IELTS.',
  },
  {
    id: 'item-2',
    question:
      '<span class="hidden md:inline">2. </span>THE IELTS SPACE có cam kết chất lượng đầu ra <br class="hidden md:block" /> không?',
    answer:
      'Chắc chắn rồi! ^^ The IELTS Space cam kết đầu ra bằng văn bản, rõ ràng theo từng khóa học và mục tiêu band. Nếu học viên đi theo đúng lộ trình  mà vẫn chưa đạt kết quả cam kết, The IELTS Space sẽ hỗ trợ học lại miễn phí trong vòng 2 năm!',
  },
  {
    id: 'item-3',
    question: '<span class="hidden md:inline">3. </span>Một lớp tại THE IELTS SPACE có bao nhiêu học viên?',
    answer:
      'Quy mô lớp được kiểm soát để giáo viên có thể theo sát tiến độ, tương tác và chất lượng bài làm của từng học viên. Mỗi lớp chỉ từ 8-12 học viên thôi bạn nhé ^^',
  },
  {
    id: 'item-4',
    question: '<span class="hidden md:inline">4. </span>Không theo kịp lớp học thì sao?',
    answer:
      'Ngoài giờ học với giáo viên, học viên được mentor học thuật theo sát, hỗ trợ giải đáp kiến thức, chữa bài, nhắc tiến độ. Hệ thống LMS E-Power cũng cho phép học viên luyện tập, định hướng cải thiện và theo dõi kết quả bất cứ lúc nào.',
  },
  {
    id: 'item-5',
    question: '<span class="hidden md:inline">5. </span>AI có đảm bảo chính xác không?',
    answer:
      'AI tại The IELTS Space không tự tạo nội dung thiếu kiểm soát. Bài tập được lựa chọn từ kho học liệu do đội ngũ giáo viên nghiên cứu và kiểm duyệt; AI chỉ sử dụng dữ liệu học tập để phân phối nội dung phù hợp với điểm yếu của từng học viên.',
  },
];
---

<section
  id="advisor-qa"
  class="relative mx-auto min-h-[900px] w-full max-w-[1493px] bg-[linear-gradient(180deg,rgba(255,251,247,0)_0%,#FFF7EF_31.25%,rgba(255,249,249,0)_100%)] md:min-h-0"
>
  <div class="relative z-10 mx-auto w-full px-[16px] py-[24px] md:max-w-[1212px] md:px-9 md:py-0 lg:px-0">
    <div class="mb-[28px] md:mb-7">
      <div class="flex items-center gap-1 md:gap-2">
        <Image src={iconHoiCham} alt="?" class="h-16 w-16 translate-y-[6px] object-contain md:h-24 md:w-24" />
        <div>
          <h2 class="py-1 text-[22px] font-black uppercase text-[#1336B3] md:py-2 md:text-[36px] lg:text-[42px]">
            GIẢI ĐÁP 1:1
          </h2>
          <CommitmentBadge
            className="mt-1 inline-block rounded-md !from-[#F97316] !to-[#F59E0B] px-3 py-1 text-[16px] font-bold sm:px-4 md:mt-2 md:text-[32px]"
          >
            CÙNG CỐ VẤN HỌC TẬP
          </CommitmentBadge>
        </div>
      </div>
    </div>
    <div class="flex flex-col items-center gap-[28px] md:gap-8 lg:flex-row">
      <div class="w-full lg:w-[55%]">
        <QAAccordion {qaData} />
      </div>
      <div class="relative w-full lg:w-[45%]">
        <!-- <div class="absolute top-0 translate-x-1/2 lg:-top-20 lg:right-1/2">
          <Image
            src={IconMb}
            alt="Icon may bay"
            width={87}
            height={54}
            class="h-auto w-[58px] object-contain md:w-[87px]"
          />
        </div> -->
        <Image src={imgGiaiDapCoVan} alt="Advisor QA" class="h-auto w-full object-contain" />
      </div>
    </div>
  </div>
</section>
