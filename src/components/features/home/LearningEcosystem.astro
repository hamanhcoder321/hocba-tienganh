---
import { Image } from 'astro:assets';
import { IMAGES } from '@/lib/constants/images';
import imgChugaMentor from '@/assets/images/img-hocba-tienganh/img-chuga-mentor.png';
import imgLoiNhanMentor from '@/assets/images/img-hocba-tienganh/img-loi-nhan-thong-bao-mentor.png';
import imgNhacNho from '@/assets/images/img-hocba-tienganh/img-nhac-nho.png';
import imgTenLua from '@/assets/images/img-hocba-tienganh/icon-tenlua.png';

const features = [
  {
    title: 'HIỂU NGƯỜI HỌC',
    subtitle: 'PACE ASSESSMENT',
    description: 'Bài trắc nghiệm giúp bạn hiểu rõ phong cách học tập và khả năng tiếp thu ngôn ngữ',
  },
  {
    title: 'HỌC HIỆU QUẢ',
    subtitle: 'SPACE LOOP',
    description: 'Chu trình học tập vòng xoắn, liên tục theo dõi - phản hồi - điều chỉnh để tiến bộ',
  },
  {
    title: 'HỌC ĐÚNG CÁCH',
    subtitle: 'PHƯƠNG PHÁP SPACE',
    description: 'Phương pháp phát triển tư duy đa chiều, hình thành 7 năng lực học tập cốt lõi',
  },
  {
    title: 'HỌC THÔNG MINH',
    subtitle: 'LMS E-SPACE',
    description: 'Nền tảng học tập thông minh kết hợp báo cáo AI và đề xuất phù hợp',
  },
];
---

<section id="learning-ecosystem" class="mx-auto max-w-[1232px] bg-white py-6 md:py-16 overflow-hidden">
  <div class="mx-auto px-4">
    <div class="mb-12 flex flex-col text-center">
      <div class="relative mx-auto max-w-4xl">
        <div class="absolute top-2 -left-4 sm:-left-8 md:top-6 md:-left-28 lg:top-8 lg:-left-36 z-10 pointer-events-none">
          <Image
            width={160}
            height={160}
            densities={[1, 2]}
            src={imgTenLua}
            alt="Rocket"
            class="h-auto w-[60px] drop-shadow-[0_15px_30px_rgba(0,0,0,0.2)] md:w-[130px] lg:w-[160px] transform -rotate-12"
          />
        </div>
        <div>
          <h2 class="mb-4 text-[26px] md:text-[50px] font-black uppercase leading-tight text-[#373737]">
            TỐI ƯU HÀNH TRÌNH HỌC<br />
            <span
              class="mt-2 md:mt-4 inline-block rounded-[16px] md:rounded-[20px] bg-gradient-to-r from-[#F97316] to-[#F59E0B] px-6 py-1 md:py-2 text-white text-[22px] md:text-[42px] shadow-lg relative"
            >
              & LUYỆN THI IELTS
            </span>
          </h2>
          <div class="mt-6 md:mt-8 flex items-center justify-center px-1 sm:px-2 md:px-0 w-full overflow-hidden">
            <p class="max-w-[850px] text-[11px] min-[375px]:text-[11.5px] sm:text-[13px] tracking-tight md:tracking-normal md:text-[22px] lg:text-[24px] font-bold text-[#555] leading-relaxed md:leading-snug text-center">
              {/* Desktop 3 lines */}
              <span class="hidden md:inline">
                Một hệ sinh thái học tập được nghiên cứu và thiết<br />
                kế hoàn toàn mới. Giúp mỗi người học tiến bộ theo<br />
                cách riêng của mình
              </span>
              {/* Mobile 2 lines */}
              <span class="inline md:hidden whitespace-nowrap">
                Một hệ sinh thái học tập được nghiên cứu và thiết kế hoàn toàn mới.<br />
                Giúp mỗi người học tiến bộ theo cách riêng của mình
              </span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- layout mobil: trượt ngang các khối -->
  <div class="md:hidden no-scrollbar relative flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-8 sm:px-9">
    {
      features.map((feature, index) => (
        <>
          <div class="flex w-[85%] flex-shrink-0 snap-center flex-col items-center">
            <div class="flex h-full w-full flex-col overflow-hidden rounded-[20px] shadow-[0_10px_30px_rgba(0,0,0,0.06)] bg-white">
              <div class="flex flex-col items-center justify-center bg-[#1336B3] py-4 text-center">
                <h3 class="text-[17px] font-black uppercase text-white">{feature.title}</h3>
                <p class="text-[#F3AC12] font-bold text-[12px] mt-1">{feature.subtitle}</p>
              </div>
              <div class="flex min-h-[120px] flex-grow items-center justify-center p-5 text-center bg-white">
                <p class="text-[13px] font-medium leading-relaxed text-[#555]">{feature.description}</p>
              </div>
            </div>
          </div>
          
          {index < features.length - 1 && (
            <div class="flex items-center justify-center flex-shrink-0">
              <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-[#F97316] to-[#F59E0B] shadow-md">
                <span class="text-xl font-bold leading-none text-white">+</span>
              </div>
            </div>
          )}
        </>
      ))
    }
  </div>

  <!-- layout laptop: vòng tròn 4 thẻ xoay quanh chú cú gaatrang -->
  <div class="hidden md:block relative w-full max-w-[1100px] mx-auto h-[600px] mt-10 mb-10">
    <!-- SVG đường quỹ đạo nền -->
    <div class="absolute inset-0 w-full h-full z-0 flex items-center justify-center pointer-events-none">
       <svg viewBox="0 0 1100 600" class="w-full h-full opacity-70">
         <ellipse cx="550" cy="300" rx="480" ry="220" fill="none" stroke="#8CA8F9" stroke-width="2" />
         <!-- Các chấm trang trí trên quỹ đạo -->
         <circle cx="70" cy="300" r="5" fill="#8CA8F9" />
         <circle cx="1030" cy="300" r="5" fill="#8CA8F9" />
         <circle cx="550" cy="80" r="8" fill="#8CA8F9" />
         <!-- Ngôi sao nhỏ -->
         <path d="M 120 180 L 125 195 L 140 195 L 128 205 L 132 220 L 120 210 L 108 220 L 112 205 L 100 195 L 115 195 Z" fill="#8CA8F9" class="scale-75 origin-center" />
         <path d="M 980 400 L 985 415 L 1000 415 L 988 425 L 992 440 L 980 430 L 968 440 L 972 425 L 960 415 L 975 415 Z" fill="#8CA8F9" class="scale-75 origin-center" />
         <path d="M 1020 80 L 1025 95 L 1040 95 L 1028 105 L 1032 120 L 1020 110 L 1008 120 L 1012 105 L 1000 95 L 1015 95 Z" fill="#8CA8F9" class="scale-100 origin-center" />
       </svg>
    </div>

    <!-- Chú cú ở trung tâm -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10 w-[300px] flex justify-center">
       <!-- Bóng đổ dưới chân -->
       <div class="absolute bottom-1 left-1/2 -translate-x-1/2 w-[160px] h-[14px] bg-black/60 rounded-[100%] blur-md z-0"></div>
       <Image src={IMAGES.home.imgGatrang} alt="Gatrang Owl" class="w-[260px] h-auto relative z-10 drop-shadow-lg" />
    </div>

    {
      [
        { feature: features[0], classes: "top-[30px] left-[20px]" },
        { feature: features[2], classes: "bottom-[30px] left-[20px]" },
        { feature: features[1], classes: "top-[30px] right-[20px]" },
        { feature: features[3], classes: "bottom-[30px] right-[20px]" }
      ].map(({ feature, classes }) => (
        <div class={`absolute w-[310px] z-20 flex flex-col overflow-hidden rounded-[20px] shadow-[0_15px_40px_rgba(0,0,0,0.06)] bg-white transition-transform duration-300 hover:scale-105 ${classes}`}>
          <div class="flex flex-col items-center justify-center bg-[#1336B3] py-4 text-center">
             <h3 class="text-[17px] font-black uppercase text-white">{feature.title}</h3>
             <p class="text-[#F3AC12] font-bold text-[12px] mt-1">{feature.subtitle}</p>
          </div>
          <div class="flex min-h-[120px] flex-grow items-center justify-center p-5 text-center bg-white">
             <p class="text-[13px] font-medium leading-relaxed text-[#555]">{feature.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- Khối Mentor (Căn giữa - full with) -->
<section class="w-full bg-[#0835C3] mt-12 py-16 overflow-hidden flex flex-col items-center">
  <div class="mb-10 px-1 sm:px-4 text-center w-full overflow-hidden">
    <h2 class="text-[15.5px] sm:text-[20px] tracking-tight md:tracking-normal whitespace-nowrap md:whitespace-normal font-black uppercase text-white md:text-[36px] drop-shadow-md">
      MỖI BƯỚC ĐI ĐỀU CÓ NGƯỜI ĐỒNG HÀNH
      <svg class="w-4 h-4 sm:w-5 sm:h-5 md:w-8 md:h-8 text-[#FF7A00] inline-block -mt-1 md:-mt-3 ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z" /></svg>
    </h2>
  </div>
  <div id="mentor-content" class="px-2 sm:px-4 flex justify-center w-full overflow-visible">
    <div class="group relative w-[55%] sm:w-[65%] md:w-full max-w-[550px] mt-4 md:mt-0">
      <div
        class="relative z-10 overflow-hidden rounded-[16px] md:rounded-[24px] bg-[#F48220] p-2 md:p-5 transition-all duration-500 shadow-xl group-hover:-translate-y-2 group-hover:bg-[#F69A45] group-hover:shadow-[0_20px_40px_rgba(244,130,32,0.4)]"
      >
        <div class="relative z-10 overflow-hidden max-sm:!h-auto">
          <h3
            class="rounded-xl md:rounded-2xl border-[2px] border-white/90 py-2 px-1 md:py-3 md:px-4 text-center text-[12px] sm:text-[14px] md:text-[26px] font-black uppercase text-white leading-[1.3] shadow-sm transition-all duration-500"
          >
            Mentor học thuật 1-1 <br /> BỔ TRỢ 24/7
          </h3>
          <div class="mt-2 md:mt-4 overflow-hidden rounded-xl md:rounded-2xl bg-white pt-2 md:pt-4 px-1 md:px-2 shadow-inner">
            <Image
              src={IMAGES.home.mentorImg}
              alt="Academic Mentor"
              class="h-auto w-full object-contain transform transition-transform duration-700 group-hover:scale-105"
            />
          </div>
        </div>
      </div>

      {/* Owl on the left */}
      <div
        class="pointer-events-none absolute -bottom-4 -left-[30%] sm:-left-[25%] z-20 block transition-all delay-100 duration-700 lg:-bottom-8 lg:-left-[180px] lg:-translate-x-10 lg:opacity-0 lg:group-hover:translate-x-0 lg:group-hover:opacity-100"
      >
        <Image
          src={imgChugaMentor}
          alt="Mentor Owl"
          class="h-auto w-[75px] sm:w-[100px] drop-shadow-[0_20px_50px_rgba(0,0,0,0.3)] md:w-[160px] lg:w-[280px]"
        />
      </div>

      {/* Large feedback on top right */}
      <div
        class="pointer-events-none absolute -right-[40%] sm:-right-[35%] top-[20%] md:top-[35%] z-20 block transition-all delay-100 duration-700 xl:top-8 xl:-right-[350px] xl:translate-x-10 xl:opacity-0 xl:group-hover:translate-x-0 xl:group-hover:opacity-100"
      >
        <Image
          src={imgLoiNhanMentor}
          alt="Mentor Feedback"
          class="h-auto w-[135px] sm:w-[165px] drop-shadow-[0_20px_50px_rgba(0,0,0,0.3)] md:w-[350px] xl:w-[450px]"
        />
      </div>

      {/* Small reminder on bottom right */}
      <div
        class="pointer-events-none absolute bottom-4 sm:bottom-6 -right-[25%] sm:-right-[20%] z-20 block transition-all delay-200 duration-500 xl:-bottom-4 xl:-right-[220px] xl:translate-y-4 xl:opacity-0 xl:group-hover:translate-y-0 xl:group-hover:opacity-100"
      >
        <Image src={imgNhacNho} alt="Reminder" class="h-auto w-[85px] sm:w-[110px] drop-shadow-xl md:w-[190px] xl:w-[320px]" />
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const mentorEl = document.getElementById('mentor-content');
    if (mentorEl) {
      const observer = new ResizeObserver((entries) => {
        for (let entry of entries) {
          if (entry.contentRect.height > 0) {
            mentorEl.style.height = entry.contentRect.height + 'px';
            observer.disconnect();
          }
        }
      });
      observer.observe(mentorEl);
    }
  });
</script>
