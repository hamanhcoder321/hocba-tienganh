---
import { Image } from 'astro:assets';
import { IMAGES } from '@/lib/constants/images';
import imgChugaMentor from '@/assets/images/img-hocba-tienganh-optimized/img-chuga-mentor.webp';
import imgLoiNhanMentor from '@/assets/images/img-hocba-tienganh-optimized/img-loi-nhan-thong-bao-mentor.webp';
import imgNhacNho from '@/assets/images/img-hocba-tienganh-optimized/img-nhac-nho.webp';
import imgTenLua from '@/assets/images/img-hocba-tienganh-optimized/icon-tenlua.webp';
import imgPaceAssessment from '@/assets/images/img-hocba-tienganh-optimized/img-pace-assessment.webp';
import imgSpaceLoop from '@/assets/images/img-hocba-tienganh-optimized/img-spaceloop.webp';
import imgPhuongPhapSpace from '@/assets/images/img-hocba-tienganh-optimized/img-phuong-phap-space.webp';
import imgLmsESpace from '@/assets/images/img-hocba-tienganh-optimized/img-lms-e-space.webp';

const features = [
  {
    title: 'HIỂU NGƯỜI HỌC',
    subtitle: 'PACE ASSESSMENT',
    description: 'Bài trắc nghiệm giúp bạn hiểu rõ phong cách học tập và khả năng tiếp thu ngôn ngữ',
    image: imgPaceAssessment
  },
  {
    title: 'HỌC HIỆU QUẢ',
    subtitle: 'SPACE LOOP',
    description: 'Chu trình học tập vòng xoắn, liên tục theo dõi - phản hồi - điều chỉnh để tiến bộ',
    image: imgSpaceLoop
  },
  {
    title: 'HỌC ĐÚNG CÁCH',
    subtitle: 'PHƯƠNG PHÁP SPACE',
    description: 'Phương pháp phát triển tư duy đa chiều, hình thành 7 năng lực học tập cốt lõi',
    image: imgPhuongPhapSpace
  },
  {
    title: 'HỌC THÔNG MINH',
    subtitle: 'LMS E-SPACE',
    description: 'Nền tảng học tập thông minh kết hợp báo cáo AI và đề xuất phù hợp',
    image: imgLmsESpace
  },
];
---

<section id="learning-ecosystem" class="mx-auto max-w-[1232px] bg-white py-6 md:py-16 overflow-hidden">
  <div class="mx-auto px-4">
    <div class="mb-12 flex flex-col text-center">
      <div class="relative mx-auto max-w-4xl">
        <div class="absolute top-[40%] md:top-[15%] lg:top-[30%] -translate-y-1/2 -left-3 sm:left-0 md:-left-[10px] lg:left-0 xl:left-[10px] z-10 pointer-events-none">
          <Image
            width={240}
            height={240}
            densities={[1, 2]}
            src={imgTenLua}
            alt="Rocket"
            class="h-auto w-[80px] drop-shadow-[0_15px_30px_rgba(0,0,0,0.2)] md:w-[150px] lg:w-[190px] xl:w-[220px]"
          />
        </div>
        <div>
          <h2 class="mb-4 text-[26px] md:text-[42px] uppercase leading-tight md:leading-[64px] text-[#373737]" style="font-weight: 1000;">
            TỐI ƯU HÀNH TRÌNH HỌC
            <span
              class="mt-2 md:mt-4 inline-block rounded-[16px] md:rounded-[20px] px-6 md:px-24 py-1 md:py-2 text-white text-[22px] md:text-[38px] md:leading-[64px] shadow-lg relative"
              style="font-weight: 1000; background: linear-gradient(90.35deg, #F97316 4.83%, #FFCF5A 114.24%);"
            >
              & LUYỆN THI IELTS
            </span>
          </h2>
          <div class="mt-6 md:mt-8 flex items-center justify-center px-1 sm:px-2 md:px-0 w-full relative">
            <div class="relative inline-block text-center max-w-[850px] md:translate-x-6">
              <!-- 5-point star icon (Figma: filled blue star left of subtitle) -->
              <svg class="hidden md:block absolute -left-10 top-1 w-8 h-8" viewBox="0 0 24 24" fill="#8CA8F9" xmlns="http://www.w3.org/2000/svg">
                <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26" />
              </svg>
              <p class="text-[11px] min-[375px]:text-[11.5px] sm:text-[13px] tracking-tight md:tracking-normal md:text-[24px] font-semibold text-[#555] leading-relaxed md:leading-[1.2] text-center">
                {/* Desktop 3 lines */}
                <span class="hidden md:inline align-bottom">
                  Một hệ sinh thái học tập được nghiên cứu và thiết<br />
                  kế hoàn toàn mới. Giúp mỗi người học tiến bộ theo<br />
                  cách riêng của mình
                </span>
                {/* Mobile 2 lines */}
                <span class="inline md:hidden whitespace-nowrap">
                  Một hệ sinh thái học tập được nghiên cứu và thiết kế hoàn toàn mới.<br />
                  Giúp mỗi người học tiến bộ theo cách riêng của mình
                </span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- layout mobil: trượt ngang các khối -->
  <div class="md:hidden no-scrollbar relative flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-8 sm:px-9">
    {
      features.map((feature, index) => (
        <>
          <div class="flex w-[85%] flex-shrink-0 snap-center flex-col items-center">
            <div class="flex h-full w-full flex-col overflow-hidden rounded-[20px] shadow-[0_10px_30px_rgba(0,0,0,0.06)] bg-white">
              <div class="flex flex-col items-center justify-center bg-[#1336B3] py-4 text-center">
                <h3 class="text-[17px] font-black uppercase text-white">{feature.title}</h3>
                <p class="text-[#FFCF5A] font-extrabold text-[16px] mt-1 leading-[147%] uppercase">{feature.subtitle}</p>
              </div>
              <div class="flex min-h-[120px] flex-grow items-center justify-center p-5 text-center bg-white">
                <p class="text-[13px] font-medium leading-relaxed text-[#373737]" set:html={feature.description}></p>
              </div>
            </div>
          </div>
          
          {index < features.length - 1 && (
            <div class="flex items-center justify-center flex-shrink-0">
              <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-[#F97316] to-[#F59E0B] shadow-md">
                <span class="text-xl font-bold leading-none text-white">+</span>
              </div>
            </div>
          )}
        </>
      ))
    }
  </div>

  <!-- layout laptop: vòng tròn 4 thẻ xoay quanh chú cú gaatrang -->
  <div class="hidden md:block relative w-full max-w-[1100px] mx-auto h-[600px] mt-20 mb-10">
    <!-- SVG đường quỹ đạo nền và trang trí -->
    <div class="absolute inset-0 w-full h-full z-0 flex items-center justify-center pointer-events-none">
       <svg viewBox="0 0 1100 600" class="w-full h-full overflow-visible">
         <defs>
           <linearGradient id="orbitGradient" x1="0%" y1="0%" x2="100%" y2="100%">
             <stop offset="0%" stop-color="#083AD4" />
             <stop offset="100%" stop-color="#3464F8" />
           </linearGradient>
         </defs>
         <!-- Ellipse quỹ đạo -->
          <svg width="1149" height="451" viewBox="0 0 1149 451" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path opacity="0.62" d="M718.081 0.00665797C738.671 -0.272111 749.707 8.07206 752.617 22.4057C753.947 22.4127 755.277 22.4343 756.606 22.4698C773.8 22.9855 793.922 24.5607 811.437 26.2167C910.911 35.6216 1029.58 57.1185 1102.64 111.661C1130.39 132.591 1150.54 161.977 1148.5 191.132C1142.86 271.986 1024.24 330.503 934.452 361.583C778.045 415.712 588.952 440.246 414.624 434.178C411.819 439.996 410.222 441.768 404.438 445.947C391.658 453.081 374.233 452.868 362.572 443.856C357.565 439.984 355.374 435.46 352.359 430.746C347.427 430.049 342.259 435.777 336.327 436.882C327.123 438.593 321.682 434.239 319.345 427.815C239.367 419.018 154.229 402.974 86.1721 368.88C46.4282 348.971 11.7558 320.689 2.29777 285.57C-6.24786 253.837 10.0114 219.597 35.0379 194.221C124.364 103.648 334.522 50.7427 481.903 33.4357C482.897 29.5169 484.343 26.3237 489.295 24.0785C492.235 22.7536 495.813 22.3568 499.225 22.9779C505.252 24.0536 507.874 26.6211 511 30.081C523.791 28.2747 541.341 26.8847 554.422 25.8425C583.2 23.5308 612.106 21.9624 641.085 21.1401C655.695 20.7596 677.704 21.2759 690.87 20.4343C692.886 8.69638 701.978 1.75822 718.081 0.00665797ZM691.188 25.7381C679.416 26.218 665.983 26.0005 654.036 26.1591C636.768 26.4441 619.528 27.0313 602.32 27.9196C582.544 28.9816 562.821 30.3754 543.158 32.0994C533.323 32.9756 520.982 34.5043 511.583 35.1078C507.697 41.4311 505.767 42.7078 496.42 44.1174C490.947 42.773 489.207 42.4704 485.223 39.2899L484.52 38.7381C484.382 38.6262 484.244 38.5137 484.107 38.4013C335.015 56.8897 129.968 106.325 39.374 199.039C15.9353 224.168 1.05793 254.694 9.70987 285.697C19.0034 318.997 53.3438 346.062 91.3641 364.721C152.485 394.714 225.335 410.163 296.683 419.731C304.064 420.722 312.795 421.146 319.888 422.507C325.005 416.555 331.607 413.884 340.775 417.935C345.344 419.955 347.613 424.909 352.649 424.976C356.91 418.83 357.335 415.406 365.058 410.756C373.013 406.956 380.434 405.148 390.316 406.697C398.204 407.928 405.162 411.391 409.641 416.308C413.796 420.845 414.448 424.154 415.326 429.238C427.895 428.969 441.057 429.822 453.721 429.865C484.208 429.999 514.666 429.329 545.032 427.859C682.424 420.319 821.876 397.329 944.843 352.1C1029.36 321.013 1144.52 261.979 1141.2 182.903C1140.01 154.35 1115.14 126.502 1086.36 107.763C1015.42 61.6565 910.526 41.8634 819.435 32.264C797.236 29.924 774.022 28.6886 751.936 27.3748C748.939 33.9862 745.267 38.7638 736.163 42.1047C728.548 44.8721 719.623 45.2248 711.476 43.0806C703.399 40.8909 696.856 36.3843 693.419 30.6382C692.548 29.1769 691.806 27.2812 691.188 25.7381Z" fill="url(#paint0_linear_1_973)"/>
            <defs>
            <linearGradient id="paint0_linear_1_973" x1="582.836" y1="-5.03718" x2="565.887" y2="457.652" gradientUnits="userSpaceOnUse">
            <stop stop-color="#083AD4"/>
            <stop offset="1" stop-color="#3464F8"/>
            </linearGradient>
            </defs>
          </svg>

         <!-- Sparkle 1: Giữa-trái (ngoài cạnh trái card, trong gap giữa 2 card) -->
         <svg x="-30" y="150" width="40" height="40" viewBox="0 0 24 24" fill="#8CA8F9">
           <path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z" />
         </svg>

         <!-- Sparkle 2: Dưới-trái (dưới card Học Đúng Cách, bên trái ellipse) -->
         <svg x="40" y="400" width="36" height="36" viewBox="0 0 24 24" fill="#8CA8F9">
           <path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z" />
         </svg>
         <!-- Sparkle 4: Trên-phải lớn (ngoài góc trên-phải card HỌC HIỆU QUẢ) -->
         <svg x="1020" y="-80" width="52" height="52" viewBox="0 0 24 24" fill="#8CA8F9">
           <path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z" />
         </svg>
         <!-- Sparkle 5: Trên-phải nhỏ (cạnh sparkle lớn) -->
         <svg x="1050" y="-50" width="24" height="24" viewBox="0 0 24 24" fill="#8CA8F9" opacity="0.85">
           <path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z" />
         </svg>

         <!-- Sparkle 6: Giữa-phải (trên arc phải, trong gap giữa 2 card phải y=220-380) -->
         <svg x="1050" y="260" width="34" height="34" viewBox="0 0 24 24" fill="#8CA8F9">
           <path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z" />
         </svg>
       </svg>
    </div>

    <!-- Chú cú ở trung tâm -->
    <div class="absolute top-[33%] left-1/2 -translate-x-1/2 -translate-y-1/2 z-10 w-[300px] flex justify-center">
       <!-- Bóng đổ dưới chân (Giả lập độ mờ và đậm của Figma) -->
       <div class="absolute bottom-0 left-1/2 -translate-x-1/2 flex justify-center items-center z-0">
         <div class="absolute w-[222px] h-[21px] bg-[#6F7BA1] rounded-[100%] blur-[10px]"></div>
         <div class="absolute w-[160px] h-[12px] bg-[#6F7BA1] rounded-[100%] blur-[4px]"></div>
       </div>
       <Image src={IMAGES.home.imgGatrang} alt="Gatrang Owl" class="w-[260px] h-auto relative z-10 drop-shadow-lg" />
    </div>

    {
      [
        { feature: features[0], classes: "-top-[20px] left-[70px]" },
        { feature: features[2], classes: "bottom-[120px] left-[90px]" },
        { feature: features[1], classes: "-top-[50px] right-[110px]" },
        { feature: features[3], classes: "bottom-[110px] right-[90px]" }
      ].map(({ feature, classes }) => (
        <div class={`absolute w-[310px] h-[188px] z-20 group ${classes}`}>
          <div class="relative w-full transition-transform duration-700 group-hover:scale-105">
            
            <!-- Mặt trước (Nội dung) -->
            <div class="relative w-full h-full flex flex-col overflow-hidden rounded-[18px] shadow-[0_15px_40px_rgba(0,0,0,0.06)] bg-white border border-gray-100 transition-opacity duration-700 group-hover:opacity-0">
              <div class="relative w-full h-[88px] bg-[#1336B3]">
                 <div class="absolute top-[19.5px] left-[19.5px] w-[272px] h-[49px] flex flex-col items-center justify-center">
                   <h3 class="text-[24px] font-['SVN-Gilroy'] font-extrabold uppercase text-white leading-[25px] text-center tracking-normal">{feature.title}</h3>
                   <p class="text-[#FFCF5A] font-['SVN-Gilroy'] font-extrabold text-[16px] mt-1 leading-[25px] uppercase tracking-normal text-center">{feature.subtitle}</p>
                 </div>
              </div>
              <div class="flex min-h-[120px] flex-grow items-center justify-center p-5 text-center bg-white">
                 <p class="text-[15px] font-medium leading-relaxed text-[#373737]" set:html={feature.description}></p>
              </div>
            </div>

            <!-- Mặt sau (Ảnh) -->
            <div class="absolute inset-0 flex flex-col overflow-hidden rounded-[18px] shadow-[0_15px_40px_rgba(0,0,0,0.06)] bg-white border border-gray-100 opacity-0 transition-opacity duration-700 group-hover:opacity-100">
              <Image src={feature.image} alt={feature.title} class="w-full h-full object-contain p-2" />
            </div>

          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- Khối Mentor (Căn giữa - full with) -->
<section class="w-full mt-12 py-16 overflow-hidden flex flex-col items-center" style="background: linear-gradient(140.56deg, #072899 32.97%, #083AD4 57.51%, #04195C 82.05%);">
  <div class="mb-10 px-1 sm:px-4 text-center w-full overflow-visible">
    <h2 class="relative inline-block text-[15.5px] sm:text-[20px] tracking-tight md:tracking-normal whitespace-nowrap md:whitespace-normal font-black uppercase text-white md:text-[42px] md:leading-[64px] drop-shadow-md text-center" style="font-weight: 1000;">
      MỖI BƯỚC ĐI ĐỀU CÓ NGƯỜI ĐỒNG HÀNH
      <svg class="absolute -top-2 md:-top-4 -right-4 sm:-right-5 md:-right-8 w-4 h-4 sm:w-5 sm:h-5 md:w-8 md:h-8 text-[#FF7A00]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z" /></svg>
    </h2>
  </div>
  <div id="mentor-content" class="px-2 sm:px-4 flex justify-center w-full overflow-visible">
    <div class="group relative w-[55%] sm:w-[65%] md:w-full max-w-[550px] mt-4 md:mt-0">
      <div
        id="mentor-card"
        class="relative z-10 overflow-hidden rounded-[16px] md:rounded-[24px] shadow-[0_20px_40px_rgba(244,130,32,0.4)] p-2 md:p-5 transition-all duration-500 lg:from-[#F48220] lg:to-[#FDC959] lg:shadow-xl lg:group-hover:shadow-[0_20px_40px_rgba(244,130,32,0.4)]"
      >
        <div class="relative z-10 flex flex-col gap-2 md:gap-3 max-sm:!h-auto">
          <h3
            id="mentor-title"
            class="rounded-xl md:rounded-[18px] border-[2px] border-white/60 md:border-white/90 py-3 px-1 md:py-4 md:px-4 text-center text-[14px] md:text-[26px] font-black uppercase text-white leading-[1.3] shadow-sm transition-all duration-500 md:bg-[#F97316]"
          >
            Mentor học thuật 1-1 <br /> BỔ TRỢ 24/7
          </h3>
          <div class="overflow-hidden bg-white pt-2 md:pt-4 px-1 md:px-2 shadow-inner rounded-xl md:rounded-[18px] border-[2px] border-white/90">
            <Image
              src={IMAGES.home.mentorImg}
              alt="Academic Mentor"
              class="h-auto w-full object-contain transform transition-all duration-700 [clip-path:inset(0_18%_0_18%)] scale-[1.25] lg:[clip-path:inset(0_0_0_0)] lg:scale-100 lg:group-hover:[clip-path:inset(0_18%_0_18%)] lg:group-hover:scale-[1.25]"
            />
          </div>
        </div>
      </div>

      {/* Owl on the left */}
      <div
        class="pointer-events-none absolute -bottom-1 -left-[15%] sm:-left-[10%] md:-left-[50px] z-20 block transition-all delay-100 duration-700 lg:-bottom-8 lg:-left-[140px] lg:opacity-0 lg:group-hover:opacity-100"
      >
        <Image
          src={imgChugaMentor}
          alt="Mentor Owl"
          class="h-auto w-[65px] sm:w-[90px] drop-shadow-[0_20px_50px_rgba(0,0,0,0.3)] md:w-[140px] lg:w-[250px]"
        />
      </div>

      {/* Large feedback on top right */}
      <div
        class="pointer-events-none absolute -right-[40%] sm:-right-[35%] md:-right-[70px] top-[20%] md:top-[25%] z-20 block transition-all delay-100 duration-700 lg:top-[40px] lg:-right-[200px] lg:opacity-0 lg:group-hover:opacity-100 xl:top-[50px] xl:-right-[300px]"
      >
        <Image
          src={imgLoiNhanMentor}
          alt="Mentor Feedback"
          class="h-auto w-[135px] sm:w-[160px] drop-shadow-[0_20px_50px_rgba(0,0,0,0.3)] md:w-[240px] lg:w-[350px] xl:w-[400px]"
        />
      </div>

      {/* Small reminder on bottom right */}
      <div
        class="pointer-events-none absolute bottom-4 sm:bottom-6 -right-[30%] sm:-right-[25%] md:-right-[40px] z-20 block transition-all delay-200 duration-500 lg:bottom-[20px] lg:-right-[100px] lg:opacity-0 lg:group-hover:opacity-100 xl:-right-[290px]"
      >
        <Image src={imgNhacNho} alt="Reminder" class="h-auto w-[90px] sm:w-[115px] drop-shadow-xl md:w-[150px] lg:w-[190px] xl:w-[350px]" />
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const mentorEl = document.getElementById('mentor-content');
    if (mentorEl) {
      const observer = new ResizeObserver((entries) => {
        for (let entry of entries) {
          if (entry.contentRect.height > 0) {
            mentorEl.style.height = entry.contentRect.height + 'px';
            observer.disconnect();
          }
        }
      });
      observer.observe(mentorEl);
    }
  });
</script>

<style>
  /* Mobile: gradient cam vàng từ Figma */
  #mentor-card,
  #mentor-title {
    background: linear-gradient(270deg, #F97316 15.86%, #F3C650 100%);
  }
  /* Desktop (md+): giữ lại màu cũ */
  @media (min-width: 768px) {
    #mentor-card {
      background: linear-gradient(to bottom, #F48220, #FDC959);
    }
    #mentor-title {
      background: #F97316;
    }
  }
</style>
