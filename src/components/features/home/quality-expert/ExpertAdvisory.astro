---
import { Image } from 'astro:assets';
import bgRemoval from '@/assets/images/img-hocba-tienganh/bg_removal.png';
import coVanTienganh from '@/assets/images/img-hocba-tienganh/co-van-tienganh.png';
import soSachBanner from '@/assets/images/img-hocba-tienganh/so-sach-banner.png';
import CommitmentBadge from '@/components/features/home/ui/CommitmentBadge';
import imgMuiten from '@/assets/images/img-hocba-tienganh/img-muiten.png';

const comparisonData = [
  {
    problem: 'Biết rất nhiều từ vựng nhưng không biết cách triển khai',
    solution: 'Biết cách đào sâu vấn đề qua nhiều góc nhìn để phát triển ý'
  },
  {
    problem: 'Gặp đề lạ đầu óc rối tung, không biết làm',
    solution: 'Học theo chủ đề, biết cách tự phát triển và mở rộng với đề chưa từng gặp'
  },
  {
    problem: 'Khối lượng từ vựng và ngữ pháp phải học quá nhiều',
    solution: 'Học tập chọn lọc, ghi nhớ dễ dàng qua chủ đề, mind map, trò chơi trên LMS'
  },
  {
    problem: 'Không theo kịp tốc độ của lớp hoặc lớp học kéo chậm tiến độ bản thân dù cùng band',
    solution: 'Cá nhân hoá sâu trong cả lộ trình học, tận dụng điểm mạnh, phát huy điểm yếu'
  }
];

const expertBullets = [
  'Cựu giám khảo IELTS',
  'Cựu Trưởng khoa Tiếng Anh Trường Western Sydney University (trường đại học Top 22 tại Úc)',
  'Đồng tác giả nghiên cứu về ứng dụng công nghệ trong sửa lỗi và cải thiện kỹ năng Writing, đăng trên <strong>Cambridge English Research Notes.</strong>'
];
---

<section id="vi-sao-chon-ielts" class="relative bg-[#0B2C9E] py-12 md:py-20 overflow-hidden font-sans">

  <div class="container mx-auto px-4 md:px-8 max-w-[1250px] relative z-10">
    <!-- title section -->
    <div class="flex flex-col items-center text-center mb-4 md:mb-20">
      
      <!-- badge -->
      <div class="bg-white rounded-full px-5 py-2 mb-4 md:mb-6 shadow-md hidden md:inline-flex items-center justify-center gap-2">
        <svg class="w-4 h-4 md:w-5 md:h-5 text-[#4E7DFF] -mt-[1px]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <span class="text-[#0B2C9E] text-[11px] md:text-[14px] font-bold uppercase tracking-wider">VÌ SAO NÊN CHỌN THE IELTS SPACE?</span>
      </div>

      <!-- Main title block -->
      <div class="relative w-full max-w-[1150px] flex justify-center">
        
        <h2 class="text-white text-[18px] sm:text-[28px] md:text-[36px] lg:text-[42px] xl:text-[48px] font-black uppercase leading-[1.3] mb-6 md:mb-8 relative z-20 w-full text-center">
          <span class="inline-block md:whitespace-nowrap relative">
            <Image src={soSachBanner} alt="Sổ sách" class="!hidden md:!block absolute right-[100%] top-1/2 -translate-y-[80%] -translate-x-2 lg:-translate-x-4 w-20 md:w-24 lg:w-28 xl:w-36 h-auto object-contain drop-shadow-2xl z-10" />
            CẢI TIẾN PHƯƠNG PHÁP VÀ <span class="md:hidden">CHẮT LỌC</span>
            
            <!-- Hai ngôi sao 4 cánh bên phải -->
            <div class="absolute left-[100%] top-1/2 -translate-y-[40%] translate-x-8 md:translate-x-16 lg:translate-x-36 xl:translate-x-44 text-[#4E7DFF] hidden md:flex items-center opacity-90">
              <svg width="40" height="40" class="w-6 h-6 md:w-8 md:h-8 lg:w-10 lg:h-10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6 7.6 2.4-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"/></svg>
              <svg width="20" height="20" class="w-3 h-3 md:w-4 md:h-4 lg:w-5 lg:h-5 translate-y-2 md:translate-y-3 -translate-x-1" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6 7.6 2.4-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"/></svg>
            </div>
          </span> <br class="hidden md:block" />
          <span class="inline-block md:whitespace-nowrap relative">
            <span class="hidden md:inline">CHẮT LỌC</span> <span class="text-[#FF7A00]">TINH HOA GIÁO DỤC NGHÌN NĂM</span>
          </span>
        </h2>
      </div>

      <!-- Desktop: simple line -->
      <div class="hidden md:block w-20 h-[3px] bg-[#3B82F6] mb-6 rounded-full"></div>
      
      <!-- Mobile: line - star - line -->
      <div class="flex md:hidden items-center justify-center gap-3 mb-5 text-[#3B82F6]">
        <div class="w-8 h-[2px] bg-[#3B82F6] rounded-full"></div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6 7.6 2.4-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"/></svg>
        <div class="w-8 h-[2px] bg-[#3B82F6] rounded-full"></div>
      </div>

      <p class="text-white text-[16px] md:text-[20px] font-normal leading-[24px] hidden md:block md:leading-[28px] tracking-normal text-center">
        Khi những vấn đề của người học đã thực sự được nhìn nhận giải quyết
      </p>
    </div>

    <div class="mb-10 md:mb-16">
      <div class="hidden md:grid grid-cols-[1fr_auto_1fr] gap-3 mb-6">
        <div class="bg-[#F26522] rounded-full py-3.5 px-6 flex items-center justify-center gap-3 shadow-md">
          <div class="w-6 h-6 rounded-full bg-white flex items-center justify-center text-[#F26522]">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
          </div>
          <span class="text-white font-bold text-[15px] tracking-wide">NHỮNG VẤN ĐỀ NGƯỜI HỌC GẶP PHẢI</span>
        </div>
        <div class="w-8"></div>
        <div class="bg-[#1241C4] rounded-full py-3.5 px-6 flex items-center justify-center gap-3 shadow-md m-0">
          <div class="w-6 h-6 rounded-full bg-white flex items-center justify-center text-[#1241C4]">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6L9 17l-5-5"></path></svg>
          </div>
          <span class="text-white font-bold text-[15px] tracking-wide">THE IELTS SPACE GIẢI QUYẾT NHƯ THẾ NÀO?</span>
        </div>
      </div>

      <div class="flex flex-col gap-2 md:gap-3">
        {comparisonData.map((row) => (
          <div class="bg-white md:bg-transparent rounded-2xl md:rounded-none p-4 md:p-0 flex flex-col md:grid md:grid-cols-[1fr_auto_1fr] gap-3 md:gap-3 items-center shadow-sm md:shadow-none m-0">
            

            <div class="w-full md:bg-white md:rounded-[20px] md:p-5 flex items-center gap-4 md:min-h-[88px]">
              <div class="w-7 h-7 md:w-8 md:h-8 rounded-full bg-[#F26522] flex-shrink-0 flex items-center justify-center shadow-sm">
                <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
              </div>
              <p class="text-[#F26522] font-bold text-[14px] md:text-[15px] leading-snug flex-1">{row.problem}</p>
            </div>

            <!-- mobile -->
            <div class="w-full h-[1px] bg-gray-100 md:hidden my-1"></div>

            <!-- laptip -->
            <div class="hidden md:flex items-center justify-center flex-shrink-0 text-white/60">
              <Image src={imgMuiten} alt="Arrow" aria-hidden="true" class="w-[30px] h-auto animate-blink-delay" />
            </div>


            <div class="w-full md:bg-white md:rounded-[20px] md:p-5 flex items-center gap-4 md:min-h-[88px] m-0">
              <div class="w-7 h-7 md:w-8 md:h-8 rounded-full bg-[#1241C4] flex-shrink-0 flex items-center justify-center shadow-sm">
                <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6L9 17l-5-5"></path></svg>
              </div>
              <p class="text-[#02187B] font-bold text-[14px] md:text-[15px] leading-snug flex-1">{row.solution}</p>
            </div>

          </div>
        ))}
      </div>
    </div>

    <!-- Highlight Box -->
    <div class="bg-white rounded-[6px] md:rounded-[24px] pl-[60px] pr-[65px] md:py-6 md:px-[80px] lg:px-[100px] xl:px-[140px] h-[82px] md:h-auto md:min-h-[141px] flex items-center justify-center relative mb-16 md:mb-32 shadow-[0_10px_40px_rgba(0,0,0,0.12)] w-full max-w-[500px] md:max-w-[1280px] mx-auto mt-6 md:mt-0">
      <div class="absolute left-2 translate-x-0 md:left-[50px] lg:left-[60px] md:translate-x-0 top-1/2 -translate-y-1/2 w-[44px] h-[44px] md:w-[84px] md:h-[84px] bg-[#224BC9] rounded-full flex items-center justify-center z-20 shadow-lg">
        <svg class="w-5 h-5 md:w-[44px] md:h-[44px] text-white -mt-[1px] md:-mt-[2px] animate-blink-delay" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
      </div>
      <p class="text-center text-[#1E3A8A] text-[11px] sm:text-[10px] md:text-[26px] lg:text-[24px] font-medium w-full leading-[1.3] md:leading-[1.6] relative z-10">
        <span class="hidden md:block">
          Khác biệt của IELTS Space là tái thiết hoàn toàn cách người học chinh phục <br />
          tiếng Anh để giải quyết triệt để những vấn đề cố hữu. Hiệu quả không đến từ <br />
          may mắn, mà đến từ <span class="text-[#F26522] font-bold">phương pháp và con đường!</span>
        </span>
        <span class="md:hidden">
          Khác biệt của IELTS Space là tái thiết hoàn toàn cách người học chinh phục tiếng Anh để giải quyết triệt để những vấn đề cố hữu. Hiệu quả không đến từ may mắn, mà đến <br />từ <span class="text-[#F26522] font-bold">phương pháp và con đường!</span>
        </span>
      </p>
      <!-- Mascot Owl Desktop -->
      <Image src={bgRemoval} alt="Linh vật chú gà The IELTS Space" aria-hidden="true" class="hidden md:block w-40 lg:w-[170px] xl:w-[190px] absolute right-0 top-1/2 -translate-y-1/2 translate-x-[35%] object-contain drop-shadow-2xl z-20" />
      <!-- Mascot Owl Mobile -->
      <Image src={bgRemoval} alt="Linh vật chú gà The IELTS Space" aria-hidden="true" class="block md:hidden w-[75px] h-auto absolute right-0 bottom-0 translate-x-[25%] translate-y-[2%] object-contain drop-shadow-xl z-20" />
    </div>

    </div> <!-- Close top container -->

    <div id="xem-ho-so" class="w-full max-w-[1150px] mx-auto px-4 md:px-8 relative z-10 scroll-mt-20">
      <div class="flex flex-col items-center">
      <CommitmentBadge className="rounded-md md:rounded-[20px] px-2 py-1.5 sm:px-5 sm:py-2 md:py-4 md:px-10 mb-3 md:mb-4 inline-flex shadow-md max-w-full overflow-hidden text-center text-[11px] min-[375px]:text-[12.5px] sm:text-[16px] md:text-[26px] tracking-tight md:tracking-wide whitespace-nowrap">
        THE IELTS SPACE HÂN HẠNH GIỚI THIỆU
      </CommitmentBadge>
      <h3 class="text-white text-[18px] min-[375px]:text-[20px] sm:text-[24px] md:text-[36px] font-black uppercase mb-10 md:mb-16 text-center whitespace-nowrap md:whitespace-normal tracking-tight md:tracking-normal">CỐ VẤN CHUYÊN MÔN QUỐC TẾ</h3>
      

      <div class="relative w-full flex flex-col md:flex-row items-stretch justify-between bg-transparent min-h-[450px]">
        

        <div class="absolute inset-0 z-0 overflow-hidden" style="background-image: radial-gradient(rgba(255,255,255,0.2) 1px, transparent 1px); background-size: 24px 24px;"></div>

        <!-- mobile (top) -->
        <div class="md:hidden w-full flex justify-center mb-6 relative z-10 mt-[-20px]">
          <Image src={coVanTienganh} alt="Mr. Jackson Howard" class="w-full max-w-[280px] h-auto object-contain drop-shadow-xl relative z-10" />
        </div>

        <!-- left -->
        <div class="w-full md:w-[50%] lg:w-[48%] xl:w-[45%] bg-[#2E4387] rounded-2xl md:rounded-[24px] p-6 md:p-8 lg:p-10 z-20 relative shadow-2xl flex flex-col justify-center">
          <h4 class="text-white font-black text-[24px] md:text-[32px] mb-4 text-center md:text-left leading-tight drop-shadow-sm tracking-wide">Mr. Jackson Howard</h4>
          
          <div class="flex items-center justify-start gap-3 mb-4 md:mb-6 w-full">
            <svg class="hidden md:block w-7 h-7 md:w-8 md:h-8 text-[#FFC107] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path></svg>
            <span class="text-[#FFCF5A] font-bold text-[14px] md:text-[20px] text-left leading-[1.4]">
              Thạc sĩ TESOL - Đại học Công <br class="hidden sm:block" /> nghệ Sydney
            </span>
          </div>

          <ul class="text-white space-y-3 mb-8 md:mb-10 text-left text-[12.5px] md:text-[15px] font-normal leading-[1.6]">
            {expertBullets.map(bullet => (
              <li class="flex items-start gap-1.5 md:gap-3">
                <span class="text-white font-bold mt-[2px] flex-shrink-0 text-[14px] md:text-[18px]">•</span>
                <span set:html={bullet} class="opacity-95" />
              </li>
            ))}
          </ul>

          <div class="flex justify-center w-full mt-auto">
            <a href="#xem-ho-so" class="inline-block w-full sm:w-auto text-center bg-[#F97316] text-white font-bold text-[14px] md:text-[16px] py-3.5 px-8 rounded-full  tracking-wide">
              XEM HỒ SƠ CHUYÊN GIA
            </a>
          </div>
        </div>

        <div class="hidden md:flex w-[50%] lg:w-[45%] absolute bottom-0 right-0 z-10 justify-center items-end h-[110%] relative">
          <!-- Ngôi sao trang trí bên trái ảnh giáo viên -->
          <svg class="absolute top-[30%] left-[15%] w-5 h-5 text-[#8CA8F9]  z-20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L13.1 9.9L21 11L13.1 12.1L12 20L10.9 12.1L3 11L10.9 9.9L12 2Z" />
          </svg>
          <Image src={coVanTienganh} alt="Mr. Jackson Howard" class="w-full max-w-[400px] lg:max-w-[480px] h-auto object-contain object-bottom drop-shadow-[0_20px_20px_rgba(0,0,0,0.5)] relative z-10 origin-bottom" />
        </div>
        
      </div>
    </div>
    
  </div>
</section>

<style is:global>
  @keyframes blink-with-delay {
    0%, 65% { opacity: 1; }
    82% { opacity: 0.2; }
    100% { opacity: 1; }
  }
  .animate-blink-delay {
    animation: blink-with-delay 1.5s ease-in-out infinite;
  }
</style>