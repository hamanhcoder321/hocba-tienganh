---
import { IMAGES } from '@/lib/constants/images';
import { Image } from 'astro:assets';
import CommitmentBadge from '../ui/CommitmentBadge';

const commitments = [
  {
    id: '01',
    title: 'Cam kết đầu ra rõ ràng, không đạt học lại miễn phí',
    description:
      'Tự tin cam kết đầu ra với tư duy đề cao chất lượng hàng đầu. Học viên không đạt đầu ra được học lại miễn phí, mentor theo sát bổ trợ.',
  },
  {
    id: '02',
    title: 'Giáo trình nội bộ tự biên soạn độc quyền',
    description:
      'Giáo trình thiết kế mục tiêu đầu ra rõ ràng. Giúp học viên hiểu bản chất, hình thành tư duy, phát triển ý thay vì học thuộc công thức hay luyện đề máy móc.',
  },
  {
    id: '03',
    title: 'Học đủ - Đúng cấp độ với Mock Test chuẩn IELTS',
    description: 'Bài thi đầu vào được mô phỏng theo cấu trúc, thời lượng và tiêu chí chấm điểm của kỳ thi IELTS chính thức, giúp đánh giá chính xác năng lực hiện tại, xác định điểm mạnh - điểm yếu và làm cơ sở xây dựng lộ trình học phù hợp.',
  },
];
---

<section class="relative bg-[#F4F7FF] py-12 md:py-20">
  <div class="container relative mx-auto px-4 lg:px-8 max-w-[1300px]">
    <!-- tiêu đề -->
    <div class="relative flex flex-col items-center mb-10 md:mb-16">
      <div class="relative mb-4 flex flex-col md:flex-row items-center justify-center gap-4 md:gap-8">
        <Image
          src={IMAGES.home.iconShot2}
          alt="Biểu tượng giá trị cốt lõi The IELTS Space"
          width={124}
          height={124}
          class="hidden md:block h-auto w-20 md:w-28"
        />
        <div class="flex flex-col items-center md:items-start gap-2 sm:gap-4 text-center md:text-left">
          <h2
            class="text-[#1336B3] py-1 text-[22px] font-black uppercase leading-tight sm:py-2 md:text-[36px] lg:text-[42px]"
          >
            LẤY CHẤT LƯỢNG LÀM GIÁ TRỊ CỐT LÕI
          </h2>
          <CommitmentBadge>
            <span class="hidden md:inline">THE IELTS SPACE </span>CAM KẾT 100% ĐẦU RA
          </CommitmentBadge>
        </div>
      </div>
    </div>

    <!-- Bố cục 2 cột -->
    <div class="relative z-50 grid grid-cols-1 items-center lg:grid-cols-[55%_45%] xl:gap-10">
      
      <!--keft: 3 thẻ -->
      <div class="flex flex-col gap-4 sm:gap-6 order-2 lg:order-1 mt-8 lg:mt-0">
        {
          commitments.map((item) => (
            <div class="flex flex-col overflow-hidden rounded-[16px] bg-[#1132B4] text-white transition-all duration-300 hover:translate-x-2 sm:rounded-[20px] shadow-lg border border-[#2b4cda]">
              <div class="p-5 md:p-7">
                <div class="flex items-start gap-4 sm:gap-6">
                  <div class="flex flex-col items-center min-w-[50px] md:min-w-[70px]">
                    <Image src={IMAGES.home.QuoteIcon} alt="Biểu tượng cam kết chất lượng" class="mb-2 w-8 md:w-10 opacity-90" />
                    <span class="text-[#F3C650] text-[32px] font-black leading-none md:text-[48px]">
                      {item.id}
                    </span>
                  </div>
                  <div class="flex-1">
                    <h3 class="mb-2 text-[15px] font-black uppercase leading-tight text-[#F3C650] md:text-[22px]">
                      {item.title}
                    </h3>
                    <p
                      class="text-[13px] font-medium leading-relaxed text-gray-100 md:text-[15px]"
                      set:html={item.description}
                    />
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- phải: hình ảnh -->
      <div class="relative flex order-1 lg:order-2 justify-center lg:justify-end">
        <div class="relative w-full max-w-[650px] flex justify-center">
          <Image
            src={IMAGES.home.bannerThongBao}
            alt="The IELTS Space Quality"
            class="h-auto w-full object-contain relative z-10 [mask-image:linear-gradient(to_bottom,black_85%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,black_85%,transparent_100%)]"
          />
        </div>
      </div>
    </div>
  </div>
</section>
