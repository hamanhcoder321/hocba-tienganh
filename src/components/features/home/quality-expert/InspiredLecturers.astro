---

<section class="relative overflow-hidden bg-white py-8 md:py-12">
  {/* Background Glow Effects */}
  <div class="max-md:!hidden md:block absolute top-0 left-[-50px] w-[269px] h-[248px] rounded-[200px] pointer-events-none z-0" style="background: radial-gradient(70.71% 70.71% at 50% 50%, rgba(8, 58, 212, 0.4) 0%, rgba(8, 58, 212, 0) 70%);"></div>
  <div class="max-md:!hidden md:block absolute bottom-0 right-[-50px] w-[269px] h-[248px] rounded-[200px] pointer-events-none z-0" style="background: radial-gradient(70.71% 70.71% at 50% 50%, rgba(8, 58, 212, 0.4) 0%, rgba(8, 58, 212, 0) 70%);"></div>
  <div class="container relative z-10 mx-auto px-4">
    {/* Header Section */}
    <div class="relative mb-8 flex flex-col items-center justify-center sm:mb-12">
      <div class="flex items-center justify-center gap-3 md:gap-6">
        <h2
          class="flex flex-col items-center text-center text-[26px] font-black uppercase leading-tight tracking-tight md:flex-row md:gap-3 md:text-[36px] lg:text-[46px]"
        >
          <span class="text-[#434343]">150+ GIẢNG VIÊN</span>
          <span class="text-[#0A3BCE]">TRUYỀN CẢM HỨNG</span>
        </h2>
        <div class="relative w-[70px] flex-shrink-0 md:w-28">
          <Image
            src={soSachIcon}
            width={120}
            height={120}
            densities={[1, 2]}
            alt="Sổ sách icon"
            class="h-auto w-full object-contain"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 md:px-0">
    {/* <TeacherCarousel teachers={optimizedLecturers} client:visible /> */}
    <StaticTeacherCarousel client:visible />

    <div class="mt-12 hidden justify-center pb-8 md:flex">
      <a
        href={LECTURER_BASE_PATH}
        class="inline-block rounded-full bg-gradient-to-r from-[#F89C1E] to-[#E97607] px-8 py-3 text-sm font-bold text-white shadow-lg md:text-lg"
      >
        XEM HỒ SƠ CHUYÊN GIA
      </a>
    </div>
  </div>
</section>
