---

<section class="overflow-hidden bg-white py-8 md:py-12">
  <div class="container mx-auto px-4">
    {/* Header Section */}
    <div class="relative mb-8 flex flex-col items-center justify-center sm:mb-12">
      <div class="flex items-center justify-center gap-3 md:gap-6">
        <h2 class="flex flex-col md:flex-row md:gap-3 items-center text-center text-[26px] md:text-[36px] lg:text-[46px] font-black uppercase leading-tight tracking-tight">
          <span class="text-[#434343]">150+ GIẢNG VIÊN</span>
          <span class="text-[#0A3BCE]">TRUYỀN CẢM HỨNG</span>
        </h2>
        <div class="relative w-[70px] md:w-28 flex-shrink-0">
          <Image
            src={soSachIcon}
            width={120}
            height={120}
            densities={[1, 2]}
            alt="Sổ sách icon"
            class="h-auto w-full object-contain"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 md:px-0">
    {/* <TeacherCarousel teachers={optimizedLecturers} client:visible /> */}
    <StaticTeacherCarousel client:visible />
    
    <div class="mt-12 hidden md:flex justify-center pb-8">
      <a 
        href="/doi-ngu-giang-vien" 
        class="inline-block rounded-full bg-gradient-to-r from-[#F89C1E] to-[#E97607] px-8 py-3 text-sm md:text-lg font-bold text-white shadow-lg "
      >
        XEM HỒ SƠ CHUYÊN GIA
      </a>
    </div>
  </div>
</section>
