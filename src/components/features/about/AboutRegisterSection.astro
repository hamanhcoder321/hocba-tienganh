---
import { Image } from 'astro:assets';
import { IMAGES } from '@/lib/constants/images';
import AboutRegisterForm from './AboutRegisterForm';
import { DATA_VALUE } from '@/lib/constants/enums';

import imgDkTuVan from '@/assets/images/dktuvan.png';
import imgBook from '@/assets/images/book.png';

const { dataInput = DATA_VALUE.ABOUT , defaultObjective = '' } = Astro.props;
---

<div
  id="form-register-about"
  class="relative z-10 flex w-full items-center justify-center bg-[#0935C4] md:bg-[#E4EAFD] px-4 py-8 md:pt-10 md:pb-20 sm:p-8 sm:py-[80px]"
>
  <div class="relative h-fit w-full sm:w-fit md:mt-10 lg:mt-20">
    <div
      class="w-full bg-[#0935C4] text-white shadow-none md:shadow-lg sm:w-[620px] rounded-none sm:rounded-[20px] md:rounded-lg md:p-8 lg:w-[600px] lg:rounded-[28px] lg:p-10 xl:w-[700px] 3xl:w-[750px] 3xl:py-12"
    >
      <div class="w-full pb-6 pt-5 text-left pr-[110px] md:pr-0 sm:w-[450px]">
        <h2
          class="mb-2 text-[24px] font-extrabold capitalize leading-[1.3] sm:text-4xl lg:text-[46px] lg:leading-[55px]"
        >
          Đăng Ký Nhận<br />Tư Vấn Miễn Phí
        </h2>
      </div>
      <AboutRegisterForm client:load dataInput=dataInput={dataInput} defaultObjective={defaultObjective} />
    </div>

    {/* Paper Plane Boy */}
    <div class="absolute right-0 top-0 md:-translate-y-[26%] md:translate-x-[35%] xl:translate-x-[45%] z-20 pointer-events-none">
      <Image
        width={350}
        height={350}
        sizes="(max-width: 768px) 120px, 350px"
        class="h-auto w-[120px] sm:w-[250px] xl:w-[320px] drop-shadow-xl"
        src={imgDkTuVan}
        alt={'Register advise boy'}
        loading="lazy"
      />
    </div>

    {/* Books at Bottom Left */}
    <div class="absolute hidden md:block -bottom-[15px] -left-[74px] lg:-bottom-[20px] lg:-left-[114px] xl:-bottom-[25px] xl:-left-[140px] z-20 pointer-events-none">
      <Image
        width={160}
        height={160}
        sizes="(max-width: 768px) 100px, 160px"
        loading="lazy"
        class="h-auto w-[100px] sm:w-[140px] xl:w-[180px] drop-shadow-lg"
        src={imgBook}
        alt={'Books'}
      />
    </div>

    {/* Extra Book Decorative */}
    <div class="absolute hidden md:block bottom-[50px] -right-[44px] lg:bottom-[65px] lg:-right-[74px] xl:bottom-[75px] xl:-right-[80px] z-20 pointer-events-none">
      <Image
        width={120}
        height={150}
        sizes="(max-width: 768px) 60px, 120px"
        loading="lazy"
        class="h-auto w-[70px] sm:w-[100px] xl:w-[130px] drop-shadow-lg"
        src={IMAGES.bookbanner1}
        alt={'Book decorative'}
      />
    </div>
  </div>
</div>
